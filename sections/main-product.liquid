.bp-pt__foot { display: flex; align-items: flex-start; gap: 9px; margin-top: 14px; padding: 12px 13px; border-radius: 13px; background: rgba(255,92,51,.08); font-size: 12px; color: #3A352E; line-height: 1.45; }
