      <div class="bp-fit__sliders">
        <div><div class="bp-fit__lab"><span>Height</span><b><em data-bp-h>5'9"</em></b></div><input type="range" min="60" max="78" step="1" value="69" data-bp-height></div>
        <div><div class="bp-fit__lab"><span>Weight</span><b><em data-bp-w>70</em>kg</b></div><input type="range" min="45" max="130" step="1" value="70" data-bp-weight></div>
      </div>
      <div class="bp-fit__prefs" data-bp-prefs>
        <button type="button" class="is-on" data-pref="Slim">Slim</button>
        <button type="button" data-pref="Relaxed">Relaxed</button>
      </div>
      <div class="bp-fit__result">
        <div class="bp-fit__sz"><span>YOUR SIZE</span><b data-bp-fitsize>M</b></div>
        <div class="bp-fit__meta">
          <div class="bp-fit__conf"><div class="bp-fit__bar"><i data-bp-fitbar style="width:94%"></i></div><span data-bp-fitconf>94%</span></div>
          <div class="bp-fit__line" data-bp-fitline>Buyers within 3cm/4kg of you mostly bought M.</div>
          <button type="button" class="bp-fit__apply" data-bp-applyfit>Use size <em data-bp-fitsize2>M</em> →</button>
        </div>
      </div>
    </div>
    <div class="bp-fitpane" data-pane="chart" hidden>
      <div class="bp-fit__modes" data-bp-fitmodes>
        <button type="button" data-mode="Slim" data-adj="-1">Slim</button>
        <button type="button" class="is-on" data-mode="Regular" data-adj="0">Regular</button>
        <button type="button" data-mode="Relaxed" data-adj="1.5">Relaxed</button>
        <button type="button" data-mode="Oversized" data-adj="3">Oversized</button>
      </div>
      <div class="bp-chart__h"><span>Size</span><span>Chest</span><span>Length</span><span>Shoulder</span></div>
      <div data-bp-chartrows>
        {%- assign rows = section.settings.fit_size_rows | newline_to_br | split: '<br />' -%}
        {%- for row in rows -%}{%- assign r = row | strip | split: '|' -%}{%- if r.size >= 4 -%}<div class="bp-chart__r" data-size="{{ r[0] | strip | upcase }}" data-chest="{{ r[1] | strip }}"><span class="bp-chart__sz">{{ r[0] | strip }}</span><span class="bp-chart__chest">{{ r[1] | strip }}"</span><span>{{ r[2] | strip }}"</span><span>{{ r[3] | strip }}"</span></div>{%- endif -%}{%- endfor -%}
      </div>
      <div class="bp-chart__note" data-bp-modenote>Recommended everyday fit — clean lines, room to move. True to size.</div>
    </div>
    <div class="bp-fitpane" data-pane="guide" hidden>
      <div class="bp-guide__lead">This shirt pairs effortlessly with:</div>
      <div class="bp-guide__grid">
        {%- assign pairs = section.settings.fit_pairs | newline_to_br | split: '<br />' -%}
        {%- for row in pairs -%}{%- assign p = row | strip | split: '|' -%}{%- if p.size >= 3 -%}<div class="bp-guide__i"><span>{{ p[0] | strip }}</span><div><div class="bp-guide__n">{{ p[1] | strip }}</div><div class="bp-guide__m">{{ p[2] | strip }}</div></div></div>{%- endif -%}{%- endfor -%}
      </div>
    </div>
  </div>
</div>
<script>
(function(){
  var modal=document.querySelector('#shopify-section-{{ section.id }} [data-bp-fit]'); if(!modal||modal.dataset.bpFitBound)return; modal.dataset.bpFitBound='1';
  function $(s){return modal.querySelector(s);} function $$(s){return Array.prototype.slice.call(modal.querySelectorAll(s));}
  var SIZES=['S','M','L','XL','XXL'], state={height:69,weight:70,pref:'Slim'};
  function ft(inch){return Math.floor(inch/12)+"'"+(inch%12)+'\"';}
  function switchTab(tab){tab=tab||'recommend';$$('[data-bp-fittabs] .bp-tab').forEach(function(t){t.classList.toggle('is-on',t.dataset.tab===tab);});$$('.bp-fitpane').forEach(function(p){p.hidden=p.dataset.pane!==tab;});}
  function openM(tab){modal.hidden=false;document.body.style.overflow='hidden';switchTab(tab);renderFit();}
  function closeM(){modal.hidden=true;document.body.style.overflow='';}
  /* delegated: any trigger anywhere on the page opens this single modal (block-independent) */
  document.addEventListener('click',function(e){
    var op=e.target.closest('[data-bp-open-fit],[data-bp-openfit]');
    if(op){e.preventDefault();openM(op.getAttribute('data-bp-open-fit')||op.getAttribute('data-bp-openfit'));return;}
    if(e.target.closest('[data-bp-close-fit]')){closeM();}
  });
  document.addEventListener('bp:openfit',function(e){openM(e.detail&&e.detail.tab);});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!modal.hidden)closeM();});
  $$('[data-bp-fittabs] .bp-tab').forEach(function(t){t.addEventListener('click',function(){switchTab(t.dataset.tab);});});
  function clampIdx(i){return Math.max(0,Math.min(SIZES.length-1,i));}
  function bandIdx(x){if(x<150)return 0;if(x<172)return 1;if(x<187)return 2;if(x<197)return 3;return 4;}function compute(){var score=state.weight + 1.4*state.height;var off=state.pref==='Relaxed'?3:-3;var i=clampIdx(bandIdx(score+off));var bnds=[150,172,187,197];var d=99;for(var k=0;k<bnds.length;k++){var dd=Math.abs(score-bnds[k]);if(dd<d)d=dd;}var conf=Math.round(Math.min(97,Math.max(78,82+d*1.4)));return {size:SIZES[i],conf:conf};}
  function renderFit(){var r=compute();var hE=$('[data-bp-h]');if(hE)hE.textContent=ft(state.height);var wE=$('[data-bp-w]');if(wE)wE.textContent=state.weight;$$('[data-bp-fitsize]').forEach(function(e){e.textContent=r.size;});var s2=$('[data-bp-fitsize2]');if(s2)s2.textContent=r.size;var cf=$('[data-bp-fitconf]');if(cf)cf.textContent=r.conf+'%';var bar=$('[data-bp-fitbar]');if(bar)bar.style.width=r.conf+'%';var ln=$('[data-bp-fitline]');if(ln)ln.textContent='Most people your height & weight buy '+r.size+'.';var b=$('[data-bp-fitsize]');if(b){b.style.animation='none';void b.offsetWidth;b.style.animation='';}highlight(r.size);}
  var hEl=$('[data-bp-height]'),wEl=$('[data-bp-weight]');
  if(hEl)hEl.addEventListener('input',function(e){state.height=+e.target.value;renderFit();});
  if(wEl)wEl.addEventListener('input',function(e){state.weight=+e.target.value;renderFit();});
  $$('[data-bp-prefs] button').forEach(function(btn){btn.addEventListener('click',function(){$$('[data-bp-prefs] button').forEach(function(x){x.classList.remove('is-on');});btn.classList.add('is-on');state.pref=btn.dataset.pref;renderFit();});});
  var applyBtn=$('[data-bp-applyfit]'); if(applyBtn)applyBtn.addEventListener('click',function(){selectSize(compute().size);closeM();});
  var rows=$$('[data-bp-chartrows] .bp-chart__r'),note=$('[data-bp-modenote]');
  var NOTES={Slim:'Tailored through chest & waist for a sharp silhouette.',Regular:'Recommended everyday fit — clean lines, room to move. True to size.',Relaxed:'Extra room for comfort & layering. Size down if between sizes.',Oversized:'Deliberately roomy streetwear cut. Size down one.'};
  function applyMode(btn){var adj=parseFloat(btn.dataset.adj)||0;$$('[data-bp-fitmodes] button').forEach(function(x){x.classList.toggle('is-on',x===btn);});rows.forEach(function(r){var base=parseFloat(r.dataset.chest)||0;var ce=r.querySelector('.bp-chart__chest');if(ce)ce.textContent=(base+adj).toFixed(1)+'"';});if(note)note.textContent=NOTES[btn.dataset.mode]||'';}
  $$('[data-bp-fitmodes] button').forEach(function(btn){btn.addEventListener('click',function(){applyMode(btn);});});
  function highlight(size){rows.forEach(function(r){r.classList.toggle('is-rec',r.dataset.size===(size||'').toUpperCase());});}
  function selectSize(size){var t=(size||'').toUpperCase(),done=false;
    document.querySelectorAll('input[type=radio]').forEach(function(inp){if(done)return;if((inp.value||'').trim().toUpperCase()===t){inp.checked=true;inp.dispatchEvent(new Event('change',{bubbles:true}));done=true;}});
    if(!done)document.querySelectorAll('label,button,.bp-sz').forEach(function(el){if(done)return;if((el.textContent||'').trim().toUpperCase()===t){el.click();done=true;}});
  }
  renderFit();
})();
</script>
{%- endif -%}

<script>
  // We save the product ID in local storage to be eventually used for recently viewed section
  try {
    let recentlyViewedProducts = JSON.parse(localStorage.getItem('theme:recently-viewed-products') || '[]');

    recentlyViewedProducts = recentlyViewedProducts.filter(item => item !== {{ product.id }}); // Delete product to remove to the start
    recentlyViewedProducts.unshift({{ product.id }}); // Add at the start

    localStorage.setItem('theme:recently-viewed-products', JSON.stringify(recentlyViewedProducts));
  } catch (e) {
    // Safari in private mode does not allow setting item, we silently fail
  }
</script>

{%- comment -%} Bluprint blocks — interactivity (independent, DOM-ready) {%- endcomment -%}
<script>
(function () {
  function boot() {
    /* Offers carousel dots */
    document.querySelectorAll('[data-bp-offers]').forEach(function (rail) {
      if (rail.dataset.bpBound) return; rail.dataset.bpBound = '1';
      var off = rail.closest('.bp-off'); if (!off) return;
      var dotWrap = off.querySelector('[data-bp-offdots]'); if (!dotWrap) return;
      var cards = [].slice.call(rail.querySelectorAll('.bp-offcard'));
      cards.forEach(function (_, i) {
        var b = document.createElement('button'); if (i === 0) b.className = 'is-on';
        b.addEventListener('click', function () { cards[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' }); });
        dotWrap.appendChild(b);
      });
      var dots = [].slice.call(dotWrap.querySelectorAll('button'));
      rail.addEventListener('scroll', function () {
        var idx = Math.round(rail.scrollLeft / (rail.scrollWidth / Math.max(cards.length,1)));
        dots.forEach(function (d, i) { d.classList.toggle('is-on', i === idx); });
      }, { passive: true });
    });

    /* Fabric DNA tabs */
    document.querySelectorAll('[data-bp-fabtabs]').forEach(function (tabs) {
      if (tabs.dataset.bpBound) return; tabs.dataset.bpBound = '1';
      var fab = tabs.closest('.bp-fab'); if (!fab) return;
      tabs.querySelectorAll('.bp-tab').forEach(function (t) {
        t.addEventListener('click', function () {
          tabs.querySelectorAll('.bp-tab').forEach(function (x) { x.classList.toggle('is-on', x === t); });
          fab.querySelectorAll('.bp-fabpane').forEach(function (p) { p.hidden = p.dataset.pane !== t.dataset.tab; });
        });
      });
    });

    /* Accordions (details + faq) */
    document.querySelectorAll('[data-bp-acc]').forEach(function (acc) {
      if (acc.dataset.bpBound) return; acc.dataset.bpBound = '1';
      var isFaq = acc.classList.contains('bp-faq');
      acc.querySelectorAll(isFaq ? '.bp-faq__i' : '.bp-acc__i').forEach(function (item) {
        var btn = item.querySelector(isFaq ? '.bp-faq__b' : '.bp-acc__b');
        var panel = item.querySelector(isFaq ? '.bp-faq__p' : '.bp-acc__p');
        var mark = btn.querySelector(isFaq ? 'em' : '.bp-acc__x');
        btn.addEventListener('click', function () {
          var open = isFaq ? !panel.hidden : item.classList.contains('is-open');
          if (isFaq) { panel.hidden = open; if (mark) mark.textContent = open ? '+' : '−'; }
          else { item.classList.toggle('is-open', !open); panel.hidden = open; if (mark) mark.textContent = open ? '▼' : '▲'; }
        });
      });
    });

    /* Reviews (tabs + filters + seeded data) */
    document.querySelectorAll('[data-bp-rev]').forEach(function (wrap) {
      if (wrap.dataset.bpBound) return; wrap.dataset.bpBound = '1';
      var REVIEWS = (function(){
        var el = wrap.querySelector('[data-bp-reviews]'); if (el) { try { var j = JSON.parse(el.textContent); if (j && j.length) return j; } catch(e){} }
        var seed = parseInt(wrap.dataset.bpSeed || '0', 10) || 7;
        function mulberry32(a){ return function(){ a|=0; a=a+0x6D2B79F5|0; var t=Math.imul(a^a>>>15,1|a); t=t+Math.imul(t^t>>>7,61|t)^t; return ((t^t>>>14)>>>0)/4294967296; }; }
        var rnd = mulberry32(seed);
        function pick(a){ return a[Math.floor(rnd()*a.length)]; }
        var FIRST=['Arjun','Rohit','Sahil','Nikhil','Karan','Aditya','Rahul','Vikram','Ankit','Siddharth','Aman','Harsh','Kunal','Manish','Rajat','Varun','Dev','Yash','Ishaan','Kabir','Naveen','Pranav','Tarun','Gaurav','Abhishek','Nitin','Sameer','Rohan','Akash','Vivek','Shaurya','Aryan','Raghav','Mohit','Parth','Dhruv','Anirudh','Saurabh','Jatin','Rishabh','Ayush','Kartik','Sanjay','Utkarsh','Nakul'];
        var LAST=['M.','K.','V.','P.','D.','S.','R.','B.','G.','C.','N.','T.','J.','A.','H.','L.'];
        var BUILD=['Athletic','Slim','Broad','Regular','Lean','Stocky'];
        var OCC=['Office','Wedding','College','Daily wear','Travel','Party','Date night','Casual Friday','Festive','Brunch','Work from office','Gifting','Dinner'];
        var FIT=['True to size','Runs slim','Roomy','Perfect fit','Slightly relaxed'];
        var OPEN=['Genuinely looks premium.','Easily my best shirt this year.','Better than brands twice the price.','Insane value for the money.','Exactly what the photos show.','Quality caught me off guard.','Feels like a luxury pickup.','My go-to shirt now.','Did not expect this at this price.','Looks way more expensive than it is.'];
        var FABRIC=['Fabric is soft but structured.','The weave breathes really well.','Cotton feels rich, not stiff.','Zero transparency, holds shape.','Premium hand-feel, no itch.','Thick enough to feel luxe, light enough for all-day.','Drapes beautifully without clinging.'];
        var FITX=['Fit is spot on for my build.','Shoulders sit perfectly.','Tapers clean without being tight.','Length is just right, tucked or open.','Sleeves end exactly at the wrist.','No ballooning at the waist.','Sits clean across the chest.'];
        var CARE=['Colour held after many washes.','No shrinkage after wash.','Stitching is tight everywhere.','Buttons feel solid.','Collar keeps its shape all day.','Zero wrinkles after a full day out.','Still looks new after weeks.'];
        var CLOSE=['Already ordered another colour.','Highly recommend.','Would buy again in a heartbeat.','Worth every rupee.','Would suggest to friends.','Got compliments all evening.',''];
        function sentence(){ var p=[pick(OPEN)]; if(rnd()<.9)p.push(pick(FABRIC)); if(rnd()<.85)p.push(pick(FITX)); if(rnd()<.7)p.push(pick(CARE)); if(rnd()<.6)p.push(pick(CLOSE)); return p.join(' ').trim(); }
        var SIZES=['S','M','L','XL','XXL'];
        var out=[], count=12+Math.floor(rnd()*4);
        for(var k=0;k<count;k++){
          var h=165+Math.floor(rnd()*28), w=58+Math.floor(rnd()*44), si;
          if(w<62)si=0; else if(w<74)si=1; else if(w<86)si=2; else if(w<98)si=3; else si=4;
          var nm=pick(FIRST)+' '+pick(LAST), parts=nm.split(' ');
          out.push({ name:nm, initials:(parts[0][0]+parts[1][0]).toUpperCase(), h:h, w:w, size:SIZES[si], build:pick(BUILD), rating: (function(){var _r=rnd();return _r<.55?5:(_r<.9?4:3);})(), occasion:pick(OCC), text:sentence(), fit:pick(FIT), helpful: 6+Math.floor(rnd()*55) });
        }
        return out;
      })();
      var AV = ['var(--nav)','var(--green)','var(--coral)'], filter = 'all', mySize = 'M', H = 178, W = 74;
      function esc(s){ var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
      function stars(n){ return '★★★★★'.slice(0,n) + '☆☆☆☆☆'.slice(0,5-n); }
      function ini(r){ return (r.initials || (r.name||'?').split(' ').map(function(x){ return x[0]||''; }).join('')).slice(0,2).toUpperCase(); }
      function card(r,i){
        var ph = '';
        return '<div class="bp-rcard"><div class="bp-rcard__top"><span class="bp-rcard__av" style="background:'+AV[i%3]+'">'+esc(ini(r))+'</span><div class="bp-rcard__id"><div class="bp-rcard__nm">'+esc(r.name)+' <em>✓ Verified</em></div><div class="bp-rcard__meta">'+r.h+'cm · '+r.w+'kg · '+esc(r.size)+' · '+esc(r.occasion)+'</div></div><span class="bp-rcard__st">'+stars(r.rating)+'</span></div><p class="bp-rcard__tx">'+esc(r.text)+'</p>'+ph+'<div class="bp-rcard__ft"><span class="bp-rcard__fit">✓ '+esc(r.fit)+'</span><button type="button" class="bp-rcard__help">↑ '+r.helpful+'</button></div></div>';
      }
      function renderList(){
        var listEl = wrap.querySelector('[data-bp-rcards]'), empty = wrap.querySelector('[data-bp-rempty]');
        if (!listEl) return;
        var rows = REVIEWS.filter(function(r){
          if (filter==='photos') return r.photos;
          if (filter==='5') return r.rating===5;
          if (filter==='mysize') return (r.size||'').toUpperCase()===mySize.toUpperCase();
          return true;
        });
        listEl.innerHTML = rows.map(card).join('');
        if (empty) empty.hidden = rows.length>0;
      }
      function renderMatch(){
        var el = wrap.querySelector('[data-bp-matchcards]'); if (!el) return;
        var hw = wrap.querySelector('[data-bp-matchhw]'); if (hw) hw.textContent = H+'cm · '+W+'kg';
        var scored = REVIEWS.map(function(r){ return { r:r, d:Math.abs(r.h-H)/4+Math.abs(r.w-W)/5 }; }).sort(function(a,b){return a.d-b.d;}).slice(0,2);
        el.innerHTML = scored.map(function(s,i){
          var r=s.r, pct=Math.max(82,Math.round(100-s.d*9));
          return '<div class="bp-rcard"><div class="bp-rcard__top"><span class="bp-rcard__av" style="background:var(--green)">'+esc(ini(r))+'</span><div class="bp-rcard__id"><div class="bp-rcard__nm">'+esc(r.name)+'</div><div class="bp-rcard__meta">'+r.h+'cm · '+r.w+'kg · '+esc(r.build)+'</div></div><span class="bp-rcard__pct">'+pct+'% match</span></div><p class="bp-rcard__tx">"'+esc(r.text)+'"</p><div class="bp-rcard__fit">Bought '+esc(r.size)+' · '+esc(r.fit)+'</div></div>';
        }).join('');
      }
      wrap.querySelectorAll('[data-bp-revtabs] .bp-tab').forEach(function(t){
        t.addEventListener('click', function(){
          wrap.querySelectorAll('[data-bp-revtabs] .bp-tab').forEach(function(x){ x.classList.toggle('is-on', x===t); });
          wrap.querySelectorAll('.bp-revpane').forEach(function(p){ p.hidden = p.dataset.pane !== t.dataset.tab; });
          if (t.dataset.tab==='photos') renderList();
          if (t.dataset.tab==='match') renderMatch();
        });
      });
      wrap.querySelectorAll('[data-bp-revfilters] button').forEach(function(b){
        b.addEventListener('click', function(){
          wrap.querySelectorAll('[data-bp-revfilters] button').forEach(function(x){ x.classList.toggle('is-on', x===b); });
          filter = b.dataset.f; renderList();
        });
      });
      renderList(); renderMatch();
    });

    /* Buy box: success flash on Add-to-cart (observer only — never touches cart logic) */
    document.querySelectorAll('.bp-buybox').forEach(function (box) {
      if (box.dataset.bpAtcObs) return; box.dataset.bpAtcObs = '1';
      new MutationObserver(function (muts) {
        muts.forEach(function (m) {
          var t = m.target;
          if (!(t && t.matches && t.matches('button[name="add"], .product-form__submit'))) return;
          var busy = t.getAttribute('aria-busy') === 'true' || t.classList.contains('loading') || t.classList.contains('is-loading');
          if (busy) { t.dataset.bpWasBusy = '1'; }
          else if (t.dataset.bpWasBusy) {
            t.dataset.bpWasBusy = '';
            t.classList.add('bp-atc--done');
            setTimeout(function () { t.classList.remove('bp-atc--done'); }, 1400);
          }
        });
      }).observe(box, { subtree: true, attributes: true, attributeFilter: ['aria-busy', 'class'] });
    });
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', boot); } else { boot(); }
})();
</script>

