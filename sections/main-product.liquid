.bp-sbar__meta { font-size: 10px; color: var(--gold); font-weight: 600; } .bp-sbar__meta em { font-style: normal; }
.bp-sbar__cta { flex: 1; padding: 14px; border-radius: 15px; border: none; background: linear-gradient(160deg,#FFD97C,#FFAD3B); color: var(--ink2); font-family: var(--disp); font-weight: 700; font-size: 14px; cursor: pointer; transition: transform .12s; box-shadow: 0 1px 0 rgba(255,255,255,.5) inset, 0 8px 18px -8px rgba(255,173,59,.55); }
.bp-sbar__cta:active { transform: scale(.97); }

/* fit modal */
.bp-modal { position: fixed; inset: 0; z-index: 90; display: flex; align-items: flex-end; justify-content: center; }
.bp-modal__scrim { position: absolute; inset: 0; background: rgba(20,18,15,.5); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
.bp-modal__sheet { position: relative; width: 100%; max-width: 430px; max-height: 88vh; overflow-y: auto; background: #fff; border-radius: 26px 26px 0 0; box-shadow: 0 -20px 50px rgba(0,0,0,.3); animation: bp-sheet .32s cubic-bezier(.2,.85,.25,1) both; }
.bp-modal__head { position: sticky; top: 0; background: #fff; padding: 12px 15px 0; z-index: 2; }
