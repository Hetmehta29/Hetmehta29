    --nav: {{ section.settings.bp_color_dark | default: '#38415F' }};
    --ink: {{ section.settings.bp_color_ink | default: '#1F1D1A' }};
    --ink2: {{ section.settings.bp_color_ink | default: '#23272F' }};
    --muted: {{ section.settings.bp_color_muted | default: '#6B655C' }};
    --faint: {{ section.settings.bp_color_muted | default: '#9A9286' }};
    --line: rgba(56,65,95,.08);
    --card: {{ section.settings.bp_color_card | default: '#F7F5F1' }};
    --gold: {{ section.settings.bp_color_gold | default: '#FFCE54' }};
    --gold2: {{ section.settings.bp_color_gold_deep | default: '#F0A11B' }};
    --goldd: #C4881B;
    --green: {{ section.settings.bp_color_green | default: '#17C27F' }};
    --green2: {{ section.settings.bp_color_green_deep | default: '#0FA05F' }};
    --coral: {{ section.settings.bp_color_coral | default: '#FF5C33' }};
    --coral2: {{ section.settings.bp_color_coral_deep | default: '#F04A1D' }};
    --violet: {{ section.settings.bp_color_violet | default: '#7C4DFF' }};
    --sky: #4A7FE0; --rose: #DB4A8F;
    --disp: {{ section.settings.bp_heading_font.family }}, {{ section.settings.bp_heading_font.fallback_families }};
    --body: {{ section.settings.bp_body_font.family }}, {{ section.settings.bp_body_font.fallback_families }};
    font-family: var(--body); color: var(--ink);
  }
  #shopify-section-{{ section.id }} [data-bp-fit] *{ box-sizing: border-box; }
  #shopify-section-{{ section.id }} [data-bp-fit] .bp-scroll{ scrollbar-width: none; }
  #shopify-section-{{ section.id }} [data-bp-fit] .bp-scroll::-webkit-scrollbar{ display: none; }
