.bp-sbar__meter { height: 4px; border-radius: 999px; background: rgba(255,255,255,.16); overflow: hidden; margin-bottom: 9px; } .bp-sbar__meter i { display: block; height: 100%; background: linear-gradient(90deg,var(--gold2),var(--gold)); border-radius: 999px; transition: width .6s; }
