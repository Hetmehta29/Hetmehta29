.bp-chart__h { display: flex; padding: 0 3px 6px; font-size: 10px; color: var(--faint); font-weight: 600; } .bp-chart__h span:first-child { flex: .7; } .bp-chart__h span { flex: 1; text-align: center; } .bp-chart__h span:first-child { text-align: left; }
.bp-chart__r { display: flex; align-items: center; padding: 9px 3px; border-radius: 10px; margin-bottom: 4px; border: 1px solid transparent; }
.bp-chart__r span { flex: 1; text-align: center; font-size: 12px; } .bp-chart__sz { flex: .7 !important; text-align: left !important; font-family: var(--disp); font-weight: 700; font-size: 13px; }
.bp-chart__r.is-rec { background: rgba(56,65,95,.07); border-color: rgba(56,65,95,.18); } .bp-chart__r.is-rec .bp-chart__sz { color: var(--nav); }
.bp-chart__note { margin-top: 9px; padding: 10px 12px; border-radius: 11px; background: rgba(23,194,127,.08); font-size: 11px; color: var(--green); line-height: 1.45; }
.bp-guide__lead { font-size: 12px; color: var(--muted); margin-bottom: 11px; }
.bp-guide__grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 7px; }
.bp-guide__i { display: flex; align-items: center; gap: 8px; padding: 9px 11px; border-radius: 12px; background: #fff; border: 1px solid rgba(56,65,95,.08); } .bp-guide__i span { font-size: 15px; } .bp-guide__n { font-weight: 600; font-size: 12px; } .bp-guide__m { font-size: 9px; color: var(--green); font-weight: 600; }

/* confetti */
.bp-confetti { position: fixed; inset: 0; z-index: 80; pointer-events: none; overflow: hidden; }
.bp-confetti i { position: absolute; top: -30px; width: 9px; height: 13px; border-radius: 2px; animation: bp-fall linear forwards; }

@keyframes bp-fall { to { transform: translateY(105vh) rotate(560deg); opacity: 0; } }
@keyframes bp-pulse { 0%,100% { opacity: .4; } 50% { opacity: 1; } }
@keyframes bp-pop { 0% { transform: scale(.7); opacity: 0; } 60% { transform: scale(1.1); } 100% { transform: scale(1); opacity: 1; } }
@keyframes bp-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
@keyframes bp-float { 0%,100% { transform: translateY(0) rotate(var(--r)); } 50% { transform: translateY(-6px) rotate(var(--r)); } }
@keyframes bp-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes bp-breathe { 0%,100% { transform: scale(1); } 50% { transform: scale(1.012); } }
@keyframes bp-sheet { from { transform: translateY(100%); } to { transform: translateY(0); } }
.bp-blk input[type=range] { -webkit-appearance: none; appearance: none; width: 100%; height: 5px; border-radius: 999px; background: #DDD6C8; outline: none; }
.bp-blk input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 22px; height: 22px; border-radius: 50%; background: var(--nav); border: 3px solid var(--card); box-shadow: 0 3px 9px rgba(56,65,95,.32); cursor: pointer; }
@media (prefers-reduced-motion: reduce) { .bp-blk *, .bp-blk *::before, .bp-blk *::after { animation-duration: .001ms !important; transition-duration: .001ms !important; } }
@media (min-width: 750px) { .bp__wrap { max-width: 480px; } }

