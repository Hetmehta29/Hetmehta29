{%- comment -%} Bluprint · variant availability map + purchase guard — hard-blocks Add/Buy for sold-out sizes and keeps the REAL variant id in sync. No cart logic is replaced; it only sets the native variant field & disables the native buttons. {%- endcomment -%}
{%- assign _sizeidx = 0 -%}{%- for opt in product.options_with_values -%}{%- assign _dn = opt.name | downcase -%}{%- if _dn contains 'size' -%}{%- assign _sizeidx = forloop.index -%}{%- endif -%}{%- endfor -%}{%- if _sizeidx == 0 -%}{%- assign _sizeidx = 1 -%}{%- endif -%}
<script type="application/json" data-bp-variants>{"sizeIndex": {{ _sizeidx }}, "variants": [{%- for v in product.variants -%}{"id": {{ v.id }}, "available": {{ v.available }}, "options": {{ v.options | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}</script>
<script>
(function () {
  var section = document.getElementById('shopify-section-{{ section.id }}');
  if (!section) return;
  var el = section.querySelector('[data-bp-variants]'); if (!el) return;
  var data; try { data = JSON.parse(el.textContent); } catch (e) { return; }
  var sIdx = (data.sizeIndex || 1) - 1;
  var variants = data.variants || [];
  var gateT;

  function idField() {
    return section.querySelector('form[action*="/cart/add"] [name="id"]') || section.querySelector('[name="id"]');
  }
  function variantForSize(size) {
    var avail = null, any = null;
    variants.forEach(function (v) {
      if (String(v.options[sIdx]) === String(size)) { any = any || v; if (v.available && !avail) avail = v; }
    });
    return avail || any;
  }
  function currentVariant() {
    var f = idField(); if (!f) return null;
    for (var i = 0; i < variants.length; i++) if (String(variants[i].id) === String(f.value)) return variants[i];
    return null;
  }
  function setVariant(v) {
    if (!v) return; var f = idField();
    if (f && String(f.value) !== String(v.id)) { f.value = v.id; f.dispatchEvent(new Event('change', { bubbles: true })); }
  }
  function markSizes() {
    section.querySelectorAll('[data-bp-sizes] .bp-sz').forEach(function (b) {
      var v = variantForSize(b.dataset.size); var oos = !(v && v.available);
      b.classList.toggle('bp-oos', oos); b.setAttribute('aria-disabled', oos ? 'true' : 'false');
    });
  }
  function gate() {
    var v = currentVariant();
    var soldout = v ? !v.available : false;
    section.querySelectorAll('.bp-buybox button[name="add"], .bp-buybox .product-form__submit').forEach(function (b) {
      b.classList.toggle('bp-soldout', soldout);
      if (soldout) { b.setAttribute('disabled', 'disabled'); b.setAttribute('aria-disabled', 'true'); }
      else { b.removeAttribute('disabled'); b.removeAttribute('aria-disabled'); }
    });
    section.querySelectorAll('.bp-buybox .shopify-payment-button, .bp-buybox shopify-payment-button').forEach(function (p) {
      p.classList.toggle('bp-oos', soldout);
    });
  }
  function join() {
    section.querySelectorAll('.bp-join--top, .bp-join--bot').forEach(function (x) { x.classList.remove('bp-join--top', 'bp-join--bot'); });
    var box = section.querySelector('.bp-buybox'); if (!box) return;
    var item = box.closest('.product-info__block-item'); if (!item) return;
    var next = item.nextElementSibling;
    if (next && !next.querySelector('.bp-rew')) { var n2 = next.nextElementSibling; if (n2 && n2.querySelector('.bp-rew') && !next.querySelector('*')) next = n2; }
    if (next && next.querySelector('.bp-rew')) { item.classList.add('bp-join--top'); next.classList.add('bp-join--bot'); }
  }
  function all() { markSizes(); gate(); join(); }

  document.addEventListener('bp:size', function (e) { var sz = e.detail && e.detail.size; setVariant(variantForSize(sz)); gate(); });
  section.addEventListener('change', function () { clearTimeout(gateT); gateT = setTimeout(gate, 30); });
  var host = section.querySelector('.product-info__block-list') || section;
  new MutationObserver(function () { clearTimeout(gateT); gateT = setTimeout(all, 60); }).observe(host, { childList: true, subtree: true });
  all();
})();
</script>

{%- comment -%} Bluprint · Fit Studio modal — section level (works for Size-picker & Fit-studio blocks; never scaled by block zoom) {%- endcomment -%}
{%- if section.settings.fit_enable != false -%}
{%- style -%}
  #shopify-section-{{ section.id }} [data-bp-fit][hidden]{display:none !important;}
  /* Restore the Bluprint colour tokens on the section-level modal (it lives outside .bp-blk, so it no longer inherits them). */
  #shopify-section-{{ section.id }} [data-bp-fit]{
    --pg: {{ section.settings.bp_color_page | default: _pg }};
    --card: {{ section.settings.bp_color_card | default: _card }};
    --tint: {{ section.settings.bp_color_tint | default: _tint }};
    --ink: {{ section.settings.bp_color_ink | default: _ink }};
    --ink2: {{ section.settings.bp_color_ink2 | default: _ink2 }};
    --mut: {{ section.settings.bp_color_muted | default: _mut }};
    --line: {{ section.settings.bp_color_line | default: _line }};
    --line2: {{ _line2 }};
    --acc: {{ section.settings.bp_color_accent | default: _acc }};
    --accInk: {{ _accInk }};
    --acc2: {{ section.settings.bp_color_accent2 | default: _acc2 }};
    --acc3: {{ section.settings.bp_color_accent3 | default: _acc3 }};
    --accOn: {{ _accOn }};
    --star: {{ _star }};
    --starBar: {{ _starBar }};
    --ph1: {{ _ph1 }};
    --ph2: {{ _ph2 }};
    --onDark: {{ _onDark }};
    --disp: {{ section.settings.bp_heading_font.family }}, {{ section.settings.bp_heading_font.fallback_families }};
    {%- comment -%} Hanken Grotesk is not in Shopify's font library, so it comes from the
        Google Fonts link at the top of this section rather than a font picker. {%- endcomment -%}
    --body: {% if section.settings.bp_use_hanken != false %}'Hanken Grotesk', {% endif %}{{ section.settings.bp_body_font.family }}, {{ section.settings.bp_body_font.fallback_families }};
    --mono: 'Fragment Mono', ui-monospace, monospace;
    --dw: {{ _dw }};
    --dls: {{ _dls }};
    --gut: {{ section.settings.bp_gutter | default: 10 }}px;
    font-family: var(--body); color: var(--ink);
  }
  #shopify-section-{{ section.id }} [data-bp-fit] *{ box-sizing: border-box; }
  #shopify-section-{{ section.id }} [data-bp-fit] .bp-scroll{ scrollbar-width: none; }
  #shopify-section-{{ section.id }} [data-bp-fit] .bp-scroll::-webkit-scrollbar{ display: none; }
{%- endstyle -%}
<div class="bp-modal" data-bp-fit hidden>
  <div class="bp-modal__scrim" data-bp-close-fit></div>
  <div class="bp-modal__sheet bp-scroll">
    <div class="bp-modal__head">
      <div class="bp-modal__grab"></div>
      <div class="bp-modal__title"><span class="bp-ai">AI</span><h2>{{ section.settings.fit_title | default: 'Fit Studio' }}</h2><button type="button" class="bp-modal__x" data-bp-close-fit aria-label="Close">✕</button></div>
      <div class="bp-tabs" data-bp-fittabs>
        <button type="button" class="bp-tab is-on" data-tab="recommend">Recommend</button>
        <button type="button" class="bp-tab" data-tab="chart">Size chart</button>
        <button type="button" class="bp-tab" data-tab="guide">Pairs with</button>
      </div>
    </div>
    <div class="bp-fitpane" data-pane="recommend">
      <div class="bp-fit__sliders">
        <div><div class="bp-fit__lab"><span>Height</span><b><em data-bp-h>5'9"</em></b></div><input type="range" min="60" max="78" step="1" value="69" data-bp-height></div>
        <div><div class="bp-fit__lab"><span>Weight</span><b><em data-bp-w>70</em>kg</b></div><input type="range" min="45" max="130" step="1" value="70" data-bp-weight></div>
      </div>
      <div class="bp-fit__prefs" data-bp-prefs>
        <button type="button" class="is-on" data-pref="Slim">Slim</button>
        <button type="button" data-pref="Relaxed">Relaxed</button>
      </div>
      <div class="bp-fit__result">
        <div class="bp-fit__sz"><span>YOUR SIZE</span><b data-bp-fitsize>M</b></div>
        <div class="bp-fit__meta">
          <div class="bp-fit__conf"><div class="bp-fit__bar"><i data-bp-fitbar style="width:94%"></i></div><span data-bp-fitconf>94%</span></div>
          <div class="bp-fit__line" data-bp-fitline>Buyers within 3cm/4kg of you mostly bought M.</div>
          <button type="button" class="bp-fit__apply" data-bp-applyfit>Use size <em data-bp-fitsize2>M</em> →</button>
        </div>
      </div>
    </div>
    <div class="bp-fitpane" data-pane="chart" hidden>
      <div class="bp-fit__modes" data-bp-fitmodes>
        <button type="button" data-mode="Slim" data-adj="-1">Slim</button>
        <button type="button" class="is-on" data-mode="Regular" data-adj="0">Regular</button>
        <button type="button" data-mode="Relaxed" data-adj="1.5">Relaxed</button>
        <button type="button" data-mode="Oversized" data-adj="3">Oversized</button>
      </div>
      <div class="bp-chart__h"><span>Size</span><span>Chest</span><span>Length</span><span>Shoulder</span></div>
      <div data-bp-chartrows>
        {%- assign rows = section.settings.fit_size_rows | newline_to_br | split: '<br />' -%}
        {%- for row in rows -%}{%- assign r = row | strip | split: '|' -%}{%- if r.size >= 4 -%}<div class="bp-chart__r" data-size="{{ r[0] | strip | upcase }}" data-chest="{{ r[1] | strip }}"><span class="bp-chart__sz">{{ r[0] | strip }}</span><span class="bp-chart__chest">{{ r[1] | strip }}"</span><span>{{ r[2] | strip }}"</span><span>{{ r[3] | strip }}"</span></div>{%- endif -%}{%- endfor -%}
      </div>
      <div class="bp-chart__note" data-bp-modenote>Recommended everyday fit — clean lines, room to move. True to size.</div>
    </div>
    <div class="bp-fitpane" data-pane="guide" hidden>
      <div class="bp-guide__lead">This shirt pairs effortlessly with:</div>
      <div class="bp-guide__grid">
        {%- assign pairs = section.settings.fit_pairs | newline_to_br | split: '<br />' -%}
        {%- for row in pairs -%}{%- assign p = row | strip | split: '|' -%}{%- if p.size >= 3 -%}<div class="bp-guide__i"><span>{{ p[0] | strip }}</span><div><div class="bp-guide__n">{{ p[1] | strip }}</div><div class="bp-guide__m">{{ p[2] | strip }}</div></div></div>{%- endif -%}{%- endfor -%}
      </div>
    </div>
  </div>
</div>
<script>
(function(){
  var modal=document.querySelector('#shopify-section-{{ section.id }} [data-bp-fit]'); if(!modal||modal.dataset.bpFitBound)return; modal.dataset.bpFitBound='1';
  function $(s){return modal.querySelector(s);} function $$(s){return Array.prototype.slice.call(modal.querySelectorAll(s));}
  var SIZES=['S','M','L','XL','XXL'], state={height:69,weight:70,pref:'Slim'};
  function ft(inch){return Math.floor(inch/12)+"'"+(inch%12)+'\"';}
  function switchTab(tab){tab=tab||'recommend';$$('[data-bp-fittabs] .bp-tab').forEach(function(t){t.classList.toggle('is-on',t.dataset.tab===tab);});$$('.bp-fitpane').forEach(function(p){p.hidden=p.dataset.pane!==tab;});}
  function openM(tab){modal.hidden=false;document.body.style.overflow='hidden';switchTab(tab);renderFit();}
  function closeM(){modal.hidden=true;document.body.style.overflow='';}
  /* delegated: any trigger anywhere on the page opens this single modal (block-independent) */
  document.addEventListener('click',function(e){
    var op=e.target.closest('[data-bp-open-fit],[data-bp-openfit]');
    if(op){e.preventDefault();openM(op.getAttribute('data-bp-open-fit')||op.getAttribute('data-bp-openfit'));return;}
    if(e.target.closest('[data-bp-close-fit]')){closeM();}
  });
  document.addEventListener('bp:openfit',function(e){openM(e.detail&&e.detail.tab);});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!modal.hidden)closeM();});
  $$('[data-bp-fittabs] .bp-tab').forEach(function(t){t.addEventListener('click',function(){switchTab(t.dataset.tab);});});
  function clampIdx(i){return Math.max(0,Math.min(SIZES.length-1,i));}
  function bandIdx(x){if(x<150)return 0;if(x<172)return 1;if(x<187)return 2;if(x<197)return 3;return 4;}function compute(){var score=state.weight + 1.4*state.height;var off=state.pref==='Relaxed'?3:-3;var i=clampIdx(bandIdx(score+off));var bnds=[150,172,187,197];var d=99;for(var k=0;k<bnds.length;k++){var dd=Math.abs(score-bnds[k]);if(dd<d)d=dd;}var conf=Math.round(Math.min(97,Math.max(78,82+d*1.4)));return {size:SIZES[i],conf:conf};}
  function renderFit(){var r=compute();var hE=$('[data-bp-h]');if(hE)hE.textContent=ft(state.height);var wE=$('[data-bp-w]');if(wE)wE.textContent=state.weight;$$('[data-bp-fitsize]').forEach(function(e){e.textContent=r.size;});var s2=$('[data-bp-fitsize2]');if(s2)s2.textContent=r.size;var cf=$('[data-bp-fitconf]');if(cf)cf.textContent=r.conf+'%';var bar=$('[data-bp-fitbar]');if(bar)bar.style.width=r.conf+'%';var ln=$('[data-bp-fitline]');if(ln)ln.textContent='Most people your height & weight buy '+r.size+'.';var b=$('[data-bp-fitsize]');if(b){b.style.animation='none';void b.offsetWidth;b.style.animation='';}highlight(r.size);}
  var hEl=$('[data-bp-height]'),wEl=$('[data-bp-weight]');
  if(hEl)hEl.addEventListener('input',function(e){state.height=+e.target.value;renderFit();});
  if(wEl)wEl.addEventListener('input',function(e){state.weight=+e.target.value;renderFit();});
  $$('[data-bp-prefs] button').forEach(function(btn){btn.addEventListener('click',function(){$$('[data-bp-prefs] button').forEach(function(x){x.classList.remove('is-on');});btn.classList.add('is-on');state.pref=btn.dataset.pref;renderFit();});});
  var applyBtn=$('[data-bp-applyfit]'); if(applyBtn)applyBtn.addEventListener('click',function(){selectSize(compute().size);closeM();});
  var rows=$$('[data-bp-chartrows] .bp-chart__r'),note=$('[data-bp-modenote]');
  var NOTES={Slim:'Tailored through chest & waist for a sharp silhouette.',Regular:'Recommended everyday fit — clean lines, room to move. True to size.',Relaxed:'Extra room for comfort & layering. Size down if between sizes.',Oversized:'Deliberately roomy streetwear cut. Size down one.'};
  function applyMode(btn){var adj=parseFloat(btn.dataset.adj)||0;$$('[data-bp-fitmodes] button').forEach(function(x){x.classList.toggle('is-on',x===btn);});rows.forEach(function(r){var base=parseFloat(r.dataset.chest)||0;var ce=r.querySelector('.bp-chart__chest');if(ce)ce.textContent=(base+adj).toFixed(1)+'"';});if(note)note.textContent=NOTES[btn.dataset.mode]||'';}
  $$('[data-bp-fitmodes] button').forEach(function(btn){btn.addEventListener('click',function(){applyMode(btn);});});
  function highlight(size){rows.forEach(function(r){r.classList.toggle('is-rec',r.dataset.size===(size||'').toUpperCase());});}
  function selectSize(size){var t=(size||'').toUpperCase(),done=false;
    document.querySelectorAll('input[type=radio]').forEach(function(inp){if(done)return;if((inp.value||'').trim().toUpperCase()===t){inp.checked=true;inp.dispatchEvent(new Event('change',{bubbles:true}));done=true;}});
    if(!done)document.querySelectorAll('label,button,.bp-sz').forEach(function(el){if(done)return;if((el.textContent||'').trim().toUpperCase()===t){el.click();done=true;}});
  }
  renderFit();
})();
</script>
{%- endif -%}

<script>
  // We save the product ID in local storage to be eventually used for recently viewed section
  try {
    let recentlyViewedProducts = JSON.parse(localStorage.getItem('theme:recently-viewed-products') || '[]');

    recentlyViewedProducts = recentlyViewedProducts.filter(item => item !== {{ product.id }}); // Delete product to remove to the start
    recentlyViewedProducts.unshift({{ product.id }}); // Add at the start

    localStorage.setItem('theme:recently-viewed-products', JSON.stringify(recentlyViewedProducts));
  } catch (e) {
    // Safari in private mode does not allow setting item, we silently fail
  }
</script>

{%- comment -%} Bluprint blocks — interactivity (independent, DOM-ready) {%- endcomment -%}
<script>
(function () {
  function boot() {
    /* Offers carousel dots */
    document.querySelectorAll('[data-bp-offers]').forEach(function (rail) {
      if (rail.dataset.bpBound) return; rail.dataset.bpBound = '1';
      var off = rail.closest('.bp-off'); if (!off) return;
      var dotWrap = off.querySelector('[data-bp-offdots]'); if (!dotWrap) return;
      var cards = [].slice.call(rail.querySelectorAll('.bp-offcard'));
      cards.forEach(function (_, i) {
        var b = document.createElement('button'); if (i === 0) b.className = 'is-on';
        b.addEventListener('click', function () { cards[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' }); });
        dotWrap.appendChild(b);
      });
      var dots = [].slice.call(dotWrap.querySelectorAll('button'));
      rail.addEventListener('scroll', function () {
        var idx = Math.round(rail.scrollLeft / (rail.scrollWidth / Math.max(cards.length,1)));
        dots.forEach(function (d, i) { d.classList.toggle('is-on', i === idx); });
      }, { passive: true });
    });

    /* Fabric DNA tabs */
    document.querySelectorAll('[data-bp-fabtabs]').forEach(function (tabs) {
      if (tabs.dataset.bpBound) return; tabs.dataset.bpBound = '1';
      var fab = tabs.closest('.bp-fab'); if (!fab) return;
      tabs.querySelectorAll('.bp-tab').forEach(function (t) {
        t.addEventListener('click', function () {
          tabs.querySelectorAll('.bp-tab').forEach(function (x) { x.classList.toggle('is-on', x === t); });
          fab.querySelectorAll('.bp-fabpane').forEach(function (p) { p.hidden = p.dataset.pane !== t.dataset.tab; });
        });
      });
    });

    /* Accordions (details + faq) */
    document.querySelectorAll('[data-bp-acc]').forEach(function (acc) {
      if (acc.dataset.bpBound) return; acc.dataset.bpBound = '1';
      var isFaq = acc.classList.contains('bp-faq');
      acc.querySelectorAll(isFaq ? '.bp-faq__i' : '.bp-acc__i').forEach(function (item) {
        var btn = item.querySelector(isFaq ? '.bp-faq__b' : '.bp-acc__b');
        var panel = item.querySelector(isFaq ? '.bp-faq__p' : '.bp-acc__p');
        var mark = btn.querySelector(isFaq ? 'em' : '.bp-acc__x');
        btn.addEventListener('click', function () {
          var open = isFaq ? !panel.hidden : item.classList.contains('is-open');
          if (isFaq) { panel.hidden = open; if (mark) mark.textContent = open ? '+' : '−'; }
          else { item.classList.toggle('is-open', !open); panel.hidden = open; if (mark) mark.textContent = open ? '▼' : '▲'; }
        });
      });
    });

    /* Reviews (tabs + filters + seeded data) */
    document.querySelectorAll('[data-bp-rev]').forEach(function (wrap) {
      if (wrap.dataset.bpBound) return; wrap.dataset.bpBound = '1';
      var REVIEWS = (function(){
        var el = wrap.querySelector('[data-bp-reviews]'); if (el) { try { var j = JSON.parse(el.textContent); if (j && j.length) return j; } catch(e){} }
        var seed = parseInt(wrap.dataset.bpSeed || '0', 10) || 7;
        function mulberry32(a){ return function(){ a|=0; a=a+0x6D2B79F5|0; var t=Math.imul(a^a>>>15,1|a); t=t+Math.imul(t^t>>>7,61|t)^t; return ((t^t>>>14)>>>0)/4294967296; }; }
        var rnd = mulberry32(seed);
        function pick(a){ return a[Math.floor(rnd()*a.length)]; }
        var FIRST=['Arjun','Rohit','Sahil','Nikhil','Karan','Aditya','Rahul','Vikram','Ankit','Siddharth','Aman','Harsh','Kunal','Manish','Rajat','Varun','Dev','Yash','Ishaan','Kabir','Naveen','Pranav','Tarun','Gaurav','Abhishek','Nitin','Sameer','Rohan','Akash','Vivek','Shaurya','Aryan','Raghav','Mohit','Parth','Dhruv','Anirudh','Saurabh','Jatin','Rishabh','Ayush','Kartik','Sanjay','Utkarsh','Nakul'];
        var LAST=['M.','K.','V.','P.','D.','S.','R.','B.','G.','C.','N.','T.','J.','A.','H.','L.'];
        var BUILD=['Athletic','Slim','Broad','Regular','Lean','Stocky'];
        var OCC=['Office','Wedding','College','Daily wear','Travel','Party','Date night','Casual Friday','Festive','Brunch','Work from office','Gifting','Dinner'];
        var FIT=['True to size','Runs slim','Roomy','Perfect fit','Slightly relaxed'];
        var OPEN=['Genuinely looks premium.','Easily my best shirt this year.','Better than brands twice the price.','Insane value for the money.','Exactly what the photos show.','Quality caught me off guard.','Feels like a luxury pickup.','My go-to shirt now.','Did not expect this at this price.','Looks way more expensive than it is.'];
        var FABRIC=['Fabric is soft but structured.','The weave breathes really well.','Cotton feels rich, not stiff.','Zero transparency, holds shape.','Premium hand-feel, no itch.','Thick enough to feel luxe, light enough for all-day.','Drapes beautifully without clinging.'];
        var FITX=['Fit is spot on for my build.','Shoulders sit perfectly.','Tapers clean without being tight.','Length is just right, tucked or open.','Sleeves end exactly at the wrist.','No ballooning at the waist.','Sits clean across the chest.'];
        var CARE=['Colour held after many washes.','No shrinkage after wash.','Stitching is tight everywhere.','Buttons feel solid.','Collar keeps its shape all day.','Zero wrinkles after a full day out.','Still looks new after weeks.'];
        var CLOSE=['Already ordered another colour.','Highly recommend.','Would buy again in a heartbeat.','Worth every rupee.','Would suggest to friends.','Got compliments all evening.',''];
        function sentence(){ var p=[pick(OPEN)]; if(rnd()<.9)p.push(pick(FABRIC)); if(rnd()<.85)p.push(pick(FITX)); if(rnd()<.7)p.push(pick(CARE)); if(rnd()<.6)p.push(pick(CLOSE)); return p.join(' ').trim(); }
        var SIZES=['S','M','L','XL','XXL'];
        var out=[], count=12+Math.floor(rnd()*4);
        for(var k=0;k<count;k++){
          var h=165+Math.floor(rnd()*28), w=58+Math.floor(rnd()*44), si;
          if(w<62)si=0; else if(w<74)si=1; else if(w<86)si=2; else if(w<98)si=3; else si=4;
          var nm=pick(FIRST)+' '+pick(LAST), parts=nm.split(' ');
          out.push({ name:nm, initials:(parts[0][0]+parts[1][0]).toUpperCase(), h:h, w:w, size:SIZES[si], build:pick(BUILD), rating: (function(){var _r=rnd();return _r<.55?5:(_r<.9?4:3);})(), occasion:pick(OCC), text:sentence(), fit:pick(FIT), helpful: 6+Math.floor(rnd()*55) });
        }
        return out;
      })();
      var AV = ['var(--nav)','var(--green)','var(--coral)'], filter = 'all', mySize = 'M', H = 178, W = 74;
      function esc(s){ var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
      function stars(n){ return '★★★★★'.slice(0,n) + '☆☆☆☆☆'.slice(0,5-n); }
      function ini(r){ return (r.initials || (r.name||'?').split(' ').map(function(x){ return x[0]||''; }).join('')).slice(0,2).toUpperCase(); }
      function card(r,i){
        var ph = '';
        return '<div class="bp-rcard"><div class="bp-rcard__top"><span class="bp-rcard__av" style="background:'+AV[i%3]+'">'+esc(ini(r))+'</span><div class="bp-rcard__id"><div class="bp-rcard__nm">'+esc(r.name)+' <em>✓ Verified</em></div><div class="bp-rcard__meta">'+r.h+'cm · '+r.w+'kg · '+esc(r.size)+' · '+esc(r.occasion)+'</div></div><span class="bp-rcard__st">'+stars(r.rating)+'</span></div><p class="bp-rcard__tx">'+esc(r.text)+'</p>'+ph+'<div class="bp-rcard__ft"><span class="bp-rcard__fit">✓ '+esc(r.fit)+'</span><button type="button" class="bp-rcard__help">↑ '+r.helpful+'</button></div></div>';
      }
      function renderList(){
        var listEl = wrap.querySelector('[data-bp-rcards]'), empty = wrap.querySelector('[data-bp-rempty]');
        if (!listEl) return;
        var rows = REVIEWS.filter(function(r){
          if (filter==='photos') return r.photos;
          if (filter==='5') return r.rating===5;
          if (filter==='mysize') return (r.size||'').toUpperCase()===mySize.toUpperCase();
          return true;
        });
        listEl.innerHTML = rows.map(card).join('');
        if (empty) empty.hidden = rows.length>0;
      }
      function renderMatch(){
        var el = wrap.querySelector('[data-bp-matchcards]'); if (!el) return;
        var hw = wrap.querySelector('[data-bp-matchhw]'); if (hw) hw.textContent = H+'cm · '+W+'kg';
        var scored = REVIEWS.map(function(r){ return { r:r, d:Math.abs(r.h-H)/4+Math.abs(r.w-W)/5 }; }).sort(function(a,b){return a.d-b.d;}).slice(0,2);
        el.innerHTML = scored.map(function(s,i){
          var r=s.r, pct=Math.max(82,Math.round(100-s.d*9));
          return '<div class="bp-rcard"><div class="bp-rcard__top"><span class="bp-rcard__av" style="background:var(--green)">'+esc(ini(r))+'</span><div class="bp-rcard__id"><div class="bp-rcard__nm">'+esc(r.name)+'</div><div class="bp-rcard__meta">'+r.h+'cm · '+r.w+'kg · '+esc(r.build)+'</div></div><span class="bp-rcard__pct">'+pct+'% match</span></div><p class="bp-rcard__tx">"'+esc(r.text)+'"</p><div class="bp-rcard__fit">Bought '+esc(r.size)+' · '+esc(r.fit)+'</div></div>';
        }).join('');
      }
      wrap.querySelectorAll('[data-bp-revtabs] .bp-tab').forEach(function(t){
        t.addEventListener('click', function(){
          wrap.querySelectorAll('[data-bp-revtabs] .bp-tab').forEach(function(x){ x.classList.toggle('is-on', x===t); });
          wrap.querySelectorAll('.bp-revpane').forEach(function(p){ p.hidden = p.dataset.pane !== t.dataset.tab; });
          if (t.dataset.tab==='photos') renderList();
          if (t.dataset.tab==='match') renderMatch();
        });
      });
      wrap.querySelectorAll('[data-bp-revfilters] button').forEach(function(b){
        b.addEventListener('click', function(){
          wrap.querySelectorAll('[data-bp-revfilters] button').forEach(function(x){ x.classList.toggle('is-on', x===b); });
          filter = b.dataset.f; renderList();
        });
      });
      renderList(); renderMatch();
    });

    /* Buy box: success flash on Add-to-cart (observer only — never touches cart logic) */
    document.querySelectorAll('.bp-buybox').forEach(function (box) {
      if (box.dataset.bpAtcObs) return; box.dataset.bpAtcObs = '1';
      new MutationObserver(function (muts) {
        muts.forEach(function (m) {
          var t = m.target;
          if (!(t && t.matches && t.matches('button[name="add"], .product-form__submit'))) return;
          var busy = t.getAttribute('aria-busy') === 'true' || t.classList.contains('loading') || t.classList.contains('is-loading');
          if (busy) { t.dataset.bpWasBusy = '1'; }
          else if (t.dataset.bpWasBusy) {
            t.dataset.bpWasBusy = '';
            t.classList.add('bp-atc--done');
            setTimeout(function () { t.classList.remove('bp-atc--done'); }, 1400);
          }
        });
      }).observe(box, { subtree: true, attributes: true, attributeFilter: ['aria-busy', 'class'] });
    });
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', boot); } else { boot(); }
})();
</script>

{%- comment -%} Editorial refinement — the block list supplies the vertical rhythm {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .product-info__block-list { display: flex !important; flex-direction: column !important; row-gap: {{ section.settings.bp_block_gap | default: 0 }}px !important; gap: {{ section.settings.bp_block_gap | default: 0 }}px !important; }
  #shopify-section-{{ section.id }} .bp-blk { margin-top: 0 !important; }
  #shopify-section-{{ section.id }} .product-info__block-item { margin-block: 0 !important; }
  {%- comment -%} Each block owns its own top margin, exactly as the artboards do. {%- endcomment -%}
  #shopify-section-{{ section.id }} .bp-blk .bp-mod { margin: 30px 0 0; }
  #shopify-section-{{ section.id }} .bp-blk .bp-rew { margin: 22px 0 0; }
  #shopify-section-{{ section.id }} .bp-blk .bp-promise,
  #shopify-section-{{ section.id }} .bp-blk .bp-loved,
  #shopify-section-{{ section.id }} .bp-blk .bp-founder,
  #shopify-section-{{ section.id }} .bp-blk .bp-panel { margin: 30px 0 0; }
  {%- comment -%} The topbar, ticker and sticky bar sit flush. {%- endcomment -%}
  #shopify-section-{{ section.id }} .bp-blk .bp-top,
  #shopify-section-{{ section.id }} .bp-blk .bp-hero { margin: 0; }
  #shopify-section-{{ section.id }} .bp-blk .bp-ticker { margin: 22px 0 0; }
  {%- comment -%} room for the fixed sticky bar, so it never sits on the last block {%- endcomment -%}
  {%- for block in section.blocks -%}{%- if block.type == 'sticky-bar' -%}
  #shopify-section-{{ section.id }} .product-info { padding-bottom: 96px !important; }
  {%- break -%}{%- endif -%}{%- endfor -%}
{%- endstyle -%}

{%- comment -%} per-block custom font loading {%- endcomment -%}
{%- style -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.custom_fonts -%}
      {{ block.settings.f_head | font_face: font_display: 'swap' }}
      {{ block.settings.f_body | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endfor -%}
  /* per-block body text size */
  #shopify-section-{{ section.id }} .bp-blk .bp-sub,
  #shopify-section-{{ section.id }} .bp-blk .bp-diff__s,
  #shopify-section-{{ section.id }} .bp-blk .bp-pr__s,
  #shopify-section-{{ section.id }} .bp-blk .bp-acc__txt,
  #shopify-section-{{ section.id }} .bp-blk .bp-faq__p,
  #shopify-section-{{ section.id }} .bp-blk .bp-rcard__tx,
  #shopify-section-{{ section.id }} .bp-blk .bp-founder__q,
  #shopify-section-{{ section.id }} .bp-blk .bp-cmp__c1,
  #shopify-section-{{ section.id }} .bp-blk .bp-aisum p,
  #shopify-section-{{ section.id }} .bp-blk .bp-pt__r { font-size: var(--bp-bodys, inherit); }
  /* Native variant picker must EXIST in the template because the quick-buy modal only renders
     allowlisted blocks (BP · Size picker is not one). It is hidden here on the product page,
     where BP · Size picker is shown instead. Still visible inside quick-buy-modal, so the
     cross-sell / complementary-product quick buy on this page keeps working. */
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="variant-picker"]:not(quick-buy-modal *) { display: none !important; }
{%- endstyle -%}

{%- comment -%} Bluprint · Purchase module — Neo-Brutalist Luxury skin over the NATIVE cart controls. The quantity input, Add-to-cart submit & dynamic-checkout button are the theme's own — variant, quantity clamp, inventory & sold-out logic are 100% native and untouched. {%- endcomment -%}
{%- style -%}
  {%- if section.settings.bp_use_bricolage != false -%}
  /* Bricolage Grotesque across the page; the purchase module uses Fragment Mono (below). Font pickers apply when this is off. */
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} .bp-blk,
  #shopify-section-{{ section.id }} .bp-blk *,
  #shopify-section-{{ section.id }} [data-bp-fit],
  #shopify-section-{{ section.id }} [data-bp-fit] * {
    --disp: 'Bricolage Grotesque', system-ui, sans-serif;
    --body: 'Bricolage Grotesque', system-ui, sans-serif;
    font-family: 'Bricolage Grotesque', system-ui, sans-serif !important;
  }
  {%- endif -%}

  /* ===== Purchase module card ===== */
  #shopify-section-{{ section.id }} .bp-buybox {
    --pm-ink: {{ section.settings.bbx_ink | default: '#1B1D1F' }};
    --pm-paper: {{ section.settings.bbx_paper | default: '#F6F2E9' }};
    --pm-paper2: #EDE7DA; --pm-paper3: #E3DBC9; --pm-muted: #57534A;
    --pm-atc-fg: {{ section.settings.bbx_atc_fg | default: '#F6F2E9' }};
    --pm-rad: {{ section.settings.bbx_radius | default: 8 }}px;
    box-sizing: border-box; width: 100%;
    display: flex; flex-direction: column; align-items: stretch; gap: 4px; padding: 6px 11px;
    border: 1.5px solid var(--pm-ink); border-radius: calc(var(--pm-rad) + 2px);
    background: var(--pm-paper);
    box-shadow: 6px 6px 0 rgba(27,29,31,.9);
    color: var(--pm-ink);
    --pm-font: {% if section.settings.bbx_use_mono != false %}'Fragment Mono', ui-monospace, 'SF Mono', Menlo, monospace{% else %}{{ section.settings.bbx_font.family }}, {{ section.settings.bbx_font.fallback_families }}{% endif %};
  }
  #shopify-section-{{ section.id }} .bp-buybox,
  #shopify-section-{{ section.id }} .bp-buybox * {
    box-sizing: border-box; -webkit-tap-highlight-color: transparent;
    font-family: var(--pm-font) !important;
  }
  /* Layout: STACKED & bulletproof — quantity on its own row (compact, left), Add to Cart full-width (the hero),
     Buy now full-width below. No display:contents / order tricks, so it renders correctly whatever the theme's
     internal buy-button markup is. Cart/checkout markup & logic are untouched. */
  #shopify-section-{{ section.id }} .bp-buybox product-form,
  #shopify-section-{{ section.id }} .bp-buybox product-form > form { display: block !important; width: 100% !important; margin: 0 !important; }
  #shopify-section-{{ section.id }} .bp-buybox .product-form__buttons { display: flex !important; flex-direction: column !important; gap: 12px !important; width: 100% !important; align-items: stretch !important; margin: 0 !important; }
  #shopify-section-{{ section.id }} .bp-buybox quantity-selector,
  #shopify-section-{{ section.id }} .bp-buybox .quantity-selector,
  #shopify-section-{{ section.id }} .bp-buybox [class*="quantity-selector"] { align-self: flex-start !important; }

  /* ---- QUANTITY stepper (native <input name="quantity"> + native +/- buttons; behaviour untouched) ---- */
  /* No overflow clipping (was hiding the + on some themes); rounded ends come from the buttons themselves. */
  #shopify-section-{{ section.id }} .bp-buybox quantity-selector,
  #shopify-section-{{ section.id }} .bp-buybox .quantity-selector,
  #shopify-section-{{ section.id }} .bp-buybox [class*="quantity-selector"],
  #shopify-section-{{ section.id }} .bp-buybox [class*="quantity-input"] {
    align-self: flex-start; display: inline-flex !important; align-items: stretch !important;
    width: auto !important; max-width: 100% !important; min-width: 0 !important; flex: 0 0 auto !important;
    height: 26px !important; margin: 0 !important; padding: 0 !important; overflow: visible !important; gap: 0 !important;
    border: 1.5px solid var(--pm-ink) !important; border-radius: var(--pm-rad) !important;
    background: var(--pm-paper) !important; box-shadow: none !important;
  }
  #shopify-section-{{ section.id }} .bp-buybox [class*="quantity"] button {
    flex: 0 0 auto !important; width: 30px !important; min-width: 30px !important; height: auto !important; align-self: stretch !important;
    margin: 0 !important; padding: 0 !important; border: none !important; border-radius: 0 !important;
    background: var(--pm-paper2) !important; color: var(--pm-ink) !important; cursor: pointer; opacity: 1 !important; visibility: visible !important;
    display: inline-flex !important; align-items: center !important; justify-content: center !important;
    font-size: 14px !important; font-weight: 400 !important; line-height: 1 !important;
    box-shadow: none !important; transition: background .15s ease, color .15s ease !important; }
  #shopify-section-{{ section.id }} .bp-buybox [class*="quantity"] button:first-of-type { border-right: 1.5px solid var(--pm-ink) !important; border-radius: calc(var(--pm-rad) - 1px) 0 0 calc(var(--pm-rad) - 1px) !important; }
  #shopify-section-{{ section.id }} .bp-buybox [class*="quantity"] button:last-of-type  { border-left: 1.5px solid var(--pm-ink) !important; border-radius: 0 calc(var(--pm-rad) - 1px) calc(var(--pm-rad) - 1px) 0 !important; }
  #shopify-section-{{ section.id }} .bp-buybox [class*="quantity"] button:hover { background: var(--pm-paper3) !important; }
  #shopify-section-{{ section.id }} .bp-buybox [class*="quantity"] button:active { background: var(--pm-ink) !important; color: var(--pm-paper) !important; }
  #shopify-section-{{ section.id }} .bp-buybox [class*="quantity"] button svg,
  #shopify-section-{{ section.id }} .bp-buybox [class*="quantity"] button img {
    width: 11px !important; height: 11px !important; display: block !important; opacity: 1 !important;
    fill: currentColor !important; stroke: currentColor !important; color: var(--pm-ink) !important; }
  #shopify-section-{{ section.id }} .bp-buybox quantity-selector input,
  #shopify-section-{{ section.id }} .bp-buybox .quantity-selector input,
  #shopify-section-{{ section.id }} .bp-buybox [class*="quantity"] input {
    flex: 0 0 auto !important; width: 36px !important; min-width: 36px !important; max-width: 36px !important;
    height: auto !important; align-self: stretch !important; padding: 0 !important; margin: 0 !important; box-sizing: border-box !important;
    border: none !important; background: transparent !important; box-shadow: none !important; outline: none !important;
    text-align: center !important; text-indent: 0 !important; direction: ltr !important;
    color: var(--pm-ink) !important; font-size: 13px !important; font-weight: 400 !important;
    font-variant-numeric: tabular-nums; -moz-appearance: textfield !important; appearance: textfield !important; }
  #shopify-section-{{ section.id }} .bp-buybox [class*="quantity"] input::-webkit-outer-spin-button,
  #shopify-section-{{ section.id }} .bp-buybox [class*="quantity"] input::-webkit-inner-spin-button { -webkit-appearance: none !important; margin: 0 !important; }

  /* ---- ADD TO CART (native submit; the hero) ---- */
  #shopify-section-{{ section.id }} .bp-buybox button[name="add"],
  #shopify-section-{{ section.id }} .bp-buybox .product-form__submit,
  #shopify-section-{{ section.id }} .bp-buybox product-form button[type="submit"] {
    position: relative; width: 100% !important; height: 38px !important; min-height: 38px !important;
    margin: 0 !important; padding: 0 16px !important; cursor: pointer; overflow: visible;
    border: 1.5px solid var(--pm-ink) !important; border-radius: var(--pm-rad) !important;
    background: var(--pm-ink) !important; color: var(--pm-atc-fg) !important;
    font-size: 14px !important; font-weight: 500 !important; letter-spacing: .1em !important; text-transform: uppercase !important;
    box-shadow: 3px 3px 0 rgba(27,29,31,.35) !important;
    transition: transform .12s ease, box-shadow .12s ease, background .12s ease !important; }
  #shopify-section-{{ section.id }} .bp-buybox button[name="add"]:hover:not([disabled]):not([aria-disabled="true"]),
  #shopify-section-{{ section.id }} .bp-buybox .product-form__submit:hover:not([disabled]) {
    transform: translate(-1px,-1px); box-shadow: 5px 5px 0 rgba(27,29,31,.4) !important; }
  #shopify-section-{{ section.id }} .bp-buybox button[name="add"]:active:not([disabled]):not([aria-disabled="true"]),
  #shopify-section-{{ section.id }} .bp-buybox .product-form__submit:active:not([disabled]) {
    transform: translate(3px,3px); box-shadow: 0 0 0 rgba(27,29,31,0) !important; }
  /* loading + success (observer toggles the class; never touches cart logic) */
  #shopify-section-{{ section.id }} .bp-buybox button[name="add"][aria-busy="true"] { cursor: progress; }
  #shopify-section-{{ section.id }} .bp-buybox button[name="add"].bp-atc--done { background: var(--pm-ink) !important; color: var(--pm-atc-fg) !important; }
  #shopify-section-{{ section.id }} .bp-buybox button[name="add"].bp-atc--done::after {
    content: "\2713 Added"; position: absolute; inset: 0; z-index: 2; display: flex; align-items: center; justify-content: center;
    gap: 6px; background: var(--pm-ink); color: var(--pm-atc-fg); border-radius: var(--pm-rad);
    font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
    animation: pm-check .42s cubic-bezier(.2,.9,.3,1.2) both; }
  @keyframes pm-check { 0%{ transform: scale(.4); opacity: 0 } 62%{ transform: scale(1.05) } 100%{ transform: scale(1); opacity: 1 } }
  /* ---- SOLD OUT / UNAVAILABLE (native disabled state — now clearly visible) ---- */
  #shopify-section-{{ section.id }} .bp-buybox button[name="add"][disabled],
  #shopify-section-{{ section.id }} .bp-buybox button[name="add"][aria-disabled="true"],
  #shopify-section-{{ section.id }} .bp-buybox .product-form__submit[disabled] {
    background: var(--pm-paper2) !important; color: var(--pm-muted) !important;
    border-style: dashed !important; box-shadow: none !important; transform: none !important; cursor: not-allowed !important; }

  /* ---- BUY IT NOW (native dynamic checkout; secondary ghost) ---- */
  #shopify-section-{{ section.id }} .bp-buybox .shopify-payment-button { margin: 0 !important; }
  #shopify-section-{{ section.id }} .bp-buybox .shopify-payment-button__button,
  #shopify-section-{{ section.id }} .bp-buybox shopify-payment-button button:not([class*="more"]) {
    width: 100% !important; height: 38px !important; min-height: 38px !important; margin: 0 !important; padding: 0 16px !important;
    cursor: pointer; border: 1.5px solid var(--pm-ink) !important; border-radius: var(--pm-rad) !important;
    background: var(--pm-paper) !important; color: var(--pm-ink) !important;
    font-size: 11px !important; font-weight: 400 !important; letter-spacing: .1em !important; text-transform: uppercase !important;
    box-shadow: none !important; transition: background .15s ease !important; }
  #shopify-section-{{ section.id }} .bp-buybox .shopify-payment-button__button:hover { background: var(--pm-paper2) !important; }
  #shopify-section-{{ section.id }} .bp-buybox .shopify-payment-button__button:active { background: var(--pm-paper3) !important; }
  #shopify-section-{{ section.id }} .bp-buybox .shopify-payment-button__more-options {
    color: var(--pm-muted) !important; text-decoration: none !important; font-size: 11px !important;
    letter-spacing: .04em !important; text-transform: uppercase !important; margin-top: 2px !important; }

  /* ===== Out-of-stock: hard-block Add/Buy when the selected size is sold out ===== */
  #shopify-section-{{ section.id }} .bp-sz.bp-oos { position: relative; opacity: .4; cursor: not-allowed; text-decoration: line-through; text-decoration-thickness: 1.5px; }
  #shopify-section-{{ section.id }} .bp-buybox button[name="add"].bp-soldout,
  #shopify-section-{{ section.id }} .bp-buybox .product-form__submit.bp-soldout {
    background: #EDE7DA !important; color: #57534A !important; border: 1.5px dashed {{ section.settings.bbx_ink | default: '#1B1D1F' }} !important;
    box-shadow: none !important; transform: none !important; cursor: not-allowed !important; pointer-events: none !important; }
  #shopify-section-{{ section.id }} .bp-buybox button[name="add"].bp-soldout > * { visibility: hidden; }
  #shopify-section-{{ section.id }} .bp-buybox button[name="add"].bp-soldout::after {
    content: "Sold out \2014 pick another size"; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: #57534A; }
  #shopify-section-{{ section.id }} .bp-buybox .shopify-payment-button.bp-oos,
  #shopify-section-{{ section.id }} .bp-buybox shopify-payment-button.bp-oos { pointer-events: none !important; opacity: .35 !important; filter: grayscale(1); }

  {%- if section.settings.bbx_connect != false -%}
  /* ===== Connect: Rewards & guarantees becomes the bottom half of the purchase module (JS toggles .bp-join--top / .bp-join--bot) ===== */
  #shopify-section-{{ section.id }} .bp-join--top .bp-buybox {
    border-bottom-left-radius: 0 !important; border-bottom-right-radius: 0 !important;
    border-bottom: 1.5px dashed {{ section.settings.bbx_ink | default: '#1B1D1F' }} !important; box-shadow: 6px 0 0 rgba(27,29,31,.9) !important; }
  #shopify-section-{{ section.id }} .bp-join--bot { margin-top: calc(-1 * {{ section.settings.bp_block_gap | default: 18 }}px) !important; }
  #shopify-section-{{ section.id }} .bp-join--bot .bp-blk--rewards { margin: 0 !important; }
  #shopify-section-{{ section.id }} .bp-join--bot .bp-rew {
    margin: 0 !important; position: relative; overflow: hidden;
    background: {{ section.settings.bbx_paper | default: '#F6F2E9' }} !important; color: {{ section.settings.bbx_ink | default: '#1B1D1F' }} !important;
    border: 1.5px solid {{ section.settings.bbx_ink | default: '#1B1D1F' }} !important; border-top: none !important;
    border-radius: 0 0 calc({{ section.settings.bbx_radius | default: 8 }}px + 2px) calc({{ section.settings.bbx_radius | default: 8 }}px + 2px) !important;
    box-shadow: 6px 6px 0 rgba(27,29,31,.9) !important; padding: 16px 18px !important;
    font-family: {% if section.settings.bbx_use_mono != false %}'Fragment Mono', ui-monospace, 'SF Mono', Menlo, monospace{% else %}{{ section.settings.bbx_font.family }}, {{ section.settings.bbx_font.fallback_families }}{% endif %} !important; }
  #shopify-section-{{ section.id }} .bp-join--bot .bp-rew * { font-family: {% if section.settings.bbx_use_mono != false %}'Fragment Mono', ui-monospace, 'SF Mono', Menlo, monospace{% else %}{{ section.settings.bbx_font.family }}, {{ section.settings.bbx_font.fallback_families }}{% endif %} !important; }
  #shopify-section-{{ section.id }} .bp-join--bot .bp-rew__glow { display: none !important; }
  #shopify-section-{{ section.id }} .bp-join--bot .bp-rew__head, #shopify-section-{{ section.id }} .bp-join--bot .bp-rew__head span { color: {{ section.settings.bbx_ink | default: '#1B1D1F' }} !important; text-transform: uppercase; letter-spacing: .06em; }
  #shopify-section-{{ section.id }} .bp-join--bot .bp-gcell { background: #EDE7DA !important; border: 1.5px solid {{ section.settings.bbx_ink | default: '#1B1D1F' }} !important; border-radius: {{ section.settings.bbx_radius | default: 8 }}px !important; box-shadow: none !important; }
  #shopify-section-{{ section.id }} .bp-join--bot .bp-gcell, #shopify-section-{{ section.id }} .bp-join--bot .bp-gcell * { color: {{ section.settings.bbx_ink | default: '#1B1D1F' }} !important; }
  {%- endif -%}
{%- endstyle -%}

{%- comment -%}
  Bluprint · ticket.

      - - - - - - - - - - - - - - - - - - - - - - -
      QTY   -  1  +  · · · · · · · · [ ADD TO CART ]
      - - - - - - - - - - - - - - - - - - - - - - -
      [             BUY IT NOW              ]

  No grid placement, no display:contents, no :has() on theme markup. The ticket
  line is our own div and Add to cart is moved into it by script. What the theme
  leaves behind holds only the payment button, and is stripped of every box it
  might draw — an unstripped wrapper is what put an empty outlined rectangle on
  the ticket line in an earlier build.
{%- endcomment -%}
{%- style -%}
  {%- assign _rad = section.settings.bbx_radius | default: 4 -%}

  #shopify-section-{{ section.id }} .bp-order {
    display: block !important; margin-top: 22px !important;
    border: none !important; border-top: 1px dashed var(--bp-ink, #171B22) !important;
    border-radius: 0 !important; background: transparent !important;
    box-shadow: none !important; padding: 0 !important; max-width: 100% !important;
    container-type: inline-size;
  }
  #shopify-section-{{ section.id }} .bp-order,
  #shopify-section-{{ section.id }} .bp-order * {
    box-sizing: border-box !important;
    font-family: var(--body, 'Hanken Grotesk', system-ui, sans-serif) !important;
  }

  {%- comment -%}
    Everything the theme still renders inside the ticket is plumbing around the
    payment button. Strip it flat so it cannot draw a box, and let it fill the row.
  {%- endcomment -%}
  {%- comment -%}
    Containers only. Buttons are excluded — stripping their background here beat
    the payment button's own colour and left Buy it now white on white.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .bp-order > *:not(.bp-order__line):not(.bp-order__rule):not(.bp-order__foot):not(button),
  #shopify-section-{{ section.id }} .bp-order > *:not(.bp-order__line):not(.bp-order__rule):not(.bp-order__foot) *:not(button):not(svg):not(path):not(img) {
    margin: 0 !important; padding: 0 !important; border: none !important;
    background: none !important; box-shadow: none !important; outline: none !important;
    max-width: 100% !important; min-width: 0 !important; float: none !important;
  }
  #shopify-section-{{ section.id }} .bp-order > *:not(.bp-order__line):not(.bp-order__rule):not(.bp-order__foot) {
    display: block !important; width: 100% !important;
  }

  {%- comment -%} the ticket line — our own row {%- endcomment -%}
  #shopify-section-{{ section.id }} .bp-order__line {
    display: flex !important; align-items: center !important;
    min-height: 62px; width: 100%; gap: 0;
  }
  #shopify-section-{{ section.id }} .bp-order__k {
    font-family: var(--mono, 'Fragment Mono', monospace) !important;
    font-size: 9.5px !important; letter-spacing: .16em !important;
    text-transform: uppercase; color: var(--bp-mut, #636A78) !important;
    white-space: nowrap; flex: 0 0 auto; padding-right: 14px;
  }
  #shopify-section-{{ section.id }} .bp-order__qty {
    display: flex !important; align-items: center !important; gap: 2px; flex: 0 0 auto;
  }
  #shopify-section-{{ section.id }} .bp-order__qty button {
    width: 28px; height: 28px; padding: 0; margin: 0; border: none; background: transparent;
    border-radius: {{ _rad }}px; color: var(--bp-mut, #636A78);
    font-size: 15px; line-height: 1; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  #shopify-section-{{ section.id }} .bp-order__qty button:hover {
    color: var(--bp-ink, #171B22); background: var(--bp-tint, #F1F3F6);
  }
  #shopify-section-{{ section.id }} .bp-order__qty input {
    width: 30px; padding: 0; margin: 0; text-align: center;
    border: none; background: transparent; border-radius: 0;
    color: var(--bp-ink, #171B22);
    font-family: var(--disp, 'Bricolage Grotesque', sans-serif);
    font-weight: var(--dw, 600); font-size: 16px; -moz-appearance: textfield;
  }
  #shopify-section-{{ section.id }} .bp-order__qty input::-webkit-outer-spin-button,
  #shopify-section-{{ section.id }} .bp-order__qty input::-webkit-inner-spin-button {
    -webkit-appearance: none; margin: 0;
  }
  #shopify-section-{{ section.id }} .bp-order__lead {
    flex: 1 1 auto; min-width: 20px; margin: 0 14px;
    border-bottom: 1px dotted var(--bp-line, #E1E4E9); height: 1px;
  }
  #shopify-section-{{ section.id }} .bp-order__rule {
    display: block !important; height: 0 !important;
    border-top: 1px dashed var(--bp-ink, #171B22) !important; margin-bottom: 12px !important;
  }

  {%- comment -%} Add to cart, once the script has moved it onto the line {%- endcomment -%}
  #shopify-section-{{ section.id }} .bp-order__line .bp-order__atc,
  #shopify-section-{{ section.id }} .bp-order__line button {
    flex: 0 0 auto !important;
    width: auto !important; max-width: 60% !important; min-width: 0 !important;
    height: 44px !important; min-height: 44px !important; margin: 0 !important;
    padding: 0 20px !important; border: none !important;
    border-radius: {{ _rad }}px !important; box-shadow: none !important; filter: none !important;
    display: flex !important; align-items: center !important; justify-content: center !important;
    white-space: nowrap !important; overflow: hidden !important; text-transform: uppercase !important;
    font-size: 11.5px !important; font-weight: 500 !important; letter-spacing: .14em !important;
    background: {{ section.settings.bbx_atc_bg | default: '#171B22' }} !important;
    color: {{ section.settings.bbx_atc_fg | default: '#FFFFFF' }} !important;
    transition: transform .1s ease, background-color .2s ease;
  }
  {%- comment -%} the stepper's own buttons must keep their bare look {%- endcomment -%}
  #shopify-section-{{ section.id }} .bp-order__line .bp-order__qty button {
    flex: 0 0 auto !important; width: 28px !important; height: 28px !important;
    padding: 0 !important; background: transparent !important;
    color: var(--bp-mut, #636A78) !important; font-size: 15px !important;
    letter-spacing: 0 !important; text-transform: none !important; max-width: none !important;
  }
  #shopify-section-{{ section.id }} .bp-order__line .bp-order__atc:active { transform: scale(.98); }
  #shopify-section-{{ section.id }} .bp-order__line .bp-order__atc[aria-busy="true"] { opacity: .78; cursor: wait; }
  #shopify-section-{{ section.id }} .bp-order__line .bp-order__atc:is([disabled], [aria-disabled="true"]) {
    background: var(--bp-line, #E1E4E9) !important; color: var(--bp-mut, #636A78) !important;
  }

  {%- comment -%} Buy it now — the full-width bar; Shopify owns its insides {%- endcomment -%}
  #shopify-section-{{ section.id }} .bp-order .shopify-payment-button__button,
  #shopify-section-{{ section.id }} .bp-order .shopify-payment-button button {
    width: 100% !important; height: 54px !important; min-height: 54px !important;
    margin: 0 !important; padding: 0 12px !important; border: none !important;
    border-radius: {{ _rad }}px !important; box-shadow: none !important; filter: none !important;
    display: flex !important; align-items: center !important; justify-content: center !important;
    white-space: nowrap !important; text-transform: uppercase !important;
    font-size: 12.5px !important; font-weight: 500 !important; letter-spacing: .14em !important;
    background: {{ section.settings.bbx_buy_bg | default: '#1F4FE0' }} !important;
    color: {{ section.settings.bbx_buy_fg | default: '#FFFFFF' }} !important;
    transition: transform .1s ease, background-color .2s ease;
  }
  #shopify-section-{{ section.id }} .bp-order .shopify-payment-button__button:active { transform: scale(.995); }

  {%- comment -%}
    Hide a theme stepper only if it holds a quantity field and no button — a broad
    match here once hid Add to cart, which this theme nests in a container named
    for quantity.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .bp-order
    :is(quantity-selector, quantity-selector-component):has(input[name="quantity"]):not(:has(button[type="submit"])):not(:has([name="add"])) {
    display: none !important;
  }

  {%- comment -%} as the ticket narrows, the QTY word goes first, then the leader {%- endcomment -%}
  @container (max-width: 340px) { #shopify-section-{{ section.id }} .bp-order__qtyk { display: none !important; } }
  @container (max-width: 290px) { #shopify-section-{{ section.id }} .bp-order__lead { display: none !important; } }

  #shopify-section-{{ section.id }} .bp-order__foot {
    padding: 11px 0 0 !important; text-align: center;
    font-family: var(--mono, 'Fragment Mono', monospace) !important;
    font-size: 9px !important; letter-spacing: .14em !important;
    text-transform: uppercase; color: var(--bp-mut, #636A78) !important;
  }

  #shopify-section-{{ section.id }} {
    --bp-ink: {{ section.settings.bp_color_ink | default: _ink }};
    --bp-pg: {{ section.settings.bp_color_page | default: _pg }};
    --bp-card: {{ section.settings.bp_color_card | default: _card }};
    --bp-tint: {{ section.settings.bp_color_tint | default: _tint }};
    --bp-line: {{ section.settings.bp_color_line | default: _line }};
    --bp-mut: {{ section.settings.bp_color_muted | default: _mut }};
  }
{%- endstyle -%}

{% schema %}
{
  "name": "t:sections.main_product.name",
  "class": "shopify-section--main-product",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Bluprint layout"
    },
    {
      "type": "checkbox",
      "id": "bp_fullwidth",
      "label": "Full-width Bluprint layout (edge to edge)",
      "default": true
    },
    {
      "type": "range",
      "id": "bp_scale",
      "min": 60,
      "max": 110,
      "step": 5,
      "unit": "%",
      "label": "Content scale",
      "default": 85,
      "info": "Scales every block together. Lower it if the page reads too large."
    },
    {
      "type": "checkbox",
      "id": "bp_bleed_panels",
      "label": "Tint panels run to the screen edge",
      "default": false,
      "info": "Off is safer. On, panels break out of the gutter, which only lines up if the container padding matches it."
    },
    {
      "type": "range",
      "id": "bp_gutter",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Side gutter",
      "default": 10
    },
    {
      "type": "range",
      "id": "bp_maxwidth",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Max content width (0 = full screen)",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "bp_hide_gallery",
      "label": "Hide theme gallery (use BP Hero block)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bp_auto_rating",
      "label": "Auto rating per product (matches header + reviews)",
      "default": true
    },
    {
      "type": "color_scheme",
