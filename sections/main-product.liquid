.bp-fit__prefs button.is-on { background: var(--nav); color: #F6F2EB; border-color: var(--nav); }
.bp-fit__modes { margin-bottom: 11px; } .bp-fit__modes button { flex: 1; padding: 7px 3px; border-radius: 9px; border: 1.5px solid rgba(56,65,95,.14); background: #fff; color: var(--ink); font-size: 10px; font-weight: 600; cursor: pointer; transition: all .2s; }
.bp-fit__modes button.is-on { background: var(--nav); color: #F6F2EB; border-color: var(--nav); }
.bp-fit__result { border-radius: 15px; padding: 14px; background: linear-gradient(155deg,var(--nav),#454F72); color: #F6F2EB; display: flex; align-items: center; gap: 13px; }
.bp-fit__sz { text-align: center; flex: 0 0 auto; } .bp-fit__sz span { font-size: 9px; color: rgba(246,242,235,.7); } .bp-fit__sz b { font-family: var(--disp); font-weight: 700; font-size: 38px; line-height: 1; color: var(--gold); display: block; animation: bp-pop .4s ease both; }
.bp-fit__meta { flex: 1; }
.bp-fit__conf { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; } .bp-fit__bar { flex: 1; height: 6px; border-radius: 999px; background: rgba(255,255,255,.15); overflow: hidden; } .bp-fit__bar i { display: block; height: 100%; background: linear-gradient(90deg,var(--green),#A5D3BC); border-radius: 999px; transition: width .5s; } .bp-fit__conf span { font-weight: 700; font-size: 13px; }
.bp-fit__line { font-size: 11px; color: rgba(246,242,235,.82); line-height: 1.4; }
