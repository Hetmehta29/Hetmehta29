<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Fragment+Mono:ital@0;1&family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap">

{%- comment -%} Bluprint blocks — base styles + editor customisation {%- endcomment -%}
{%- style -%}
  {{ section.settings.bp_heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.bp_body_font | font_face: font_display: 'swap' }}
  {%- if section.settings.bbx_use_mono == false and section.settings.bbx_font != blank -%}{{ section.settings.bbx_font | font_face: font_display: 'swap' }}{%- endif -%}
  #shopify-section-{{ section.id }} .bp-blk {
    --nav: {{ section.settings.bp_color_dark }};
    --ink: {{ section.settings.bp_color_ink }};
    --ink2: {{ section.settings.bp_color_ink }};
    --muted: {{ section.settings.bp_color_muted }};
    --faint: {{ section.settings.bp_color_muted }};
    --card: {{ section.settings.bp_color_card }};
    --gold: {{ section.settings.bp_color_gold }};
    --gold2: {{ section.settings.bp_color_gold_deep }};
    --green: {{ section.settings.bp_color_green }};
    --green2: {{ section.settings.bp_color_green_deep }};
    --coral: {{ section.settings.bp_color_coral }};
    --coral2: {{ section.settings.bp_color_coral_deep }};
    --violet: {{ section.settings.bp_color_violet }};
    --disp: {{ section.settings.bp_heading_font.family }}, {{ section.settings.bp_heading_font.fallback_families }};
    --body: {{ section.settings.bp_body_font.family }}, {{ section.settings.bp_body_font.fallback_families }};
    font-size: {{ section.settings.bp_body_size }}px;
  }
  #shopify-section-{{ section.id }} .bp-blk .bp-mod,
  #shopify-section-{{ section.id }} .bp-blk .bp-rew { margin: 0; }
  #shopify-section-{{ section.id }} .bp-blk .bp-life__rail { padding-left: 0; padding-right: 0; }
  #shopify-section-{{ section.id }} .bp-blk .bp-h2 { font-size: var(--bp-h2s, {{ section.settings.bp_heading_size }}px); font-weight: var(--bp-h2w, 700); }
  #shopify-section-{{ section.id }} .bp-blk .bp-h2--tight { font-size: {{ section.settings.bp_heading_size | minus: 2 }}px; }
  #shopify-section-{{ section.id }} .bp-blk .bp-card,
  #shopify-section-{{ section.id }} .bp-blk .bp-fab,
  #shopify-section-{{ section.id }} .bp-blk .bp-rew,
  #shopify-section-{{ section.id }} .bp-blk .bp-promise,
  #shopify-section-{{ section.id }} .bp-blk .bp-loved { border-radius: {{ section.settings.bp_card_radius }}px; }
{%- endstyle -%}
<style>
/* ============================================================
   bluprint.css — Bluprint premium product page
   Ported from the approved prototype. Mobile-first, ~430px column.
   ============================================================ */
.bp-blk, .bp-blk * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
.bp-blk { --nav:#38415F; --ink:#1F1D1A; --ink2:#23272F; --muted:#6B655C; --faint:#9A9286;
  --line:rgba(56,65,95,.08); --card:#F7F5F1; --gold:#FFCE54; --gold2:#F0A11B; --goldd:#C4881B;
  --green:#17C27F; --green2:#0FA05F; --coral:#FF5C33; --coral2:#F04A1D; --violet:#7C4DFF; --sky:#4A7FE0; --rose:#DB4A8F;
  --disp:'Space Grotesk',system-ui,sans-serif; --body:'Hanken Grotesk',system-ui,sans-serif;
  font-family: var(--body); color: var(--ink); }
.bp-blk .bp-scroll { scrollbar-width: none; }
.bp-blk .bp-scroll::-webkit-scrollbar { display: none; }
.bp__wrap { position: relative; width: 100%; max-width: 430px; background: #fff; min-height: 100vh;
  box-shadow: 0 0 80px rgba(56,65,95,.10); overflow-x: hidden; padding-bottom: 130px; }
.bp__glow { position: absolute; top: 0; left: 0; right: 0; height: 620px; pointer-events: none;
  background: radial-gradient(58% 44% at 10% 0%, rgba(255,206,84,.24), transparent 62%),
    radial-gradient(48% 40% at 90% 2%, rgba(139,92,246,.16), transparent 60%),
    radial-gradient(52% 42% at 55% 15%, rgba(255,92,51,.10), transparent 64%); }
.bp-blk h1, .bp-blk h2, .bp-blk p { margin: 0; }
.bp-dot { width: 6px; height: 6px; border-radius: 50%; display: inline-block; }
.bp-dot--g { background: var(--green); animation: bp-pulse 1.4s infinite; }
.bp-dot--r { background: var(--coral); animation: bp-pulse 1.2s infinite; }
.bp-ai { width: 14px; height: 14px; border-radius: 4px; background: var(--gold); color: var(--nav);
  display: inline-flex; align-items: center; justify-content: center; font-size: 7px; font-weight: 800;
  font-family: var(--disp); flex: 0 0 auto; }
.bp-ph { background: repeating-linear-gradient(135deg,#EAE6DD 0 14px,#F2EFE9 14px 28px);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
  font-family: monospace; font-size: 10px; color: #8A8275; }
.bp-ph b { font-family: var(--disp); font-size: 12px; letter-spacing: .12em; }
.bp-eyebrow { display: inline-flex; align-items: center; font-family: var(--disp); font-weight: 700;
  letter-spacing: .14em; font-size: 10px; padding: 5px 11px; border-radius: 999px; margin-bottom: 8px; }
.bp-eyebrow--coral { color: var(--coral2); background: linear-gradient(120deg,rgba(255,92,51,.13),rgba(255,206,84,.22)); border: 1px solid rgba(255,92,51,.28); }
.bp-eyebrow--mint { color: var(--green2); background: rgba(23,194,127,.14); border: 1px solid rgba(23,194,127,.32); }
.bp-eyebrow--violet { color: var(--violet); background: rgba(139,92,246,.14); border: 1px solid rgba(139,92,246,.3); }
.bp-h2 { font-family: var(--disp); font-weight: 700; font-size: 20px; line-height: 1.12; letter-spacing: -.01em; }
.bp-h2--tight { font-size: 18px; }
.bp-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
.bp-card { border-radius: 22px; padding: 18px; background: var(--card); border: 1px solid var(--line); }
.bp-card--pad0 { padding: 0; overflow: hidden; border-radius: 20px; }
.bp-chip-g { padding: 4px 9px; border-radius: 999px; background: rgba(23,194,127,.12); color: var(--green); font-size: 11px; font-weight: 700; }
.bp-chip-n { padding: 5px 10px; border-radius: 999px; background: rgba(56,65,95,.06); font-size: 11px; font-weight: 600; color: #3A4654; }
.bp-tag-mint { padding: 3px 8px; border-radius: 999px; background: rgba(23,194,127,.14); color: var(--green2); font-size: 9px; font-weight: 800; letter-spacing: .03em; }
.bp-stars { color: var(--gold2); }
.bp-mod { margin: 46px 16px 0; position: relative; }
.bp-pill { display: flex; align-items: center; gap: 5px; padding: 5px 10px; border-radius: 999px; border: 1px solid rgba(56,65,95,.14); background: #fff; font-size: 11px; font-weight: 600; cursor: pointer; white-space: nowrap; color: var(--ink); }
.bp-pill--dark { border: none; background: var(--nav); color: #F6F2EB; }
.bp-linkbtn { background: none; border: none; padding: 0; color: var(--nav); font-weight: 600; font-size: 11px; text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }

/* top bar */
.bp-top { position: sticky; top: 0; z-index: 40; display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: rgba(255,255,255,.85); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border-bottom: 1px solid rgba(56,65,95,.06); }
.bp-top__logo { width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 9px; background: var(--nav); color: #F6F2EB; font-family: var(--disp); font-weight: 700; font-size: 16px; }
.bp-top__name { font-family: var(--disp); font-weight: 700; letter-spacing: .2em; font-size: 13px; }
.bp-top__live { margin-left: auto; display: flex; align-items: center; gap: 5px; padding: 4px 9px; border-radius: 999px; background: rgba(23,194,127,.1); font-size: 11px; font-weight: 600; color: var(--green); }

/* ticker */
.bp-ticker { overflow: hidden; background: linear-gradient(90deg,var(--coral) 0%,var(--gold2) 55%,var(--gold) 100%); padding: 9px 0; }
.bp-ticker__track { display: flex; gap: 34px; width: max-content; animation: bp-marquee 18s linear infinite; }
.bp-ticker__row { display: flex; align-items: center; gap: 12px; white-space: nowrap; font-family: var(--disp); font-weight: 700; font-size: 10px; letter-spacing: .16em; color: #fff; }
.bp-ticker__row i { font-style: normal; opacity: .7; }

/* hero */
.bp-hero { position: relative; margin: 14px 16px 0; animation: bp-rise .55s cubic-bezier(.2,.8,.2,1) both; }
.bp-hero__frame { position: relative; border-radius: 24px; overflow: hidden; aspect-ratio: 1/1; background: repeating-linear-gradient(135deg,#EAE6DD 0 14px,#F2EFE9 14px 28px); box-shadow: 0 18px 40px -22px rgba(56,65,95,.4); animation: bp-breathe 7s ease-in-out infinite; }
.bp-hero__img { width: 100%; height: 100%; object-fit: cover; display: block; }
.bp-hero__badges { position: absolute; top: 11px; left: 11px; display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
.bp-badge { padding: 5px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; }
.bp-badge--save { background: linear-gradient(135deg,var(--coral),var(--gold2)); color: #fff; box-shadow: 0 4px 12px -4px rgba(255,92,51,.55); }
.bp-badge--trend { background: rgba(56,65,95,.86); color: #F6F2EB; font-size: 10px; font-weight: 600; backdrop-filter: blur(6px); }
.bp-badge--stock { position: absolute; top: 11px; right: 11px; background: linear-gradient(135deg,var(--gold),#FFB52E); color: var(--ink2); font-size: 10px; box-shadow: 0 4px 12px -4px rgba(239,182,58,.55); }
.bp-hero__dots { position: absolute; bottom: 10px; left: 0; right: 0; display: flex; justify-content: center; gap: 5px; }
.bp-hdot { width: 6px; height: 6px; border-radius: 999px; border: none; padding: 0; background: rgba(246,242,235,.5); transition: all .3s; cursor: pointer; }
.bp-hdot.is-on { width: 18px; background: #F6F2EB; }
.bp-hero__thumbs { display: flex; gap: 7px; margin-top: 8px; overflow-x: auto; }
.bp-thumb { flex: 0 0 auto; width: 50px; height: 58px; border-radius: 11px; border: 2px solid transparent; padding: 0; overflow: hidden; background: repeating-linear-gradient(135deg,#EAE6DD 0 8px,#F2EFE9 8px 16px); cursor: pointer; position: relative; }
.bp-thumb span { position: absolute; bottom: 3px; left: 0; right: 0; font-family: monospace; font-size: 7px; color: #8A8275; }
.bp-thumb.is-on { border-color: var(--nav); }

/* head */
.bp-head { padding: 14px 16px 0; animation: bp-rise .55s cubic-bezier(.2,.8,.2,1) .06s both; }
.bp-head__rate { display: flex; align-items: center; gap: 7px; margin-bottom: 6px; font-size: 13px; }
.bp-head__rate .bp-stars { font-size: 12px; }
.bp-head__rate a { color: var(--muted); font-size: 12px; text-decoration: underline; text-underline-offset: 2px; }
.bp-head__rate .bp-chip-g { margin-left: auto; }
.bp-head__row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: nowrap; }
.bp-head__title { font-family: var(--disp); font-weight: 700; font-size: 20px; line-height: 1.2; letter-spacing: -.02em; flex: 1 1 auto; min-width: 0; }
.bp-head__price { text-align: right; flex: 0 0 auto; white-space: nowrap; }
.bp-price { font-family: var(--disp); font-weight: 700; font-size: 22px; line-height: 1.1; letter-spacing: -.02em; }
.bp-mrp { font-size: 12px; color: var(--faint); text-decoration: line-through; }
.bp-head__value { margin-top: 6px; font-size: 12px; color: var(--green); font-weight: 600; }

/* snapshot */
.bp-snap { padding: 16px 16px 0; display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; animation: bp-rise .55s cubic-bezier(.2,.8,.2,1) .14s both; }
.bp-snapcell { padding: 10px 11px; border-radius: 14px; box-shadow: 0 1px 0 rgba(255,255,255,.85) inset, 0 4px 10px -8px rgba(56,65,95,.22); display: flex; flex-direction: column; gap: 1px; min-width: 0; border: 1px solid transparent; }
.bp-snap--wide { grid-column: span 2; } .bp-snapcell:not(.bp-snap--wide) { grid-column: span 1; }
.bp-snapcell__k { font-size: 9px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
.bp-snapcell__v { font-family: var(--disp); font-weight: 600; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bp-snap--nav { background: linear-gradient(135deg,var(--nav),#2E3440); } .bp-snap--nav .bp-snapcell__k { color: var(--gold); } .bp-snap--nav .bp-snapcell__v { color: #fff; }
.bp-snap--sky { background: rgba(91,141,239,.09); border-color: rgba(91,141,239,.22); } .bp-snap--sky .bp-snapcell__k { color: var(--sky); } .bp-snap--sky .bp-snapcell__v { color: var(--ink2); }
.bp-snap--gold { background: rgba(240,161,27,.1); border-color: rgba(240,161,27,.25); } .bp-snap--gold .bp-snapcell__k { color: #D98E12; } .bp-snap--gold .bp-snapcell__v { color: var(--ink2); }
.bp-snap--mint { background: rgba(23,194,127,.11); border-color: rgba(23,194,127,.25); } .bp-snap--mint .bp-snapcell__k, .bp-snap--mint .bp-snapcell__v { color: var(--green2); }
.bp-snap--violet { background: rgba(139,92,246,.08); border-color: rgba(139,92,246,.2); } .bp-snap--violet .bp-snapcell__k { color: var(--violet); } .bp-snap--violet .bp-snapcell__v { color: var(--ink2); }
.bp-snap--coral { background: rgba(255,92,51,.07); border-color: rgba(255,92,51,.2); } .bp-snap--coral .bp-snapcell__k { color: var(--coral2); } .bp-snap--coral .bp-snapcell__v { color: var(--ink2); }
.bp-snap--rose { background: rgba(219,74,143,.07); border-color: rgba(219,74,143,.18); } .bp-snap--rose .bp-snapcell__k { color: var(--rose); } .bp-snap--rose .bp-snapcell__v { color: var(--ink2); }

/* live ticker */
.bp-live { padding: 12px 12px 0; display: flex; gap: 7px; overflow-x: auto; align-items: center; }
.bp-live__tag { flex: 0 0 auto; display: flex; align-items: center; gap: 5px; padding: 7px 11px; border-radius: 999px; background: rgba(255,92,51,.1); color: var(--coral); font-size: 11px; font-weight: 800; }
.bp-live__item { flex: 0 0 auto; padding: 7px 12px; border-radius: 999px; background: #F4F2ED; font-size: 11px; font-weight: 600; color: #3A4654; white-space: nowrap; }

/* size */
.bp-buy { margin: 0; }
.bp-size { padding: 16px 16px 0; animation: bp-rise .55s cubic-bezier(.2,.8,.2,1) .22s both; }
.bp-size__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.bp-size__label { font-weight: 700; font-size: 14px; } .bp-size__label em { color: var(--faint); font-weight: 500; font-size: 12px; font-style: normal; }
.bp-size__acts { display: flex; gap: 7px; }
.bp-size__row { display: flex; gap: 7px; }
.bp-sz { flex: 1; height: 48px; border-radius: 14px; border: 1.5px solid rgba(56,65,95,.14); background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgba(56,65,95,.05); font-family: var(--disp); font-weight: 600; font-size: 15px; cursor: pointer; transition: all .18s; }
.bp-sz:active { transform: scale(.95); }
.bp-sz.is-on { background: var(--ink2); color: #fff; border-color: var(--ink2); box-shadow: 0 6px 18px -6px rgba(35,39,47,.45), 0 0 0 3px rgba(35,39,47,.08); }
.bp-size__hint { font-size: 11px; color: var(--faint); margin-top: 7px; text-align: center; white-space: nowrap; }
.bp-size__hint b { color: var(--green); }

/* offers */
.bp-off { margin-top: 8px; }
.bp-off__head { display: flex; align-items: center; gap: 5px; margin-bottom: 6px; }
.bp-off__star { color: var(--coral2); font-size: 11px; }
.bp-off__title { font-family: var(--disp); font-weight: 700; font-size: 10.5px; letter-spacing: .06em; color: var(--nav); }
.bp-off__head .bp-pill { margin-left: auto; }
.bp-off__rail { display: flex; gap: 7px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 2px; }
.bp-offcard { flex: 0 0 62%; scroll-snap-align: start; border-radius: 10px; padding: 8px 10px; background: linear-gradient(150deg,#FFF1EB 0%,#FFE7DC 100%); border: 1px solid rgba(240,74,29,.16); box-shadow: 0 1px 0 rgba(255,255,255,.8) inset, 0 4px 12px -10px rgba(240,74,29,.3); }
.bp-offcard__top { display: flex; align-items: flex-start; gap: 6px; }
.bp-offcard__pct { font-family: var(--disp); font-weight: 700; font-size: 10.5px; color: #D2582F; line-height: 1.25; } .bp-offcard__pct span { color: #B08A45; }
.bp-offcard__lbl { font-size: 9px; color: #8B8578; margin-top: 3px; }
.bp-offcard__pay { display: flex; align-items: baseline; gap: 5px; margin-top: 0; }
.bp-offcard__pay span { font-family: var(--disp); font-weight: 700; font-size: 15px; color: var(--coral2); letter-spacing: -.01em; }
.bp-offcard__pay s { font-size: 10px; color: #B3AC9F; }
.bp-offcard__tag { flex: 0 0 auto; padding: 2px 6px; border-radius: 5px; background: rgba(240,74,29,.12); color: #D2582F; font-family: var(--disp); font-size: 8px; font-weight: 800; letter-spacing: .04em; }
.bp-offcard__tag--auto { background: var(--coral2); color: #fff; }
.bp-offcard__note { margin-top: 6px; padding-top: 6px; border-top: 1px dashed rgba(240,74,29,.22); font-size: 9px; color: #8B8578; }
.bp-off__dots { display: flex; justify-content: center; gap: 4px; margin-top: 6px; }
.bp-off__dots button { height: 6px; border-radius: 999px; border: none; padding: 0; background: #F3D9CE; transition: all .3s; cursor: pointer; width: 7px; }
.bp-off__dots button.is-on { width: 20px; background: var(--coral2); }

/* pincode */
.bp-pin { margin-top: 8px; animation: bp-rise .3s ease both; }
.bp-pin__row { display: flex; gap: 7px; }
.bp-pin__in { flex: 1; height: 40px; border-radius: 12px; border: 1px solid rgba(56,65,95,.14); background: #fff; padding: 0 13px; font-size: 13px; font-family: inherit; color: var(--ink); min-width: 0; }
.bp-pin__btn { flex: 0 0 auto; padding: 0 18px; height: 40px; border-radius: 12px; border: none; background: var(--nav); color: #F6F2EB; font-weight: 600; font-size: 12px; cursor: pointer; }
.bp-pin__ok { margin-top: 8px; font-size: 11px; color: var(--green); font-weight: 600; }

/* rewards */
.bp-rew { margin: 46px 16px 0; border-radius: 26px; padding: 20px 18px; background: linear-gradient(160deg,#FFFDF8 0%,#FFE5AE 100%); color: var(--ink2); border: 1px solid rgba(240,161,27,.22); box-shadow: 0 1px 0 rgba(255,255,255,.9) inset, 0 2px 6px rgba(56,65,95,.05), 0 22px 44px -26px rgba(146,116,60,.28); position: relative; overflow: hidden; }
.bp-rew__glow { position: absolute; top: -60px; right: -40px; width: 190px; height: 190px; border-radius: 50%; background: radial-gradient(circle,rgba(255,178,54,.45),transparent 70%); }
.bp-rew__head { display: flex; align-items: center; justify-content: space-between; position: relative; font-family: var(--disp); font-weight: 700; font-size: 16px; letter-spacing: -.01em; }
.bp-rew__head > span:first-child { white-space: nowrap; }
.bp-rew__timer { display: flex; align-items: center; gap: 5px; padding: 5px 10px; border-radius: 999px; background: rgba(255,92,51,.12); color: var(--coral2); font-size: 10px; font-weight: 700; font-family: var(--body); }
.bp-rew__grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 7px; margin-top: 14px; position: relative; }
.bp-gcell { display: flex; align-items: center; gap: 8px; padding: 10px 11px; border-radius: 13px; background: rgba(255,255,255,.75); border: 1px solid rgba(240,161,27,.18); box-shadow: 0 1px 0 rgba(255,255,255,.9) inset; }
.bp-gcell__i { font-size: 15px; flex: 0 0 auto; }
.bp-gcell__t { font-weight: 600; font-size: 11px; white-space: nowrap; color: var(--ink2); }
.bp-gcell__s { font-size: 9px; color: #A39C8D; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bp-rew__addons { margin-top: 14px; padding-top: 14px; border-top: 1px solid rgba(240,161,27,.18); position: relative; }
.bp-rew__addhead { display: flex; align-items: center; gap: 6px; margin-bottom: 9px; font-family: var(--disp); font-size: 12px; font-weight: 700; color: var(--ink2); }
.bp-rew__addrow { display: flex; gap: 7px; overflow-x: auto; }
.bp-addon { flex: 0 0 auto; display: flex; align-items: center; gap: 8px; padding: 8px 11px; border-radius: 12px; border: 1px solid rgba(240,161,27,.2); background: rgba(255,255,255,.8); cursor: pointer; text-align: left; transition: all .2s; }
.bp-addon__box { width: 18px; height: 18px; border-radius: 6px; border: 1.5px solid rgba(163,156,141,.5); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 800; color: #fff; flex: 0 0 auto; }
.bp-addon.is-on { border-color: rgba(23,194,127,.5); background: rgba(23,194,127,.12); }
.bp-addon.is-on .bp-addon__box { background: var(--green); border-color: var(--green); }
.bp-addon.is-on .bp-addon__box::after { content: '✓'; }
.bp-addon__n { font-weight: 600; font-size: 11px; color: var(--ink2); white-space: nowrap; }
.bp-addon__p { font-size: 9px; color: var(--coral2); white-space: nowrap; font-weight: 700; }

.bp-visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

/* price transparency */
.bp-pt__lead { font-size: 12px; font-weight: 700; color: var(--ink); margin-bottom: 11px; }
.bp-pt__bar { display: flex; height: 14px; border-radius: 999px; overflow: hidden; margin-bottom: 14px; }
.bp-pt__rows { display: flex; flex-direction: column; gap: 9px; }
.bp-pt__r { display: flex; align-items: center; gap: 9px; font-size: 13px; color: #3A352E; }
