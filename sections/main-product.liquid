.bp-rcard__id { flex: 1; min-width: 0; } .bp-rcard__nm { display: flex; align-items: center; gap: 5px; font-weight: 600; font-size: 12px; } .bp-rcard__nm em { font-size: 9px; color: var(--green); font-weight: 600; font-style: normal; }
.bp-rcard__meta { font-size: 10px; color: var(--faint); }
.bp-rcard__st { color: var(--gold2); font-size: 11px; flex: 0 0 auto; }
.bp-rcard__tx { font-size: 12px; line-height: 1.5; color: #3A352E; margin-bottom: 9px; }
.bp-rcard__ph { display: flex; gap: 6px; margin-bottom: 9px; } .bp-rcard__ph i { width: 48px; height: 48px; border-radius: 9px; background: repeating-linear-gradient(135deg,#EAE6DD 0 7px,#F2EFE9 7px 14px); }
.bp-rcard__ft { display: flex; align-items: center; gap: 10px; padding-top: 8px; border-top: 1px solid rgba(56,65,95,.06); }
.bp-rcard__fit { font-size: 10px; color: var(--green); font-weight: 600; }
.bp-rcard__help { margin-left: auto; padding: 5px 10px; border-radius: 999px; border: 1px solid rgba(56,65,95,.12); background: transparent; font-size: 10px; font-weight: 600; color: #3A4654; cursor: pointer; }
.bp-rcard__pct { padding: 3px 8px; border-radius: 999px; background: rgba(23,194,127,.12); color: var(--green); font-size: 9px; font-weight: 700; flex: 0 0 auto; }
.bp-match__note { border-radius: 13px; padding: 11px 12px; background: linear-gradient(150deg,var(--green),#6FB491); color: #F6F2EB; margin-bottom: 11px; font-size: 12px; line-height: 1.45; } .bp-match__note b { color: var(--gold); }
.bp-rempty { padding: 24px; text-align: center; color: var(--faint); font-size: 12px; border: 1px dashed rgba(56,65,95,.15); border-radius: 14px; margin-top: 9px; }

/* loved */
.bp-loved { border-radius: 26px; padding: 24px 16px 18px; background: linear-gradient(170deg,#E5D8FF 0%,#FDFCFA 75%); color: var(--ink2); position: relative; overflow: hidden; border: 1px solid rgba(140,130,175,.16); box-shadow: 0 1px 0 rgba(255,255,255,.9) inset, 0 20px 44px -28px rgba(110,100,150,.3); }
.bp-loved__glow { position: absolute; top: -60px; left: -40px; width: 200px; height: 200px; border-radius: 50%; background: radial-gradient(circle,rgba(139,92,246,.3),transparent 70%); }
.bp-loved__top { position: relative; text-align: center; }
.bp-loved__h { font-family: var(--disp); font-weight: 700; font-size: 27px; line-height: 1.08; margin: 8px 0 4px; letter-spacing: -.02em; }
.bp-loved__stars { color: var(--gold2); font-size: 15px; letter-spacing: .12em; }
.bp-loved__stats { position: relative; display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; margin: 16px 0 18px; }
.bp-stat { text-align: center; padding: 10px 4px; border-radius: 13px; background: rgba(255,255,255,.85); border: 1px solid rgba(140,130,175,.14); box-shadow: 0 1px 0 rgba(255,255,255,.95) inset, 0 4px 12px -8px rgba(110,100,150,.2); }
.bp-stat b { font-family: var(--disp); font-weight: 700; font-size: 18px; color: var(--ink2); line-height: 1; display: block; } .bp-stat span { font-size: 9px; color: #9C93AE; margin-top: 4px; line-height: 1.2; display: block; }
.bp-notes { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.bp-note { transform: rotate(var(--r)); background: #fff; color: var(--ink); border-radius: 14px; padding: 13px 13px 11px; border: 1px solid rgba(140,130,175,.12); box-shadow: 0 1px 0 rgba(255,255,255,.95) inset, 0 10px 22px -12px rgba(110,100,150,.28); animation: bp-float 6s ease-in-out infinite; position: relative; }
.bp-note__q { position: absolute; top: 9px; right: 11px; font-family: var(--disp); font-weight: 700; font-size: 22px; line-height: 1; opacity: .55; }
.bp-note p { font-size: 12.5px; line-height: 1.42; font-weight: 500; padding-right: 12px; margin-bottom: 9px; }
.bp-note__by { display: flex; align-items: center; gap: 6px; font-size: 10px; color: var(--muted); font-weight: 600; }
.bp-note__by span { width: 16px; height: 2px; border-radius: 2px; }
.bp-loved__cta { position: relative; display: block; text-align: center; margin-top: 16px; padding: 13px; border-radius: 14px; background: linear-gradient(165deg,#2E3440,#191D24); color: #fff; font-family: var(--disp); font-weight: 600; font-size: 13px; text-decoration: none; box-shadow: 0 1px 0 rgba(255,255,255,.14) inset, 0 12px 24px -10px rgba(25,29,36,.55); }

/* complete the look */
.bp-look__head { display: flex; align-items: baseline; justify-content: space-between; margin: 0 3px 12px; } .bp-look__head .bp-chip-g { flex: 0 0 auto; }
.bp-look__row { display: flex; gap: 9px; align-items: stretch; }
.bp-look__i { flex: 1; min-width: 0; }
.bp-look__img { position: relative; border-radius: 14px; overflow: hidden; aspect-ratio: 3/4; background: repeating-linear-gradient(135deg,#EAE6DD 0 10px,#F2EFE9 10px 20px); display: flex; align-items: center; justify-content: center; font-family: monospace; font-size: 8px; color: #8A8275; }
.bp-look__tag { position: absolute; top: 6px; left: 6px; padding: 3px 7px; border-radius: 999px; background: rgba(56,65,95,.86); color: #F6F2EB; font-size: 7px; font-weight: 700; letter-spacing: .03em; }
.bp-look__n { font-weight: 600; font-size: 11px; margin-top: 7px; line-height: 1.25; }
.bp-look__p { display: flex; align-items: baseline; gap: 5px; margin-top: 2px; } .bp-look__p span { font-family: var(--disp); font-weight: 700; font-size: 12px; } .bp-look__p s { font-size: 10px; color: var(--faint); }
.bp-look__foot { display: flex; align-items: center; gap: 12px; margin-top: 14px; padding-top: 14px; border-top: 1px solid rgba(56,65,95,.08); }
.bp-look__bl { font-size: 10px; color: var(--faint); } .bp-look__bp { display: flex; align-items: baseline; gap: 6px; } .bp-look__bp span { font-family: var(--disp); font-weight: 700; font-size: 21px; } .bp-look__bp s { font-size: 12px; color: var(--faint); }
.bp-look__cta { flex: 1; padding: 13px; border-radius: 14px; border: none; background: linear-gradient(165deg,#2E3440,#191D24); color: #fff; font-family: var(--disp); font-weight: 700; font-size: 14px; cursor: pointer; transition: transform .12s; box-shadow: 0 1px 0 rgba(255,255,255,.14) inset, 0 10px 22px -10px rgba(25,29,36,.6); }
.bp-look__cta:active { transform: scale(.97); }

/* gallery */
.bp-gal__head { display: flex; align-items: center; justify-content: space-between; margin: 0 3px 12px; } .bp-gal__head .bp-chip-n { flex: 0 0 auto; }
.bp-gal__grid { columns: 2; column-gap: 10px; }
.bp-gcard { break-inside: avoid; margin-bottom: 10px; position: relative; border-radius: 16px; overflow: hidden; background: repeating-linear-gradient(135deg,#EAE6DD 0 12px,#F2EFE9 12px 24px); }
.bp-gcard__img { display: flex; align-items: center; justify-content: center; font-family: monospace; font-size: 9px; color: #8A8275; }
.bp-gcard__bar { position: absolute; inset: auto 0 0 0; padding: 10px; background: linear-gradient(to top,rgba(31,29,26,.8),transparent); display: flex; align-items: center; justify-content: space-between; }
.bp-gcard__bar span { color: #F6F2EB; font-size: 11px; font-weight: 600; } .bp-gcard__bar b { padding: 3px 8px; border-radius: 999px; background: rgba(246,242,235,.92); color: var(--ink); font-size: 9px; font-weight: 700; white-space: nowrap; flex: 0 0 auto; }

/* lifestyle */
.bp-life__rail { display: flex; gap: 9px; padding: 0 16px 4px; overflow-x: auto; scroll-snap-type: x mandatory; margin-top: 11px; }
.bp-lcard { flex: 0 0 150px; scroll-snap-align: start; border-radius: 16px; overflow: hidden; aspect-ratio: 3/4; background: repeating-linear-gradient(135deg,#EAE6DD 0 14px,#F2EFE9 14px 28px); position: relative; box-shadow: 0 12px 28px -22px rgba(56,65,95,.5); }
.bp-lcard__cap { position: absolute; inset: auto 0 0 0; padding: 11px; background: linear-gradient(to top,rgba(31,29,26,.85),transparent); }
.bp-lcard__t { color: #F6F2EB; font-family: var(--disp); font-weight: 700; font-size: 14px; } .bp-lcard__s { color: rgba(246,242,235,.78); font-size: 10px; }

/* founder */
.bp-founder { border-radius: 24px; padding: 22px 18px; background: var(--card); border: 1px solid rgba(56,65,95,.08); }
.bp-founder__head { display: flex; align-items: center; gap: 12px; margin-bottom: 15px; }
.bp-founder__ph { width: 52px; height: 52px; border-radius: 50%; background: repeating-linear-gradient(135deg,#EAE6DD 0 6px,#F2EFE9 6px 12px); flex: 0 0 auto; display: flex; align-items: center; justify-content: center; font-family: monospace; font-size: 7px; color: #8A8275; }
.bp-founder__t { font-family: var(--disp); font-weight: 700; font-size: 15px; line-height: 1.2; } .bp-founder__by { font-size: 12px; color: #9AA0AC; margin-top: 2px; }
.bp-founder__q { font-size: 14px; line-height: 1.6; color: #3A352E; margin-bottom: 12px; }
.bp-founder__sig { font-family: var(--disp); font-style: italic; font-size: 17px; color: var(--nav); }

/* faq */
.bp-faq__i { border-radius: 15px; background: var(--card); border: 1px solid rgba(56,65,95,.08); overflow: hidden; }
.bp-faq__b { width: 100%; display: flex; align-items: center; gap: 12px; padding: 15px 16px; background: transparent; border: none; cursor: pointer; text-align: left; }
.bp-faq__b span { flex: 1; font-weight: 600; font-size: 13.5px; color: var(--ink); }
.bp-faq__b em { width: 24px; height: 24px; border-radius: 50%; background: #fff; border: 1px solid rgba(56,65,95,.12); display: flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 600; color: var(--nav); flex: 0 0 auto; font-style: normal; }
.bp-faq__p { padding: 0 16px 15px; font-size: 13px; line-height: 1.55; color: var(--muted); animation: bp-rise .25s ease both; }

/* footer */
.bp-footer { text-align: center; padding: 34px 16px 20px; }
.bp-footer__logo { font-family: var(--disp); font-weight: 700; letter-spacing: .2em; font-size: 14px; color: var(--nav); }
.bp-footer__tag { font-size: 11px; color: var(--faint); margin-top: 4px; }

/* sticky bar */
.bp-sticky { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%; max-width: 430px; z-index: 60; padding: 0 8px 8px; }
