.bp-care { padding: 14px 15px 16px; display: grid; grid-template-columns: repeat(2,1fr); gap: 7px; }
.bp-care__i { display: flex; align-items: center; gap: 9px; padding: 9px 11px; border-radius: 12px; background: var(--card); border: 1px solid rgba(56,65,95,.08); }
.bp-care__i span { font-size: 16px; } .bp-care__t { font-weight: 600; font-size: 11px; color: var(--ink2); } .bp-care__s { font-size: 9px; color: #A39C8D; }

/* wash test */
.bp-wash__row { display: flex; gap: 9px; }
.bp-wcard { flex: 1; border-radius: 18px; padding: 13px 11px; background: var(--card); border: 1px solid rgba(56,65,95,.09); }
.bp-wcard__img { border-radius: 11px; aspect-ratio: 1/1; background: repeating-linear-gradient(135deg,#EAE6DD 0 8px,#F2EFE9 8px 16px); margin-bottom: 10px; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 7px; }
.bp-wcard__img span { font-family: var(--disp); font-weight: 700; font-size: 11px; color: var(--nav); background: rgba(255,255,255,.75); padding: 2px 7px; border-radius: 999px; }
