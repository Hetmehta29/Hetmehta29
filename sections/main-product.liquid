.bp-diff__t { font-family: var(--disp); font-weight: 700; font-size: 14px; }
.bp-diff__s { font-size: 12px; color: var(--muted); line-height: 1.4; margin-top: 1px; }
.bp-diff__r > div { flex: 1; min-width: 0; }
.bp-diff__c { color: var(--green); font-size: 16px; flex: 0 0 auto; }

/* fabric */
.bp-fab { border-radius: 24px; overflow: hidden; background: #fff; color: var(--ink2); border: 1px solid rgba(56,65,95,.09); box-shadow: 0 1px 0 rgba(255,255,255,.9) inset, 0 18px 40px -28px rgba(56,65,95,.3); padding: 0; }
.bp-fab__hero { position: relative; aspect-ratio: 16/8; background: repeating-linear-gradient(115deg,#2A2722 0 16px,#312D27 16px 32px); }
.bp-fab__title { position: absolute; bottom: 11px; left: 11px; font-family: var(--disp); font-weight: 700; font-size: 15px; color: #F6F2EB; }
.bp-fab__cotton { position: absolute; bottom: 11px; right: 11px; padding: 4px 9px; border-radius: 999px; background: rgba(255,206,84,.9); color: var(--ink); font-size: 10px; font-weight: 700; }
.bp-tabs { display: flex; gap: 6px; padding: 12px 15px 0; }
.bp-tab { flex: 1; padding: 8px 4px; border-radius: 10px; border: none; background: #F1EEE8; color: var(--muted); font-size: 12px; font-weight: 600; cursor: pointer; transition: all .2s; }
.bp-tab.is-on { background: var(--nav); color: #F6F2EB; }
.bp-tabs--dark .bp-tab { background: #F1EEE8; color: #8B8578; }
.bp-tabs--dark .bp-tab.is-on { background: var(--ink2); color: #fff; }
.bp-dna { padding: 14px 15px 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 14px; }
.bp-dna__l { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
.bp-dna__l span { font-size: 11px; font-weight: 600; color: #3A352E; } .bp-dna__l b { font-size: 10px; color: var(--goldd); font-weight: 700; }
.bp-dna__t { height: 6px; border-radius: 999px; background: #F1EEE8; overflow: hidden; }
.bp-dna__t i { display: block; height: 100%; background: linear-gradient(90deg,var(--gold2),var(--gold)); border-radius: 999px; }
.bp-chips { padding: 14px 15px 16px; display: flex; gap: 7px; flex-wrap: wrap; }
.bp-chip { display: flex; align-items: center; gap: 5px; padding: 8px 12px; border-radius: 999px; background: var(--card); border: 1px solid rgba(56,65,95,.08); font-size: 11px; font-weight: 600; color: #3A352E; }
