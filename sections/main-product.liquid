<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Fragment+Mono:ital@0;1&family=Hanken+Grotesk:wght@300;400;500;600;700&display=swap">

{%- comment -%} Bluprint blocks — base styles + editor customisation {%- endcomment -%}
{%- style -%}
  {{ section.settings.bp_heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.bp_body_font | font_face: font_display: 'swap' }}
  {%- if section.settings.bbx_use_mono == false and section.settings.bbx_font != blank -%}{{ section.settings.bbx_font | font_face: font_display: 'swap' }}{%- endif -%}

  {%- comment -%}
    Bluprint · editorial palettes. Three presets, matching the approved artboards:
      colour  — white page, blue/green/violet accents  (Bluprint PDP · Navy Colour)
      navy    — navy monochrome                        (Bluprint PDP · Navy)
      gallery — warm neutral monochrome                (Bluprint PDP · Gallery)
    Every token below can still be overridden one at a time in Theme settings.
  {%- endcomment -%}
  {%- assign _pal = section.settings.bp_palette | default: 'colour' -%}
  {%- case _pal -%}
    {%- when 'navy' -%}
      {%- assign _pg = '#FFFFFF' -%}{%- assign _card = '#FBFCFD' -%}{%- assign _tint = '#EAEEF4' -%}
      {%- assign _ink = '#0D1B33' -%}{%- assign _ink2 = '#2B3A55' -%}{%- assign _mut = '#5F6C85' -%}
      {%- assign _line = '#D9E0EB' -%}{%- assign _line2 = '#EDF1F6' -%}
      {%- assign _acc = '#0D1B33' -%}{%- assign _accInk = '#FFFFFF' -%}
      {%- assign _acc2 = '#0D1B33' -%}{%- assign _acc3 = '#0D1B33' -%}{%- assign _accOn = '#9FB3D1' -%}
      {%- assign _tintB = '#EAEEF4' -%}{%- assign _tintC = '#EAEEF4' -%}
      {%- assign _star = '#5F6C85' -%}{%- assign _starBar = '#8A9AB5' -%}
      {%- assign _ph1 = '#E7ECF3' -%}{%- assign _ph2 = '#F2F5F9' -%}
      {%- assign _onDark = '#A9B6CB' -%}
      {%- assign _dw = '600' -%}{%- assign _dls = '-0.03em' -%}{%- assign _t1 = '42' -%}{%- assign _t1lh = '1.0' -%}
    {%- when 'gallery' -%}
      {%- assign _pg = '#FFFFFF' -%}{%- assign _card = '#FFFFFF' -%}{%- assign _tint = '#F4F3F0' -%}
      {%- assign _ink = '#0B0B0B' -%}{%- assign _ink2 = '#2C2A27' -%}{%- assign _mut = '#6E6C67' -%}
      {%- assign _line = '#E4E2DD' -%}{%- assign _line2 = '#F0EFEC' -%}
      {%- assign _acc = '#0B0B0B' -%}{%- assign _accInk = '#FFFFFF' -%}
      {%- assign _acc2 = '#0B0B0B' -%}{%- assign _acc3 = '#0B0B0B' -%}{%- assign _accOn = '#B9B2A6' -%}
      {%- assign _tintB = '#F4F3F0' -%}{%- assign _tintC = '#F4F3F0' -%}
      {%- assign _star = '#6E6C67' -%}{%- assign _starBar = '#9A968D' -%}
      {%- assign _ph1 = '#F1F0EC' -%}{%- assign _ph2 = '#F8F7F4' -%}
      {%- assign _onDark = '#B9B2A6' -%}
      {%- assign _dw = '700' -%}{%- assign _dls = '-0.035em' -%}{%- assign _t1 = '44' -%}{%- assign _t1lh = '0.98' -%}
    {%- else -%}
      {%- assign _pg = '#FFFFFF' -%}{%- assign _card = '#FFFFFF' -%}{%- assign _tint = '#F1F3F6' -%}
      {%- assign _ink = '#171B22' -%}{%- assign _ink2 = '#2E3440' -%}{%- assign _mut = '#636A78' -%}
      {%- assign _line = '#E1E4E9' -%}{%- assign _line2 = '#F0F2F5' -%}
      {%- assign _acc = '#1F4FE0' -%}{%- assign _accInk = '#FFFFFF' -%}
      {%- assign _acc2 = '#0A7C56' -%}{%- assign _acc3 = '#6B4BE8' -%}{%- assign _accOn = '#8FA9F2' -%}
      {%- assign _tintB = '#E9F6F1' -%}{%- assign _tintC = '#F1EDFD' -%}
      {%- assign _star = '#A8730A' -%}{%- assign _starBar = '#E39A22' -%}
      {%- assign _ph1 = '#EDEFF2' -%}{%- assign _ph2 = '#F7F8FA' -%}
      {%- assign _onDark = '#B9B2A6' -%}
      {%- assign _dw = '600' -%}{%- assign _dls = '-0.03em' -%}{%- assign _t1 = '42' -%}{%- assign _t1lh = '1.0' -%}
  {%- endcase -%}

  #shopify-section-{{ section.id }} .bp-blk {
    --pg: {{ section.settings.bp_color_page | default: _pg }};
    --card: {{ section.settings.bp_color_card | default: _card }};
    --tint: {{ section.settings.bp_color_tint | default: _tint }};
    --ink: {{ section.settings.bp_color_ink | default: _ink }};
    --ink2: {{ section.settings.bp_color_ink2 | default: _ink2 }};
    --mut: {{ section.settings.bp_color_muted | default: _mut }};
    --line: {{ section.settings.bp_color_line | default: _line }};
    --line2: {{ _line2 }};
    --acc: {{ section.settings.bp_color_accent | default: _acc }};
    --accInk: {{ _accInk }};
    --acc2: {{ section.settings.bp_color_accent2 | default: _acc2 }};
    --acc3: {{ section.settings.bp_color_accent3 | default: _acc3 }};
    --accOn: {{ _accOn }};
    --tintB: {{ _tintB }};
    --tintC: {{ _tintC }};
    --star: {{ _star }};
    --starBar: {{ _starBar }};
    --ph1: {{ _ph1 }};
    --ph2: {{ _ph2 }};
    --onDark: {{ _onDark }};
    --disp: {{ section.settings.bp_heading_font.family }}, {{ section.settings.bp_heading_font.fallback_families }};
    {%- comment -%} Hanken Grotesk is not in Shopify's font library, so it comes from the
        Google Fonts link at the top of this section rather than a font picker. {%- endcomment -%}
    --body: {% if section.settings.bp_use_hanken != false %}'Hanken Grotesk', {% endif %}{{ section.settings.bp_body_font.family }}, {{ section.settings.bp_body_font.fallback_families }};
    --mono: 'Fragment Mono', ui-monospace, monospace;
    --dw: {{ _dw }};
    --dls: {{ _dls }};
    --t1: min({{ section.settings.bp_title_size | default: _t1 }}px, 9vw);
    --t1lh: {{ _t1lh }};
    --rad: 0px;
    --gut: {{ section.settings.bp_gutter | default: 10 }}px;
    font-size: {{ section.settings.bp_body_size }}px;
  }
  {%- comment -%}
    One content scale for the whole page. The old page shrank each block on its own
    (zoom 40-85%), so blocks drifted out of proportion with each other. The sticky
    bar is excluded because it is position:fixed and zoom would shift it.
  {%- endcomment -%}
  {%- assign _sc = section.settings.bp_scale | default: 85 -%}
  {%- if _sc != 100 -%}
  #shopify-section-{{ section.id }} .bp-blk:not(.bp-blk--sticky-bar) { zoom: {{ _sc | divided_by: 100.0 }}; }
  {%- endif -%}
  #shopify-section-{{ section.id }} .bp-blk .bp-mod,
  #shopify-section-{{ section.id }} .bp-blk .bp-rew { margin: 0; }
  #shopify-section-{{ section.id }} .bp-blk .bp-life__rail,
  #shopify-section-{{ section.id }} .bp-blk .bp-pairs__rail { padding-left: 0; padding-right: 0; }
  #shopify-section-{{ section.id }} .bp-blk .bp-h2 { font-size: var(--bp-h2s, min({{ section.settings.bp_heading_size }}px, 6.5vw)); font-weight: var(--bp-h2w, var(--dw)); }
  #shopify-section-{{ section.id }} .bp-blk .bp-h2--tight { font-size: {{ section.settings.bp_heading_size | minus: 2 }}px; }

  {%- comment -%}
    Full-bleed panels. Off by default: the breakout assumes the container's side
    padding is exactly the gutter, and when it is not the panel hangs outside its
    block. Turn it on only if the tint panels should reach the screen edge.
  {%- endcomment -%}
  {%- if section.settings.bp_bleed_panels -%}
  {%- assign _g = section.settings.bp_gutter | default: 10 -%}
  #shopify-section-{{ section.id }} .product-info__block-item:has(.bp-panel),
  #shopify-section-{{ section.id }} .product-info__block-item:has(.bp-promise),
  #shopify-section-{{ section.id }} .product-info__block-item:has(.bp-loved),
  #shopify-section-{{ section.id }} .product-info__block-item:has(.bp-founder),
  #shopify-section-{{ section.id }} .product-info__block-item:has(.bp-top),
  #shopify-section-{{ section.id }} .product-info__block-item:has(.bp-ticker) {
    margin-left: -{{ _g }}px !important; margin-right: -{{ _g }}px !important;
  }
  {%- endif -%}
{%- endstyle -%}
<style>
/* ============================================================
   bluprint.css — Bluprint product page · EDITORIAL build
   Flat, hairline, mono-label system. Mobile-first, ~430px column.
   Tokens are set by the section style block; the values below are
   fallbacks so the sheet still reads correctly on its own.
   ============================================================ */
.bp-blk, .bp-blk * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
.bp-blk {
  --pg:#FFFFFF; --card:#FFFFFF; --tint:#F1F3F6;
  --ink:#171B22; --ink2:#2E3440; --mut:#636A78;
  --line:#E1E4E9; --line2:#F0F2F5;
  --acc:#1F4FE0; --accInk:#FFFFFF; --acc2:#0A7C56; --acc3:#6B4BE8;
  --accOn:#8FA9F2;                      /* accent legible on the dark panel */
  --tintB:#E9F6F1; --tintC:#F1EDFD;
  --star:#A8730A; --starBar:#E39A22;
  --ph1:#EDEFF2; --ph2:#F7F8FA;
  --onDark:#B9B2A6;                     /* muted text on the ink panel */
  --disp:'Bricolage Grotesque',system-ui,sans-serif;
  --body:'Hanken Grotesk',system-ui,sans-serif;
  --mono:'Fragment Mono',ui-monospace,monospace;
  --dw:600; --dls:-0.03em; --t1:42px; --t1lh:1.0; --rad:0px;
  --gut:10px;                           /* section side padding */
  font-family: var(--body); color: var(--ink); }

/* legacy token aliases — older markup still references these */
.bp-blk { --nav:var(--ink); --muted:var(--mut); --faint:var(--mut);
  --green:var(--acc2); --green2:var(--acc2); --gold:var(--starBar); --gold2:var(--star);
  --goldd:var(--star); --coral:var(--acc); --coral2:var(--acc); --violet:var(--acc3);
  --sky:var(--acc); --rose:var(--acc3); }

.bp-blk .bp-scroll { scrollbar-width: none; }
.bp-blk .bp-scroll::-webkit-scrollbar { display: none; }
.bp-blk h1, .bp-blk h2, .bp-blk p { margin: 0; }
.bp__wrap { position: relative; width: 100%; max-width: 430px; background: var(--pg);
  min-height: 100vh; overflow-x: hidden; padding-bottom: 130px; }
.bp__glow { display: none; }
.bp-visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

/* ---------- rhythm ----------------------------------------- */
/* A plain module. The theme container supplies the side gutter. */
.bp-mod { margin: 30px 0 0; position: relative; }
/* A tinted / inverted panel runs edge to edge; the section CSS breaks it
   out of the container gutter, so it carries its own side padding. */
.bp-panel { margin: 30px 0 0; padding: 26px var(--gut); background: var(--tint); }
.bp-panel--b { background: var(--tintB); }
.bp-panel--c { background: var(--tintC); }
.bp-panel--ink { background: var(--ink); color: var(--pg); }

/* ---------- type ------------------------------------------- */
.bp-eyebrow { display: block; font-family: var(--mono); font-weight: 400; font-size: 10px;
  line-height: 1; letter-spacing: .2em; color: var(--mut); margin-bottom: 12px;
  padding: 0; border: none; background: none; border-radius: 0; text-transform: uppercase; }
.bp-eyebrow--coral { color: var(--acc); }
.bp-eyebrow--mint  { color: var(--acc2); }
.bp-eyebrow--violet{ color: var(--acc3); }
.bp-panel--ink .bp-eyebrow { color: var(--accOn); }
.bp-h2 { font-family: var(--disp); font-weight: var(--dw); font-size: 26px; line-height: 1.16;
  letter-spacing: var(--dls); color: var(--ink); }
.bp-h2--tight { font-size: 24px; }
.bp-panel--ink .bp-h2 { color: var(--pg); }
.bp-sub { font-size: 13px; line-height: 1.5; color: var(--ink2); margin-top: 8px; }
.bp-panel--ink .bp-sub { color: var(--onDark); }
.bp-stars { color: var(--star); letter-spacing: .12em; }

/* label / value primitives used across blocks */
.bp-lbl { font-family: var(--mono); font-size: 10px; line-height: 1; letter-spacing: .16em; color: var(--mut); }
.bp-num { font-family: var(--mono); font-size: 12px; line-height: 1; color: var(--acc); }

/* ---------- primitives -------------------------------------- */
.bp-ph { background: repeating-linear-gradient(135deg,var(--ph1) 0 16px,var(--ph2) 16px 32px);
  display: flex; align-items: flex-end; justify-content: space-between; gap: 6px; padding: 14px;
  font-family: var(--mono); font-size: 10px; letter-spacing: .14em; color: var(--mut); }
.bp-ph b { font-family: var(--mono); font-weight: 400; font-size: 10px; letter-spacing: .14em; }

/* square outline chip */
.bp-chip, .bp-chip-n { display: inline-flex; align-items: center; gap: 6px; padding: 6px 11px;
  border: 1px solid var(--line); border-radius: 0; background: transparent;
  font-size: 11.5px; font-weight: 400; color: var(--ink2); }
.bp-chip__d { display: none; }
.bp-chip-g { display: inline-flex; align-items: center; padding: 5px 9px; border-radius: 0;
  border: 1px solid var(--acc2); background: transparent; color: var(--acc2);
  font-family: var(--mono); font-size: 9px; letter-spacing: .14em; }
/* mono tag — the small bordered caps label */
.bp-tag-mint { display: inline-flex; padding: 5px 9px; border-radius: 0; border: 1px solid var(--acc2);
  background: transparent; color: var(--acc2); font-family: var(--mono); font-size: 9px; letter-spacing: .14em; }
.bp-pill { display: inline-flex; align-items: center; gap: 6px; padding: 6px 11px; border-radius: 0;
  border: 1px solid var(--line); background: var(--pg); font-family: var(--mono); font-size: 10px;
  letter-spacing: .12em; color: var(--ink2); cursor: pointer; white-space: nowrap; }
.bp-pill--dark { border-color: var(--ink); background: var(--ink); color: var(--pg); }
.bp-linkbtn { background: none; border: none; padding: 0; color: var(--acc); font-size: 12.5px;
  border-bottom: 1px solid var(--acc); cursor: pointer; font-family: inherit; }

/* hairline grid — 1px gaps over a line-coloured bed */
.bp-hgrid { display: grid; gap: 1px; background: var(--line); }
.bp-hgrid > * { background: var(--card); }
.bp-panel .bp-hgrid > * { background: var(--pg); }

/* meter */
.bp-meter { height: 3px; background: var(--line); }
.bp-meter > i { display: block; height: 100%; background: var(--acc2); }

.bp-card { border-radius: 0; padding: 16px; background: var(--card); border: 1px solid var(--line); }
.bp-card--pad0 { padding: 0; overflow: hidden; border-radius: 0; }
.bp-dot { width: 6px; height: 6px; border-radius: 50%; display: inline-block; flex: 0 0 auto; }
.bp-dot--g { background: var(--acc2); }
.bp-dot--r { background: var(--acc); }
.bp-ai { display: none; }
.bp-dotb { width: 8px; height: 8px; border-radius: 0; flex: 0 0 auto; }

/* the flat CTA — used by every primary button on the page */
.bp-cta { display: flex; align-items: center; justify-content: center; height: 56px; width: 100%;
  border: none; border-radius: 0; background: var(--ink); color: var(--pg); cursor: pointer;
  font-family: var(--body); font-size: 13.5px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; }
.bp-cta--ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
.bp-cta--acc { background: var(--acc); color: var(--accInk); }

/* ---------- top bar ----------------------------------------- */
.bp-top { display: flex; align-items: center; justify-content: space-between; gap: 10px;
  padding: 14px var(--gut); background: var(--pg); border-bottom: 1px solid var(--line); }
.bp-top__logo { display: none; }
.bp-top__name { font-family: var(--disp); font-weight: var(--dw); font-size: 15px; line-height: 1;
  letter-spacing: .3em; color: var(--ink); }
.bp-top__live { margin-left: auto; font-family: var(--mono); font-size: 10px; line-height: 1;
  letter-spacing: .16em; color: var(--mut); background: none; padding: 0; border-radius: 0; }

/* ---------- ticker ------------------------------------------ */
.bp-ticker { overflow: hidden; background: var(--ink); padding: 11px 0; }
.bp-ticker__track { display: flex; align-items: center; gap: 14px; width: max-content;
  white-space: nowrap; animation: bp-marquee 22s linear infinite; }
.bp-ticker__row { display: flex; align-items: center; gap: 14px; white-space: nowrap;
  font-family: var(--mono); font-size: 10px; letter-spacing: .16em; color: var(--pg); }
.bp-ticker__row i { font-style: normal; color: var(--accOn); }

/* ---------- hero -------------------------------------------- */
.bp-hero { position: relative; margin: 0; }
.bp-hero__frame { position: relative; overflow: hidden; height: 560px; border-radius: 0;
  background: repeating-linear-gradient(135deg,var(--ph1) 0 16px,var(--ph2) 16px 32px); }
.bp-hero__track { display: flex; height: 100%; transition: transform .4s cubic-bezier(.2,.8,.2,1); }
.bp-hero__slide { flex: 0 0 100%; height: 100%; }
.bp-hero__img { width: 100%; height: 100%; object-fit: cover; display: block; }
.bp-ph.bp-hero__img { display: flex; }
.bp-hero__badges { position: absolute; top: 16px; left: 16px; display: flex; flex-direction: column;
  gap: 6px; align-items: flex-start; }
.bp-badge { padding: 5px 9px; border-radius: 0; font-family: var(--mono); font-size: 9px;
  letter-spacing: .12em; background: var(--pg); color: var(--ink); border: 1px solid var(--line); }
.bp-badge--save { background: var(--acc); color: var(--accInk); border-color: var(--acc); }
.bp-badge--trend { background: var(--ink); color: var(--pg); border-color: var(--ink); }
.bp-badge--stock { position: absolute; top: 16px; right: 16px; background: var(--pg);
  color: var(--star); border: 1px solid var(--star); }
/* progress lines, not dots */
.bp-hero__dots { display: flex; gap: 6px; padding: 8px var(--gut) 0; }
.bp-hdot { flex: 1; height: 2px; border: none; padding: 0; border-radius: 0; background: var(--line); cursor: pointer; }
.bp-hdot.is-on { background: var(--ink); }
.bp-hero__thumbs { display: flex; gap: 8px; padding: 12px var(--gut) 0; overflow-x: auto; }
.bp-thumb { flex: 1 1 0; min-width: 0; height: 60px; border: none; border-radius: 0; padding: 0;
  overflow: hidden; position: relative; cursor: pointer;
  background: repeating-linear-gradient(135deg,var(--ph1) 0 10px,var(--ph2) 10px 20px); }
.bp-thumb.is-on { outline: 1px solid var(--ink); outline-offset: -1px; }
.bp-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.bp-thumb span { position: absolute; bottom: 4px; left: 0; right: 0; font-family: var(--mono);
  font-size: 7px; letter-spacing: .1em; color: var(--mut); }

/* ---------- product header ---------------------------------- */
.bp-head { display: flex; flex-direction: column; gap: 10px; padding: 26px 0 0; }
.bp-head__eyerow { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; }
.bp-head__series { font-family: var(--mono); font-size: 10px; line-height: 1; letter-spacing: .2em; color: var(--acc); }
.bp-head__sku { font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em; color: var(--mut); }
.bp-head__title { font-family: var(--disp); font-weight: var(--dw); font-size: var(--t1);
  line-height: var(--t1lh); letter-spacing: var(--dls); color: var(--ink); }
.bp-head__rate { display: flex; align-items: center; gap: 9px; font-size: 13px; line-height: 1; color: var(--mut); }
.bp-head__rate b { font-weight: 400; color: var(--ink2); }
.bp-head__rate i { font-style: normal; color: var(--line); }
.bp-head__rate a { color: var(--mut); font-size: 13px; text-decoration: none; border-bottom: 1px solid var(--line); }
.bp-head__row { display: flex; align-items: baseline; gap: 11px; padding-top: 2px; }
.bp-head__price { text-align: left; }
.bp-price { font-family: var(--disp); font-weight: var(--dw); font-size: 27px; line-height: 1; color: var(--ink); }
.bp-mrp { font-size: 14px; line-height: 1; color: var(--mut); text-decoration: line-through; }
.bp-head__save { font-family: var(--mono); font-size: 10px; line-height: 1; letter-spacing: .12em; color: var(--acc); }
.bp-head__tax { font-size: 12px; line-height: 1.4; color: var(--mut); }
.bp-head__tax a { border-bottom: 1px solid var(--line); }
.bp-head__badges { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 4px; }
.bp-head__badges span { font-family: var(--mono); font-size: 9px; letter-spacing: .12em; padding: 5px 9px;
  border: 1px solid var(--line); color: var(--mut); }
.bp-head__badges .is-acc  { border-color: var(--acc);  color: var(--acc); }
.bp-head__badges .is-acc3 { border-color: var(--acc3); color: var(--acc3); }
.bp-head__badges .is-star { border-color: var(--star); color: var(--star); }
.bp-head__emi { font-size: 12.5px; line-height: 1.4; color: var(--ink2); }
.bp-head__emi b { font-weight: 600; }
.bp-head__value { font-size: 12.5px; color: var(--acc2); }
.bp-head__timer { display: flex; align-items: center; justify-content: space-between; gap: 12px;
  width: 100%; padding: 10px 14px; background: var(--tint); border-left: 2px solid var(--starBar); }
.bp-head__timer span { font-size: 12.5px; color: var(--ink2); }
.bp-head__timer b { font-family: var(--mono); font-weight: 400; font-size: 12px; letter-spacing: .1em; color: var(--ink); }

/* ---------- snapshot ---------------------------------------- */
.bp-snap { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line);
  padding: 0; margin-top: 12px; }
.bp-snapcell { background: var(--card); padding: 13px 14px; display: flex; flex-direction: column;
  gap: 5px; min-width: 0; border: none; border-radius: 0; box-shadow: none; }
.bp-snap--wide { grid-column: span 2; }
.bp-snapcell__k { font-family: var(--mono); font-size: 9px; letter-spacing: .14em; color: var(--mut); text-transform: uppercase; }
.bp-snapcell__v { font-family: var(--body); font-weight: 400; font-size: 14px; line-height: 1.2; color: var(--ink);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* the old per-cell colour variants collapse to one flat cell */
.bp-snap--nav, .bp-snap--sky, .bp-snap--gold, .bp-snap--mint,
.bp-snap--violet, .bp-snap--coral, .bp-snap--rose { background: var(--card); border: none; }
.bp-snap--nav .bp-snapcell__k, .bp-snap--sky .bp-snapcell__k, .bp-snap--gold .bp-snapcell__k,
.bp-snap--mint .bp-snapcell__k, .bp-snap--violet .bp-snapcell__k, .bp-snap--coral .bp-snapcell__k,
.bp-snap--rose .bp-snapcell__k { color: var(--mut); }
.bp-snap--nav .bp-snapcell__v, .bp-snap--sky .bp-snapcell__v, .bp-snap--gold .bp-snapcell__v,
.bp-snap--mint .bp-snapcell__v, .bp-snap--violet .bp-snapcell__v, .bp-snap--coral .bp-snapcell__v,
.bp-snap--rose .bp-snapcell__v { color: var(--ink); }

/* ---------- live feed --------------------------------------- */
.bp-live { display: flex; align-items: center; justify-content: space-between; gap: 12px;
  margin-top: 16px; padding: 12px 14px; border: 1px solid var(--line); background: var(--tint); overflow: hidden; }
.bp-live__l { display: flex; align-items: center; gap: 9px; min-width: 0; }
.bp-live__tag { flex: 0 0 auto; width: 6px; height: 6px; border-radius: 50%; background: var(--acc2);
  padding: 0; font-size: 0; color: transparent; }
.bp-live__item { font-size: 12.5px; line-height: 1.3; color: var(--ink2); background: none;
  padding: 0; border-radius: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bp-live__meta { font-family: var(--mono); font-size: 10px; letter-spacing: .1em; color: var(--mut); white-space: nowrap; }

/* ---------- size / variant picker ---------------------------- */
.bp-size { padding: 24px 0 0; display: flex; flex-direction: column; gap: 16px; }
.bp-size__grp { display: flex; flex-direction: column; gap: 11px; }
.bp-size__head { display: flex; align-items: center; justify-content: space-between; margin: 0; }
.bp-size__label { font-family: var(--mono); font-size: 10px; line-height: 1; letter-spacing: .16em;
  color: var(--mut); text-transform: uppercase; }
.bp-size__label em { font-style: normal; color: var(--ink); }
.bp-size__acts { display: flex; gap: 12px; }
.bp-size__acts .bp-linkbtn { font-family: var(--mono); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; }
/* colour swatches */
.bp-swatches { display: flex; gap: 12px; flex-wrap: wrap; }
.bp-swatch { width: 32px; height: 32px; border-radius: 50%; border: none; padding: 0; cursor: pointer;
  box-shadow: 0 0 0 1px var(--line); background-size: cover; background-position: center; }
.bp-swatch.is-on { box-shadow: 0 0 0 1px var(--line), 0 0 0 4px var(--pg), 0 0 0 5px var(--ink); }
/* size grid */
.bp-size__row { display: grid; grid-template-columns: repeat(5,1fr); gap: 8px; }
.bp-sz { height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 0;
  border: 1px solid var(--line); background: var(--card); color: var(--ink2);
  font-family: var(--body); font-weight: 400; font-size: 14px; cursor: pointer; transition: none; }
.bp-sz.is-on { background: var(--ink); color: var(--pg); border-color: var(--ink); font-weight: 500; box-shadow: none; }
.bp-sz[disabled], .bp-sz.is-out { border-color: var(--line2); color: var(--mut); text-decoration: line-through;
  background: transparent; cursor: not-allowed; }
.bp-sz:active { transform: none; }
.bp-size__hint { font-size: 12px; color: var(--mut); margin: 0; text-align: left; white-space: normal; }
.bp-size__hint b { color: var(--ink2); font-weight: 400; }
/* find my fit — outline row */
.bp-openfit { display: flex; align-items: center; justify-content: center; gap: 8px; height: 44px;
  width: 100%; border: 1px solid var(--ink); border-radius: 0; background: transparent; color: var(--ink);
  font-family: var(--body); font-size: 13px; letter-spacing: .06em; cursor: pointer; }
.bp-openfit i { font-style: normal; font-family: var(--mono); font-size: 11px; color: var(--acc); }

/* ---------- pre-order notice --------------------------------- */
.bp-preo { display: flex; align-items: center; gap: 10px; padding: 11px 14px;
  border-left: 2px solid var(--acc); border-radius: 0; background: var(--tint); }
.bp-preo__i { font-family: var(--mono); font-size: 9px; letter-spacing: .14em; color: var(--acc); flex: 0 0 auto; }
.bp-preo__t { font-size: 12.5px; line-height: 1.35; color: var(--ink2); }
.bp-preo__s { font-size: 12.5px; line-height: 1.35; color: var(--ink2); }

/* ---------- offers ------------------------------------------- */
.bp-off { margin-top: 22px; display: flex; flex-direction: column; gap: 10px; }
.bp-off__head { display: flex; align-items: center; gap: 8px; margin: 0; }
.bp-off__star { display: none; }
.bp-off__title { font-family: var(--mono); font-size: 10px; line-height: 1; letter-spacing: .2em;
  color: var(--mut); text-transform: uppercase; }
.bp-off__rail { display: flex; flex-direction: column; gap: 10px; overflow: visible; }
.bp-offcard { flex: none; border-radius: 0; padding: 15px 16px; background: var(--card);
  border: 1px solid var(--line); box-shadow: none;
  display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.bp-offcard__top { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
.bp-offcard__pct { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; color: var(--ink); line-height: 1.3; }
.bp-offcard__pct span { color: var(--mut); }
.bp-offcard__lbl { font-size: 12px; color: var(--mut); margin: 0; }
.bp-offcard__pay { display: flex; align-items: baseline; gap: 8px; }
.bp-offcard__pay span { font-family: var(--disp); font-weight: var(--dw); font-size: 19px; color: var(--ink); letter-spacing: 0; }
.bp-offcard__pay s { font-size: 12px; color: var(--mut); }
.bp-offcard__tag { flex: 0 0 auto; padding: 5px 9px; border-radius: 0; border: 1px solid var(--acc3);
  background: transparent; color: var(--acc3); font-family: var(--mono); font-size: 9px;
  letter-spacing: .14em; white-space: nowrap; }
.bp-offcard__tag--auto { background: var(--acc); border-color: var(--acc); color: var(--accInk); }
.bp-offcard__note { display: none; }
.bp-off__dots { display: none; }

/* ---------- volume pricing ----------------------------------- */
.bp-vol { margin-top: 22px; display: flex; flex-direction: column; gap: 10px; }
.bp-vol__list { display: flex; flex-direction: column; border: 1px solid var(--line); }
.bp-vol__r { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px;
  background: var(--card); font-size: 13px; color: var(--ink); }
.bp-vol__r + .bp-vol__r { border-top: 1px solid var(--line); }
.bp-vol__r.is-on { background: var(--tint); }
.bp-vol__r b { font-weight: 400; color: var(--ink2); }
.bp-vol__save { font-family: var(--mono); font-size: 9px; letter-spacing: .1em; padding-left: 6px; color: var(--acc2); }
.bp-vol__r:nth-child(3) .bp-vol__save { color: var(--acc3); }

/* ---------- inventory + pickup -------------------------------- */
.bp-inv { margin-top: 22px; display: flex; flex-direction: column; gap: 12px; }
.bp-inv__l { display: flex; flex-direction: column; gap: 7px; }
.bp-inv__row { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 12.5px; color: var(--ink); }
.bp-inv__row em { font-style: normal; font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em; color: var(--mut); }
.bp-inv__t { height: 3px; background: var(--line); }
.bp-inv__t i { display: block; height: 3px; background: var(--starBar); }
.bp-pickup { display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px;
  border: 1px solid var(--line); background: var(--card); }
.bp-pickup > span { width: 6px; height: 6px; border-radius: 50%; background: var(--acc2); margin-top: 5px; flex: 0 0 auto; }
.bp-pickup__t { font-size: 12.5px; color: var(--ink); }
.bp-pickup__s { font-size: 11.5px; color: var(--mut); margin-top: 3px; }
.bp-pickup__s a { border-bottom: 1px solid var(--line); }

/* ---------- quantity + personalisation ------------------------ */
.bp-qty { margin-top: 22px; display: flex; flex-direction: column; gap: 14px; }
.bp-qty__row { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
.bp-qty__step { display: flex; align-items: center; border: 1px solid var(--line); }
.bp-qty__step button { width: 46px; height: 46px; display: flex; align-items: center; justify-content: center;
  border: none; background: transparent; font-size: 16px; color: var(--ink); cursor: pointer; font-family: inherit; }
.bp-qty__step button:first-child { color: var(--mut); }
.bp-qty__step input { width: 46px; height: 46px; text-align: center; border: none;
  border-left: 1px solid var(--line); border-right: 1px solid var(--line); background: transparent;
  font-family: inherit; font-size: 14px; color: var(--ink); -moz-appearance: textfield; }
.bp-qty__step input::-webkit-outer-spin-button,
.bp-qty__step input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
.bp-qty__grp { display: flex; flex-direction: column; gap: 8px; }
.bp-qty__lbl { font-family: var(--mono); font-size: 10px; line-height: 1; letter-spacing: .2em;
  color: var(--mut); text-transform: uppercase; }
.bp-qty__lbl em { font-style: normal; letter-spacing: .06em; text-transform: none; }
.bp-qty__in { height: 46px; width: 100%; padding: 0 14px; border: 1px solid var(--line); border-radius: 0;
  background: var(--card); font-family: inherit; font-size: 13px; color: var(--ink); }
.bp-qty__in::placeholder { color: var(--mut); }
.bp-qty__check { display: flex; align-items: center; gap: 10px; cursor: pointer; }
.bp-qty__box { width: 18px; height: 18px; border: 1px solid var(--line); display: flex; align-items: center;
  justify-content: center; font-size: 11px; color: var(--acc); flex: 0 0 auto; }
.bp-qty__check input { position: absolute; opacity: 0; pointer-events: none; }
.bp-qty__check input:not(:checked) + .bp-qty__box { color: transparent; }
.bp-qty__check span { font-size: 12.5px; color: var(--ink2); }

/* ---------- buy buttons --------------------------------------- */
.bp-buy { margin: 22px 0 0; display: flex; flex-direction: column; gap: 9px; }

/* ---------- guarantees ---------------------------------------- */
.bp-rew { margin: 22px 0 0; border-radius: 0; padding: 0; background: transparent; border: none;
  box-shadow: none; color: inherit; overflow: visible; }
.bp-rew__glow { display: none; }
.bp-rew__head { display: flex; align-items: center; justify-content: space-between; gap: 12px;
  font-family: var(--mono); font-weight: 400; font-size: 10px; line-height: 1; letter-spacing: .2em;
  color: var(--mut); text-transform: uppercase; margin-bottom: 12px; }
.bp-rew__timer { padding: 0; border-radius: 0; background: none; font-family: var(--mono);
  font-size: 10px; letter-spacing: .1em; color: var(--acc); }
.bp-rew__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); margin: 0; }
.bp-gcell { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; padding: 14px;
  border-radius: 0; background: var(--card); border: none; box-shadow: none; }
.bp-gcell__i { font-family: var(--mono); font-size: 12px; line-height: 1; color: var(--acc); flex: 0 0 auto; }
.bp-gcell:nth-child(2) .bp-gcell__i { color: var(--acc2); }
.bp-gcell:nth-child(4) .bp-gcell__i { color: var(--acc3); }
.bp-gcell__t { font-weight: 400; font-size: 13.5px; color: var(--ink); white-space: normal; }
.bp-gcell__s { font-size: 11.5px; color: var(--mut); white-space: normal; overflow: visible; }
.bp-rew__addons { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--line); }
.bp-rew__addhead { display: flex; align-items: center; gap: 6px; margin-bottom: 10px;
  font-family: var(--mono); font-size: 10px; letter-spacing: .16em; color: var(--mut); text-transform: uppercase; }
.bp-rew__addrow { display: flex; gap: 8px; overflow-x: auto; }
.bp-addon { flex: 0 0 auto; display: flex; align-items: center; gap: 8px; padding: 9px 12px;
  border-radius: 0; border: 1px solid var(--line); background: var(--card); cursor: pointer; text-align: left; }
.bp-addon__box { width: 18px; height: 18px; border-radius: 0; border: 1px solid var(--line);
  display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--acc); flex: 0 0 auto; }
.bp-addon.is-on { border-color: var(--ink); background: var(--card); }
.bp-addon.is-on .bp-addon__box { background: var(--ink); border-color: var(--ink); color: var(--pg); }
.bp-addon.is-on .bp-addon__box::after { content: '✓'; }
.bp-addon__n { font-size: 12.5px; color: var(--ink); white-space: nowrap; }
.bp-addon__p { font-family: var(--mono); font-size: 9.5px; letter-spacing: .1em; color: var(--acc); white-space: nowrap; }

/* ---------- price transparency -------------------------------- */
.bp-pt__lead { font-size: 13px; color: var(--ink2); margin-bottom: 14px; font-weight: 400; }
.bp-pt__bar { display: none; }
.bp-pt__rows { display: flex; flex-direction: column; gap: 11px; }
.bp-pt__r { display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--ink2); }
.bp-pt__rl { display: flex; justify-content: space-between; gap: 12px; }
.bp-pt__r b { font-family: var(--body); font-weight: 400; font-size: 13px; }
.bp-pt__t { height: 2px; background: var(--line); }
.bp-pt__t i { display: block; height: 2px; background: var(--ink); }
.bp-pt__foot { display: block; margin-top: 14px; padding: 0; border-radius: 0; background: none;
  font-size: 12.5px; line-height: 1.6; color: var(--mut); }
.bp-pt__foot b { color: var(--ink2); font-weight: 400; }

/* ---------- the difference / promise (numbered rows) ----------- */
.bp-diff__list, .bp-promise__list { display: flex; flex-direction: column; gap: 0;
  border: none; border-radius: 0; overflow: visible; }
.bp-diff__r, .bp-pr { display: flex; align-items: flex-start; gap: 14px; padding: 16px 0;
  border-top: 1px solid var(--line); border-radius: 0; background: transparent; box-shadow: none; }
.bp-diff__r:last-child, .bp-pr:last-child { border-bottom: 1px solid var(--line); }
.bp-diff__n, .bp-pr > span:first-child { font-family: var(--mono); font-weight: 400; font-size: 11px;
  line-height: 1; color: var(--acc); flex: 0 0 auto; width: auto; padding-top: 3px; }
.bp-diff__r:nth-child(2) .bp-diff__n, .bp-pr:nth-child(2) > span:first-child { color: var(--acc2); }
.bp-diff__r:nth-child(4) .bp-diff__n { color: var(--acc3); }
.bp-diff__t, .bp-pr__t { font-family: var(--body); font-weight: 400; font-size: 15px; color: var(--ink); }
.bp-diff__s, .bp-pr__s { font-size: 12.5px; line-height: 1.55; color: var(--mut); margin-top: 5px; }
.bp-diff__r > div, .bp-pr > div { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.bp-diff__c { display: none; }
/* promise sits on the ink panel */
.bp-promise { border-radius: 0; padding: 26px var(--gut); background: var(--ink); color: var(--pg);
  border: none; box-shadow: none; margin: 30px 0 0; overflow: visible; }
.bp-promise__glow { display: none; }
.bp-promise__in { position: static; }
.bp-promise .bp-h2 { color: var(--pg); margin: 0 0 14px; }
.bp-promise .bp-eyebrow { color: var(--accOn); }
.bp-pr { border-top-color: rgba(255,255,255,.16); }
.bp-pr:last-child { border-bottom-color: rgba(255,255,255,.16); }
.bp-pr__t { color: var(--pg); }
.bp-pr__s { color: var(--onDark); }
.bp-pr > span:first-child { color: var(--accOn); }
.bp-pr:nth-child(2) > span:first-child { color: var(--acc2); }

/* ---------- fabric DNA ----------------------------------------- */
.bp-fab { border-radius: 0; overflow: visible; background: transparent; color: inherit;
  border: none; box-shadow: none; padding: 0; display: flex; flex-direction: column; gap: 16px; }
.bp-fab__hero { position: relative; height: 200px; aspect-ratio: auto; border-radius: 0;
  background: repeating-linear-gradient(135deg,var(--ph1) 0 12px,var(--ph2) 12px 24px);
  display: flex; align-items: flex-end; padding: 14px; }
.bp-fab__hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.bp-fab__title { position: static; font-family: var(--mono); font-weight: 400; font-size: 10px;
  letter-spacing: .14em; color: var(--mut); }
.bp-fab__cotton { position: absolute; top: -46px; right: 0; padding: 5px 9px; border-radius: 0;
  border: 1px solid var(--acc); background: transparent; color: var(--acc);
  font-family: var(--mono); font-size: 9px; letter-spacing: .14em; }
.bp-fab__head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
.bp-fabtabs, .bp-tabs { display: flex; gap: 22px; border-bottom: 1px solid var(--line); padding: 0; background: none; }
.bp-tab { flex: 0 0 auto; padding: 0 0 9px; border: none; border-bottom: 1px solid transparent;
  border-radius: 0; background: none; color: var(--mut); font-family: inherit; font-size: 12.5px; cursor: pointer; }
.bp-tab.is-on { background: none; color: var(--ink); border-bottom-color: var(--ink); }
.bp-tabs--dark .bp-tab { background: none; color: var(--mut); }
.bp-tabs--dark .bp-tab.is-on { background: none; color: var(--ink); }
.bp-dna { padding: 0; display: flex; flex-direction: column; gap: 10px; }
.bp-dna__i { display: flex; align-items: center; gap: 12px; }
.bp-dna__l { display: contents; }
.bp-dna__l span { width: 104px; flex: 0 0 auto; font-size: 12.5px; color: var(--mut); margin: 0; }
.bp-dna__l b { width: 42px; flex: 0 0 auto; text-align: right; font-family: var(--mono);
  font-weight: 400; font-size: 10px; color: var(--ink2); order: 3; }
.bp-dna__t { flex: 1; height: 3px; border-radius: 0; background: var(--line); overflow: hidden; order: 2; }
.bp-dna__t i { display: block; height: 100%; border-radius: 0; background: var(--acc2); }
.bp-chips { padding: 0; display: flex; gap: 7px; flex-wrap: wrap; }
.bp-care { padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); }
.bp-care__i { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; padding: 12px 14px;
  border-radius: 0; background: var(--card); border: none; }
.bp-care__i > span:first-child { display: none; }
.bp-care__t { font-weight: 400; font-size: 13px; color: var(--ink); }
.bp-care__s { font-size: 11.5px; color: var(--mut); }

/* ---------- 30-wash test ---------------------------------------- */
.bp-wash__row { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; }
.bp-wcard { flex: none; border-radius: 0; padding: 12px 10px; background: var(--card);
  border: 1px solid var(--line); display: flex; flex-direction: column; gap: 7px; }
.bp-wcard__img { border-radius: 0; aspect-ratio: auto; height: 52px; margin: 0; padding: 0;
  background: repeating-linear-gradient(135deg,var(--ph1) 0 8px,var(--ph2) 8px 16px); display: block; overflow: hidden; }
.bp-wcard__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.bp-wcard__img span { display: none; }
.bp-wcard__k { font-family: var(--mono); font-size: 9px; letter-spacing: .1em; color: var(--mut); margin: 0; }
.bp-wcard__v { font-family: var(--disp); font-weight: var(--dw); font-size: 17px; line-height: 1; color: var(--ink); }
.bp-wcard__t { display: none; }
.bp-wcard__note { font-size: 10.5px; line-height: 1.3; color: var(--mut); text-align: left;
  margin: 0; font-weight: 400; }

/* ---------- comparison ------------------------------------------ */
.bp-cmp__table { border-radius: 0; overflow: visible; border: none; box-shadow: none;
  display: flex; flex-direction: column; }
.bp-cmp__hr { display: grid; grid-template-columns: 1.15fr .95fr .9fr; gap: 10px;
  background: transparent; color: var(--mut); padding: 0 0 10px; border-bottom: 1px solid var(--ink);
  font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; }
.bp-cmp__r { display: grid; grid-template-columns: 1.15fr .95fr .9fr; gap: 10px; padding: 13px 0;
  border-top: none; border-bottom: 1px solid var(--line); font-size: 12.5px; line-height: 1.35; background: transparent; }
.bp-cmp__r.a, .bp-cmp__r.b { background: transparent; }
.bp-cmp__c1 { flex: none; padding: 0; font-size: 12.5px; font-weight: 400; color: var(--mut); text-align: left; }
.bp-cmp__c2 { flex: none; padding: 0; text-align: left; font-size: 12.5px; font-weight: 400;
  color: var(--ink); background: transparent; display: block; }
.bp-cmp__c3 { flex: none; padding: 0; text-align: left; font-size: 12.5px; color: var(--mut); }
.bp-cmp__hr .bp-cmp__c1, .bp-cmp__hr .bp-cmp__c2, .bp-cmp__hr .bp-cmp__c3 {
  padding: 0; text-align: left; font-size: 9.5px; color: var(--mut); }
.bp-cmp__hr .bp-cmp__c2 { color: var(--ink); background: transparent; }

/* ---------- accordions (details + policies + faq) ---------------- */
.bp-acc, .bp-faq__list { display: flex; flex-direction: column; gap: 0; }
.bp-acc__i, .bp-faq__i { border-radius: 0; background: transparent; border: none; border-top: 1px solid var(--line);
  box-shadow: none; overflow: hidden; }
.bp-acc__i:last-child, .bp-faq__i:last-child { border-bottom: 1px solid var(--line); }
.bp-acc__b, .bp-faq__b { width: 100%; display: flex; align-items: center; gap: 12px; padding: 16px 0;
  background: transparent; border: none; cursor: pointer; text-align: left; font-family: inherit; }
.bp-acc__b > div { flex: 1; min-width: 0; }
.bp-acc__t, .bp-faq__b span { font-family: var(--body); font-weight: 400; font-size: 14px; color: var(--ink); flex: 1; }
.bp-acc__s { font-size: 11.5px; color: var(--mut); margin-top: 2px; }
.bp-acc__x, .bp-faq__b em { flex: 0 0 auto; width: auto; height: auto; border-radius: 0; border: none;
  background: none; color: var(--mut); font-family: var(--mono); font-style: normal; font-size: 13px; font-weight: 400; }
.bp-acc__i.is-open .bp-acc__x, .bp-faq__i.is-open .bp-faq__b em { color: var(--acc); }
.bp-acc__p, .bp-faq__p { padding: 0 0 16px; }
.bp-acc__txt, .bp-faq__p { font-size: 12.5px; line-height: 1.6; color: var(--mut); animation: none; }
/* product details spec rows */
.bp-spec { display: flex; flex-direction: column; gap: 0; }
.bp-spec__c { display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
  padding: 12px 0; border-top: 1px solid var(--line); border-radius: 0; background: transparent; border-left: none;
  border-right: none; border-bottom: none; }
.bp-spec__c:last-child { border-bottom: 1px solid var(--line); }
.bp-spec__k { font-family: var(--body); font-size: 13.5px; color: var(--mut); font-weight: 400;
  text-transform: none; letter-spacing: 0; }
.bp-spec__v { font-family: var(--body); font-weight: 400; font-size: 13.5px; color: var(--ink);
  margin: 0; text-align: right; }
.bp-details__lead { font-size: 13px; line-height: 1.65; color: var(--ink2); }

/* ---------- reviews ---------------------------------------------- */
.bp-rev__head { display: flex; align-items: baseline; justify-content: space-between; margin: 0 0 16px; }
.bp-rev__count { font-family: var(--mono); font-size: 10px; letter-spacing: .1em; color: var(--mut); }
.bp-rev .bp-tabs { background: none; margin-bottom: 16px; }
.bp-revpane { padding: 0; }
.bp-rsum { display: flex; gap: 18px; align-items: center; margin-bottom: 16px; }
.bp-rsum__big { text-align: center; flex: 0 0 auto; display: flex; flex-direction: column; gap: 4px;
  align-items: center; padding-right: 18px; border-right: 1px solid var(--line); }
.bp-rsum__big b { font-family: var(--disp); font-weight: var(--dw); font-size: 42px; line-height: 1; display: block; color: var(--ink); }
.bp-rsum__big .bp-stars { font-size: 11px; }
.bp-rsum__big em { font-size: 10.5px; color: var(--mut); font-style: normal; display: block; }
.bp-rsum__bars { flex: 1; display: flex; flex-direction: column; gap: 9px; }
.bp-rbar { display: flex; flex-direction: column; gap: 4px; margin: 0; }
.bp-rbar__l { display: flex; justify-content: space-between; font-size: 11.5px; }
.bp-rbar span { font-size: 11.5px; font-weight: 400; width: auto; color: var(--mut); }
.bp-rbar em { font-size: 11.5px; color: var(--ink2); width: auto; text-align: right; font-style: normal; }
.bp-rbar__t { flex: none; height: 3px; border-radius: 0; background: var(--line); overflow: hidden; }
.bp-rbar__t i { display: block; height: 100%; border-radius: 0; background: var(--acc2); }
.bp-aisum { border-radius: 0; padding: 15px 16px; background: var(--tint); margin-bottom: 16px;
  display: flex; flex-direction: column; gap: 7px; }
.bp-aisum__h { display: flex; align-items: center; gap: 6px; margin: 0; font-family: var(--mono);
  font-weight: 400; font-size: 9px; letter-spacing: .14em; color: var(--acc2); text-transform: uppercase; }
.bp-ai--sm { display: none; }
.bp-aisum p { font-size: 12.5px; line-height: 1.6; color: var(--ink2); }
.bp-kw { display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 16px; }
.bp-kw span { padding: 6px 11px; border-radius: 0; border: 1px solid var(--line); background: transparent;
  font-size: 11.5px; font-weight: 400; color: var(--ink2); }
.bp-kw em { color: var(--mut); font-style: normal; }
.bp-revfilters { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; margin-bottom: 16px; }
.bp-revfilters button { flex: 0 0 auto; padding: 6px 11px; border-radius: 0; border: 1px solid var(--line);
  background: transparent; color: var(--ink2); font-family: inherit; font-size: 11.5px; cursor: pointer; white-space: nowrap; }
.bp-revfilters button.is-on { background: var(--ink); color: var(--pg); border-color: var(--ink); }
.bp-revfilters em { font-style: normal; }
.bp-rcards { display: flex; flex-direction: column; gap: 10px; }
.bp-rcard { border-radius: 0; padding: 16px; background: var(--card); border: 1px solid var(--line);
  box-shadow: none; animation: none; display: flex; flex-direction: column; gap: 10px; }
.bp-rcard__top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 0; }
.bp-rcard__av { display: none; }
.bp-rcard__id { flex: 1; min-width: 0; }
.bp-rcard__nm { display: flex; align-items: center; gap: 6px; font-weight: 400; font-size: 13.5px; color: var(--ink); }
.bp-rcard__nm em { font-family: var(--mono); font-size: 9px; letter-spacing: .1em; color: var(--acc2); font-style: normal; }
.bp-rcard__meta { font-family: var(--mono); font-size: 9.5px; letter-spacing: .1em; color: var(--mut); text-transform: uppercase; }
.bp-rcard__st { color: var(--star); font-size: 11px; letter-spacing: .1em; flex: 0 0 auto; }
.bp-rcard__tx { font-size: 13px; line-height: 1.6; color: var(--ink2); margin: 0; }
.bp-rcard__ph { display: flex; gap: 8px; margin: 0; }
.bp-rcard__ph i { width: 56px; height: 56px; border-radius: 0;
  background: repeating-linear-gradient(135deg,var(--ph1) 0 8px,var(--ph2) 8px 16px); }
.bp-rcard__ft { display: flex; align-items: center; gap: 10px; padding: 0; border-top: none; }
.bp-rcard__fit { font-family: var(--mono); font-size: 9.5px; letter-spacing: .08em; color: var(--mut); text-transform: uppercase; }
.bp-rcard__help { margin-left: auto; padding: 0; border-radius: 0; border: none; background: none;
  font-family: var(--mono); font-size: 9.5px; letter-spacing: .08em; color: var(--mut); cursor: pointer; text-transform: uppercase; }
.bp-rcard__pct { display: none; }
.bp-match__note { border-radius: 0; padding: 15px 16px; background: var(--tint); color: var(--ink2);
  margin-bottom: 12px; font-size: 12.5px; line-height: 1.6; }
.bp-match__note b { color: var(--ink); font-weight: 400; }
.bp-rempty { padding: 24px; text-align: center; color: var(--mut); font-size: 12.5px;
  border: 1px solid var(--line); border-radius: 0; margin-top: 10px; }
.bp-rev__cta { display: flex; align-items: center; justify-content: center; height: 46px; margin-top: 16px;
  border: 1px solid var(--ink); font-size: 12.5px; letter-spacing: .06em; color: var(--ink); }

/* ---------- social proof ------------------------------------------ */
.bp-loved { border-radius: 0; padding: 26px var(--gut); background: var(--tintC); color: var(--ink);
  border: none; box-shadow: none; margin: 30px 0 0; overflow: visible; }
.bp-loved__glow { display: none; }
.bp-loved__top { position: static; text-align: left; }
.bp-loved__h { font-family: var(--disp); font-weight: var(--dw); font-size: 28px; line-height: 1.14;
  letter-spacing: var(--dls); color: var(--ink); margin: 0 0 16px; }
.bp-loved__stars { display: none; }
.bp-loved__stats { position: static; display: grid; grid-template-columns: 1fr 1fr; gap: 1px;
  background: var(--line); margin: 0 0 16px; }
.bp-stat { text-align: left; padding: 15px; border-radius: 0; background: var(--pg); border: none;
  box-shadow: none; display: flex; flex-direction: column; gap: 4px; }
.bp-stat b { font-family: var(--disp); font-weight: var(--dw); font-size: 24px; line-height: 1;
  color: var(--ink); display: block; }
.bp-stat span { font-size: 11.5px; color: var(--mut); margin: 0; line-height: 1.3; display: block; }
.bp-notes { position: static; display: flex; flex-direction: column; gap: 10px; }
.bp-note { transform: none; background: var(--pg); color: var(--ink); border-radius: 0;
  padding: 13px 15px; border: none; border-left: 2px solid var(--acc); box-shadow: none;
  animation: none; position: static; display: flex; flex-direction: column; gap: 5px; }
.bp-note:nth-child(2) { border-left-color: var(--acc2); }
.bp-note:nth-child(3) { border-left-color: var(--acc3); }
.bp-note__q { display: none; }
.bp-note p { font-size: 13px; line-height: 1.5; font-weight: 400; padding: 0; margin: 0; color: var(--ink2); }
.bp-note__by { display: flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 9.5px;
  letter-spacing: .1em; color: var(--mut); font-weight: 400; text-transform: uppercase; }
.bp-note__by span { display: none; }
.bp-loved__cta { position: static; display: inline-block; text-align: left; margin-top: 16px; padding: 0;
  border-radius: 0; background: none; color: var(--acc); font-family: var(--body); font-weight: 400;
  font-size: 12.5px; text-decoration: none; border-bottom: 1px solid var(--acc); box-shadow: none; align-self: flex-start; }

/* ---------- pairs well with (product rail) -------------------------- */
.bp-pairs { margin: 30px 0 0; display: flex; flex-direction: column; gap: 14px; }
.bp-pairs__rail { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 4px; }
.bp-pairs__i { flex: 0 0 132px; display: flex; flex-direction: column; gap: 7px; }
.bp-pairs__img { height: 158px; overflow: hidden;
  background: repeating-linear-gradient(135deg,var(--ph1) 0 10px,var(--ph2) 10px 20px); }
.bp-pairs__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.bp-pairs__n { font-size: 12.5px; line-height: 1.35; color: var(--ink); }
.bp-pairs__p { font-size: 11.5px; color: var(--ink2); }
.bp-pairs__foot { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.bp-pairs__foot em { font-style: normal; font-family: var(--mono); font-size: 9.5px;
  letter-spacing: .12em; color: var(--mut); text-transform: uppercase; }
.bp-pairs__foot a { font-size: 12.5px; color: var(--acc); border-bottom: 1px solid var(--acc); }

/* ---------- complete the look ---------------------------------------- */
.bp-look__head { display: flex; align-items: baseline; justify-content: space-between; margin: 0 0 14px; }
.bp-look__row { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; align-items: start; }
.bp-look__i { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.bp-look__img { position: relative; border-radius: 0; overflow: hidden; aspect-ratio: auto; height: 130px;
  background: repeating-linear-gradient(135deg,var(--ph1) 0 10px,var(--ph2) 10px 20px);
  display: block; font-family: var(--mono); font-size: 8px; color: var(--mut); }
.bp-look__i:first-child .bp-look__img { outline: 1px solid var(--ink); outline-offset: -1px; }
.bp-look__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.bp-look__tag { position: static; padding: 0; border-radius: 0; background: none;
  color: var(--mut); font-family: var(--mono); font-size: 8.5px; letter-spacing: .12em; text-transform: uppercase; }
.bp-look__i:first-child .bp-look__tag { color: var(--acc); }
.bp-look__n { font-weight: 400; font-size: 12px; margin: 0; line-height: 1.35; color: var(--ink); }
.bp-look__p { display: flex; align-items: baseline; gap: 6px; margin: 0; }
.bp-look__p span { font-family: var(--body); font-weight: 400; font-size: 11.5px; color: var(--ink2); }
.bp-look__p s { font-size: 11.5px; color: var(--mut); }
.bp-look__foot { display: flex; align-items: center; justify-content: space-between; gap: 12px;
  margin-top: 14px; padding: 15px 16px; border-top: none; border: 1px solid var(--line); background: var(--card); }
.bp-look__bl { font-family: var(--mono); font-size: 9px; letter-spacing: .12em; color: var(--acc); text-transform: uppercase; }
.bp-look__bp { display: flex; align-items: baseline; gap: 8px; margin-top: 4px; }
.bp-look__bp span { font-family: var(--disp); font-weight: var(--dw); font-size: 20px; color: var(--ink); }
.bp-look__bp s { font-size: 12px; color: var(--mut); }
.bp-look__cta { flex: 0 0 auto; padding: 13px 20px; border-radius: 0; border: none; background: var(--ink);
  color: var(--pg); font-family: var(--body); font-weight: 400; font-size: 12px; letter-spacing: .12em;
  white-space: nowrap; cursor: pointer; box-shadow: none; text-transform: uppercase; }
.bp-look__cta:active { transform: none; }

/* ---------- customer gallery ------------------------------------------ */
.bp-gal__head { display: flex; align-items: baseline; justify-content: space-between; margin: 0 0 14px; }
.bp-gal__grid { columns: auto; column-gap: 0; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; align-items: start; }
.bp-gal__col { display: flex; flex-direction: column; gap: 6px; }
.bp-gcard { break-inside: auto; margin: 0; position: relative; border-radius: 0; overflow: hidden;
  background: repeating-linear-gradient(135deg,var(--ph1) 0 10px,var(--ph2) 10px 20px); }
.bp-gcard img { width: 100%; height: 100%; object-fit: cover; display: block; }
.bp-gcard__img { display: flex; align-items: flex-end; padding: 8px; font-family: var(--mono);
  font-size: 8.5px; color: var(--mut); height: 100%; }
.bp-gcard__bar { position: absolute; inset: auto 0 0 0; padding: 8px; background: none;
  display: flex; align-items: center; justify-content: space-between; }
.bp-gcard__bar span { color: var(--mut); font-family: var(--mono); font-size: 8.5px; font-weight: 400; }
.bp-gcard__bar b { display: none; }

/* ---------- lifestyle rail --------------------------------------------- */
.bp-life__rail { display: flex; gap: 10px; padding: 0 0 4px; overflow-x: auto; margin-top: 14px; }
.bp-lcard { flex: 0 0 150px; border-radius: 0; overflow: visible; aspect-ratio: auto; position: static;
  box-shadow: none; background: none; display: flex; flex-direction: column; gap: 8px; }
.bp-lcard__img { height: 190px; overflow: hidden;
  background: repeating-linear-gradient(135deg,var(--ph1) 0 10px,var(--ph2) 10px 20px); }
.bp-lcard__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.bp-lcard__cap { position: static; padding: 0; background: none; display: flex; flex-direction: column; gap: 3px; }
.bp-lcard__t { color: var(--ink); font-family: var(--body); font-weight: 400; font-size: 13.5px; }
.bp-lcard__s { color: var(--mut); font-size: 11.5px; }

/* ---------- founder ----------------------------------------------------- */
.bp-founder { border-radius: 0; padding: 26px var(--gut); background: var(--tint); border: none;
  margin: 30px 0 0; display: flex; flex-direction: column; gap: 14px; }
.bp-founder__head { display: flex; align-items: center; gap: 13px; margin: 0; }
.bp-founder__ph { width: 52px; height: 52px; border-radius: 50%; flex: 0 0 auto; overflow: hidden;
  background: repeating-linear-gradient(135deg,var(--ph1) 0 8px,var(--ph2) 8px 16px);
  display: flex; align-items: center; justify-content: center; font-family: var(--mono); font-size: 7px; color: var(--mut); }
.bp-founder__ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
.bp-founder__t { font-family: var(--body); font-weight: 400; font-size: 14px; line-height: 1.2; color: var(--ink); }
.bp-founder__by { font-family: var(--mono); font-size: 9.5px; letter-spacing: .1em; color: var(--mut);
  margin-top: 4px; text-transform: uppercase; }
.bp-founder__q { font-family: var(--disp); font-weight: var(--dw); font-size: 19px; line-height: 1.5;
  color: var(--ink); margin: 0; }
.bp-founder__sig { font-family: var(--body); font-style: normal; font-size: 12.5px; color: var(--mut); }

/* ---------- share -------------------------------------------------------- */
.bp-share { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 26px 0 0; }
.bp-share__l { font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em; color: var(--mut); text-transform: uppercase; }
.bp-share a, .bp-share button { font-size: 12px; padding: 7px 12px; border: 1px solid var(--line);
  border-radius: 0; background: transparent; color: var(--ink2); font-family: inherit; cursor: pointer; }

/* ---------- closing seal --------------------------------------------------- */
.bp-seal { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 34px 0 30px; }
.bp-seal__mark { width: 70px; height: 70px; border-radius: 50%; border: 1px solid var(--acc);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; }
.bp-seal__k { font-family: var(--mono); font-size: 8.5px; letter-spacing: .14em; color: var(--acc); }
.bp-seal__y { font-family: var(--disp); font-weight: var(--dw); font-size: 19px; line-height: 1; color: var(--ink); }
.bp-seal__t { font-family: var(--mono); font-size: 9.5px; letter-spacing: .18em; color: var(--mut); text-align: center; }
/* legacy footer alias */
.bp-footer { text-align: center; padding: 34px 0 30px; }
.bp-footer__logo { font-family: var(--disp); font-weight: var(--dw); letter-spacing: .2em; font-size: 14px; color: var(--ink); }
.bp-footer__tag { font-family: var(--mono); font-size: 9.5px; letter-spacing: .18em; color: var(--mut); margin-top: 6px; }

/* ---------- sticky buy bar --------------------------------------------------- */
.bp-sticky { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%;
  max-width: 430px; z-index: 60; padding: 0; }
.bp-wallet { margin: 0; border-radius: 0; padding: 12px var(--gut); background: var(--ink);
  backdrop-filter: none; -webkit-backdrop-filter: none; border: none;
  border-bottom: 1px solid rgba(255,255,255,.16); animation: none; }
.bp-wallet__h { font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em; color: var(--onDark);
  font-weight: 400; margin-bottom: 8px; text-transform: uppercase; }
.bp-wallet__h em { font-style: normal; }
.bp-wallet__list { display: flex; flex-direction: column; gap: 6px; }
.bp-wrow { display: flex; align-items: center; gap: 8px; }
.bp-wrow__i { display: none; }
.bp-wrow span.t { flex: 1; font-size: 12px; color: var(--pg); }
.bp-wrow b { font-family: var(--mono); font-size: 9.5px; letter-spacing: .1em; font-weight: 400; }
.bp-sbar { border-radius: 0; padding: 13px var(--gut); background: var(--ink); backdrop-filter: none;
  -webkit-backdrop-filter: none; border: none; box-shadow: none;
  display: flex; align-items: center; justify-content: space-between; gap: 14px; }
.bp-sbar__meter { display: none; }
.bp-sbar__row { display: contents; }
.bp-sbar__price { flex: 0 0 auto; text-align: left; background: transparent; border: none; cursor: pointer;
  padding: 0; display: flex; flex-direction: column; gap: 3px; align-items: flex-start; }
.bp-sbar__meta { font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em; color: var(--onDark);
  font-weight: 400; text-transform: uppercase; order: -1; }
.bp-sbar__meta em { font-style: normal; }
.bp-sbar__nums { display: flex; align-items: baseline; gap: 7px; }
.bp-sbar__nums span { font-family: var(--disp); font-weight: var(--dw); font-size: 19px; line-height: 1; color: var(--pg); }
.bp-sbar__nums s { font-size: 11.5px; color: #8F887C; }
.bp-sbar__cta { flex: 0 0 auto; padding: 15px 26px; border-radius: 0; border: none; background: var(--acc);
  color: var(--accInk); font-family: var(--body); font-weight: 500; font-size: 12.5px; letter-spacing: .14em;
  cursor: pointer; box-shadow: none; text-transform: uppercase; }
.bp-sbar__cta:active { transform: none; }

/* ---------- add-to-cart feedback -------------------------------------------------
   Press, working, confirmed. Without these a tap is silent and the shopper has no
   idea whether anything happened.
   -------------------------------------------------------------------------------- */
.bp-sbar__cta { position: relative; transition: transform .1s ease, background-color .2s ease, opacity .2s ease; }
.bp-sbar__cta:active { transform: scale(.97); }
.bp-sbar__cta[disabled] { cursor: wait; }
.bp-sbar__cta.is-pending { opacity: .78; padding-left: 46px !important; }
.bp-sbar__cta.is-pending::before {
  content: ''; position: absolute; left: 20px; top: 50%; width: 13px; height: 13px;
  margin-top: -7px; border-radius: 50%;
  border: 2px solid currentColor; border-top-color: transparent;
  animation: bp-spin .6s linear infinite;
}
.bp-sbar__cta.is-done {
  background: var(--acc2) !important; color: var(--pg) !important;
  padding-left: 44px !important;
}
.bp-sbar__cta.is-done::before {
  content: '✓'; position: absolute; left: 20px; top: 50%; transform: translateY(-50%);
  font-size: 13px; line-height: 1; animation: bp-tick .28s cubic-bezier(.2,.9,.3,1.4) both;
}
/* the whole bar acknowledges the add once */
.bp-sbar:has(.is-done) { animation: bp-nudge .32s ease; }

/* the main buy-box button gets the same press and confirmation */
.bp-buybox button[name="add"] { transition: transform .1s ease, background-color .2s ease; }
.bp-buybox button[name="add"]:active { transform: scale(.99); }
.bp-buybox button[name="add"][aria-busy="true"] { opacity: .78; cursor: wait; }

@keyframes bp-spin { to { transform: rotate(360deg); } }
@keyframes bp-tick { from { opacity: 0; transform: translateY(-50%) scale(.4); }
                     to   { opacity: 1; transform: translateY(-50%) scale(1); } }
@keyframes bp-nudge { 0% { transform: translateY(0); } 45% { transform: translateY(-3px); } 100% { transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) {
  .bp-sbar__cta.is-pending::before { animation: none; }
  .bp-sbar:has(.is-done) { animation: none; }
}

/* ---------- fit studio modal -------------------------------------------------- */
.bp-modal { position: fixed; inset: 0; z-index: 90; display: flex; align-items: flex-end; justify-content: center; }
.bp-modal__scrim { position: absolute; inset: 0; background: rgba(13,17,24,.5); }
.bp-modal__sheet { position: relative; width: 100%; max-width: 430px; max-height: 88vh; overflow-y: auto;
  background: var(--pg); border-radius: 0; box-shadow: 0 -20px 50px rgba(0,0,0,.25);
  animation: bp-sheet .32s cubic-bezier(.2,.85,.25,1) both; }
.bp-modal__head { position: sticky; top: 0; background: var(--pg); padding: 16px var(--gut) 0; z-index: 2; }
.bp-modal__grab { display: none; }
.bp-modal__title { display: flex; align-items: center; gap: 10px; }
.bp-modal__title h2 { font-family: var(--disp); font-weight: var(--dw); font-size: 24px;
  letter-spacing: var(--dls); color: var(--ink); }
.bp-modal__title .bp-ai { display: none; }
.bp-modal__x { margin-left: auto; width: 32px; height: 32px; border-radius: 0; border: 1px solid var(--line);
  background: transparent; color: var(--ink); font-size: 15px; cursor: pointer; }
.bp-modal .bp-tabs { padding: 16px var(--gut) 0; margin: 0; }
.bp-fitpane { padding: 16px var(--gut) 20px; }
.bp-fit__sliders { display: flex; gap: 14px; margin-bottom: 16px; } .bp-fit__sliders > div { flex: 1; }
.bp-fit__lab { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }
.bp-fit__lab span { font-size: 12.5px; color: var(--mut); }
.bp-fit__lab b { font-family: var(--mono); font-weight: 400; font-size: 12px; color: var(--ink); }
.bp-fit__lab em { font-style: normal; }
.bp-fit__prefs, .bp-fit__modes { display: flex; gap: 8px; margin-bottom: 14px; }
.bp-fit__prefs button, .bp-fit__modes button { flex: 1; padding: 10px 4px; border-radius: 0;
  border: 1px solid var(--line); background: transparent; color: var(--ink2); font-family: inherit;
  font-size: 12px; cursor: pointer; }
.bp-fit__prefs button.is-on, .bp-fit__modes button.is-on { background: var(--ink); color: var(--pg); border-color: var(--ink); }
.bp-fit__result { border-radius: 0; padding: 16px; background: var(--ink); color: var(--pg);
  display: flex; align-items: center; gap: 14px; }
.bp-fit__sz { text-align: center; flex: 0 0 auto; }
.bp-fit__sz span { font-family: var(--mono); font-size: 9px; letter-spacing: .14em; color: var(--onDark); }
.bp-fit__sz b { font-family: var(--disp); font-weight: var(--dw); font-size: 38px; line-height: 1;
  color: var(--pg); display: block; animation: none; }
.bp-fit__meta { flex: 1; }
.bp-fit__conf { display: flex; align-items: center; gap: 8px; margin-bottom: 7px; }
.bp-fit__bar { flex: 1; height: 3px; border-radius: 0; background: rgba(255,255,255,.2); overflow: hidden; }
.bp-fit__bar i { display: block; height: 100%; background: var(--accOn); border-radius: 0; }
.bp-fit__conf span { font-family: var(--mono); font-size: 12px; font-weight: 400; }
.bp-fit__line { font-size: 12px; color: var(--onDark); line-height: 1.5; }
.bp-fit__apply { margin-top: 12px; width: 100%; padding: 12px; border-radius: 0; border: none;
  background: var(--acc); color: var(--accInk); font-family: var(--body); font-weight: 500; font-size: 12.5px;
  letter-spacing: .14em; cursor: pointer; text-transform: uppercase; }
.bp-fit__apply em { font-style: normal; }
.bp-chart__h { display: flex; padding: 0 0 8px; border-bottom: 1px solid var(--ink);
  font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em; color: var(--mut); text-transform: uppercase; }
.bp-chart__h span:first-child { flex: .7; text-align: left; }
.bp-chart__h span { flex: 1; text-align: center; }
.bp-chart__r { display: flex; align-items: center; padding: 12px 0; border-radius: 0; margin: 0;
  border: none; border-bottom: 1px solid var(--line); }
.bp-chart__r span { flex: 1; text-align: center; font-size: 12.5px; color: var(--ink2); }
.bp-chart__sz { flex: .7 !important; text-align: left !important; font-family: var(--body);
  font-weight: 400; font-size: 13px; color: var(--ink); }
.bp-chart__r.is-rec { background: var(--tint); border-color: var(--line); }
.bp-chart__r.is-rec .bp-chart__sz { color: var(--ink); }
.bp-chart__note { margin-top: 12px; padding: 12px 14px; border-radius: 0; background: var(--tint);
  font-size: 12px; color: var(--ink2); line-height: 1.5; }
.bp-guide__lead { font-size: 12.5px; color: var(--mut); margin-bottom: 12px; }
.bp-guide__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); }
.bp-guide__i { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; padding: 12px 14px;
  border-radius: 0; background: var(--card); border: none; }
.bp-guide__i > span:first-child { display: none; }
.bp-guide__n { font-weight: 400; font-size: 13px; color: var(--ink); }
.bp-guide__m { font-size: 11.5px; color: var(--mut); font-weight: 400; }

/* ---------- wrappers introduced by the editorial markup ------------------------- */
.bp-spec-wrap, .bp-rev__body, .bp-look__body { display: block; }
.bp-gal__grid { columns: 3; column-gap: 6px; display: block; }
.bp-gal__grid .bp-gcard { break-inside: avoid; margin-bottom: 6px; display: block; }
.bp-live__item[hidden] { display: none !important; }

/* ---------- containment ---------------------------------------------------------
   Grid and flex children default to min-width:auto, so one long word or a wide
   cell pushes the whole row past its block. These pin everything inside.
   -------------------------------------------------------------------------------- */
.bp-blk { max-width: 100%; }
.bp-blk img { max-width: 100%; height: auto; }
.bp-snap > *, .bp-hgrid > *, .bp-rew__grid > *, .bp-care > *, .bp-guide__grid > *,
.bp-loved__stats > *, .bp-look__row > *, .bp-wash__row > *, .bp-size__row > * { min-width: 0; }
.bp-cmp__hr > *, .bp-cmp__r > * { min-width: 0; overflow-wrap: anywhere; }
.bp-snapcell__v, .bp-gcell__t, .bp-gcell__s, .bp-vol__r, .bp-inv__row,
.bp-look__n, .bp-pairs__n, .bp-lcard__t { overflow-wrap: anywhere; }
.bp-head__title, .bp-h2, .bp-loved__h, .bp-founder__q { overflow-wrap: break-word; }
/* horizontal rails scroll rather than stretching their block */
.bp-pairs__rail, .bp-life__rail, .bp-hero__thumbs, .bp-revfilters,
.bp-rew__addrow, .bp-chips { max-width: 100%; }
.bp-pairs__rail, .bp-life__rail, .bp-hero__thumbs, .bp-revfilters, .bp-rew__addrow {
  overflow-x: auto; -webkit-overflow-scrolling: touch; }
/* the ticker marquee must never widen the page */
.bp-ticker { max-width: 100%; overflow: hidden; }
/* the sticky bar is fixed — keep it off the last block */
.bp-blk--sticky-bar { height: 0; }

/* ---------- misc --------------------------------------------------------------- */
@keyframes bp-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes bp-sheet { from { transform: translateY(100%); } to { transform: translateY(0); } }
.bp-blk input[type=range] { -webkit-appearance: none; appearance: none; width: 100%; height: 3px;
  border-radius: 0; background: var(--line); outline: none; }
.bp-blk input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none;
  width: 18px; height: 18px; border-radius: 50%; background: var(--ink); border: none;
  box-shadow: none; cursor: pointer; }
@media (prefers-reduced-motion: reduce) { .bp-blk *, .bp-blk *::before, .bp-blk *::after {
  animation-duration: .001ms !important; transition-duration: .001ms !important; } }
@media (min-width: 750px) { .bp__wrap { max-width: 480px; } }

</style>

