.bp-cmp__c2 { flex: 1; padding: 12px 10px; text-align: center; font-size: 11.5px; font-weight: 700; color: var(--green); background: rgba(23,194,127,.07); display: flex; align-items: center; justify-content: center; gap: 4px; }
.bp-cmp__c3 { flex: 1; padding: 12px 10px; text-align: center; font-size: 11.5px; color: #9AA0AC; }
.bp-cmp__hr .bp-cmp__c1, .bp-cmp__hr .bp-cmp__c2, .bp-cmp__hr .bp-cmp__c3 { padding: 13px 10px; text-align: center; font-size: 12px; }
.bp-cmp__hr .bp-cmp__c1 { flex: 1.2; text-align: left; padding-left: 14px; font-size: 11px; }

/* promise */
.bp-promise { border-radius: 26px; padding: 24px 18px; background: linear-gradient(165deg,#CFF5DC 0%,#FAFCF8 100%); color: #2E4B3F; border: 1px solid rgba(23,194,127,.22); box-shadow: 0 1px 0 rgba(255,255,255,.9) inset, 0 20px 44px -28px rgba(23,194,127,.35); position: relative; overflow: hidden; }
.bp-promise__glow { position: absolute; top: -50px; right: -40px; width: 180px; height: 180px; border-radius: 50%; background: radial-gradient(circle,rgba(34,199,128,.28),transparent 70%); }
.bp-promise__in { position: relative; } .bp-promise .bp-h2 { color: var(--ink2); margin: 6px 0 16px; }
.bp-promise__list { display: flex; flex-direction: column; gap: 9px; }
.bp-pr { display: flex; align-items: center; gap: 13px; padding: 13px 14px; border-radius: 16px; background: rgba(255,255,255,.85); border: 1px solid rgba(23,194,127,.18); box-shadow: 0 1px 0 rgba(255,255,255,.95) inset, 0 6px 16px -10px rgba(23,194,127,.25); }
.bp-pr > span { font-size: 20px; flex: 0 0 auto; }
.bp-pr__t { font-family: var(--disp); font-weight: 700; font-size: 14px; color: var(--ink2); }
.bp-pr__s { font-size: 12px; color: #5F7A6C; line-height: 1.4; margin-top: 1px; }

/* accordion (details + faq) */
.bp-acc, .bp-faq__list { display: flex; flex-direction: column; gap: 10px; }
.bp-faq__list { gap: 8px; }
.bp-acc__i { border-radius: 18px; background: #fff; border: 1px solid rgba(56,65,95,.09); box-shadow: 0 1px 0 rgba(255,255,255,.9) inset, 0 10px 26px -22px rgba(56,65,95,.4); overflow: hidden; }
.bp-acc__b { width: 100%; display: flex; align-items: center; gap: 12px; padding: 15px 16px; background: transparent; border: none; cursor: pointer; text-align: left; }
.bp-acc__b > div { flex: 1; min-width: 0; }
.bp-acc__t { font-family: var(--disp); font-weight: 700; font-size: 14px; color: var(--ink2); }
.bp-acc__s { font-size: 11px; color: var(--faint); margin-top: 1px; }
.bp-acc__x { flex: 0 0 auto; width: 26px; height: 26px; border-radius: 50%; background: #F4F2ED; color: var(--violet); display: flex; align-items: center; justify-content: center; font-size: 10px; }
.bp-acc__p { padding: 0 16px 16px; }
.bp-acc__txt { font-size: 13px; line-height: 1.6; color: #4A453D; }
.bp-spec { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.bp-spec__c { padding: 10px 12px; border-radius: 12px; background: var(--card); border: 1px solid rgba(56,65,95,.06); }
.bp-spec__k { font-size: 10px; color: var(--faint); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
.bp-spec__v { font-family: var(--disp); font-weight: 600; font-size: 13px; color: var(--ink2); margin-top: 2px; }

/* reviews */
.bp-rev__head { display: flex; align-items: center; justify-content: space-between; margin: 0 3px 11px; }
.bp-rev__count { font-size: 12px; color: var(--muted); }
.bp-rev .bp-tabs { background: var(--card); }
.bp-revpane { padding: 14px; }
.bp-rsum { display: flex; gap: 14px; margin-bottom: 13px; }
.bp-rsum__big { text-align: center; flex: 0 0 auto; } .bp-rsum__big b { font-family: var(--disp); font-weight: 700; font-size: 30px; line-height: 1; display: block; }
.bp-rsum__big .bp-stars { font-size: 11px; } .bp-rsum__big em { font-size: 9px; color: var(--faint); font-style: normal; display: block; margin-top: 2px; }
.bp-rsum__bars { flex: 1; }
.bp-rbar { display: flex; align-items: center; gap: 7px; margin-bottom: 5px; }
.bp-rbar span { font-size: 10px; font-weight: 700; width: 48px; flex: 0 0 auto; }
.bp-rbar__t { flex: 1; height: 5px; border-radius: 999px; background: #ECE6DA; overflow: hidden; } .bp-rbar__t i { display: block; height: 100%; border-radius: 999px; }
.bp-rbar em { font-size: 10px; color: var(--muted); width: 56px; text-align: right; flex: 0 0 auto; font-style: normal; }
.bp-aisum { border-radius: 13px; padding: 11px 12px; background: rgba(56,65,95,.05); margin-bottom: 12px; }
.bp-aisum__h { display: flex; align-items: center; gap: 6px; margin-bottom: 7px; font-weight: 700; font-size: 11px; }
.bp-ai--sm { width: 18px; height: 18px; border-radius: 5px; background: var(--nav); color: #F6F2EB; font-size: 9px; border-radius: 5px; }
.bp-aisum p { font-size: 12px; line-height: 1.5; color: #3A352E; }
.bp-kw { display: flex; gap: 5px; flex-wrap: wrap; }
.bp-kw span { padding: 4px 9px; border-radius: 999px; background: rgba(56,65,95,.06); font-size: 10px; font-weight: 600; color: #3A4654; } .bp-kw em { color: var(--faint); font-style: normal; }
.bp-revfilters { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; margin-bottom: 11px; }
.bp-revfilters button { flex: 0 0 auto; padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(56,65,95,.14); background: #fff; color: var(--ink); font-size: 11px; font-weight: 600; cursor: pointer; white-space: nowrap; transition: all .2s; }
.bp-revfilters button.is-on { background: var(--nav); color: #F6F2EB; border-color: var(--nav); } .bp-revfilters em { font-style: normal; }
.bp-rcards { display: flex; flex-direction: column; gap: 9px; }
.bp-rcard { border-radius: 16px; padding: 14px; background: #fff; border: 1px solid rgba(56,65,95,.08); box-shadow: 0 1px 0 rgba(255,255,255,.9) inset, 0 6px 16px -12px rgba(56,65,95,.28); animation: bp-rise .3s ease both; }
