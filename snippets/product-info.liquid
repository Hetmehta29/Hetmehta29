var dots=Array.prototype.slice.call(wrap.querySelectorAll('[data-bp-dots] .bp-hdot'));var thumbs=Array.prototype.slice.call(wrap.querySelectorAll('[data-bp-thumbs] .bp-thumb'));
function setActive(i){dots.forEach(function(d){d.classList.toggle('is-on',+d.dataset.i===i);});thumbs.forEach(function(t){t.classList.toggle('is-on',+t.dataset.i===i);});}
function slideTo(i){track.scrollTo({left:i*track.clientWidth,behavior:'smooth'});setActive(i);}
dots.concat(thumbs).forEach(function(el){el.addEventListener('click',function(){slideTo(+el.dataset.i);});});
var raf;track.addEventListener('scroll',function(){if(raf)cancelAnimationFrame(raf);raf=requestAnimationFrame(function(){setActive(Math.round(track.scrollLeft/Math.max(1,track.clientWidth)));});},{passive:true});
