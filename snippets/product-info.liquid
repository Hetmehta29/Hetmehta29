                    <div class="bp-inv__t"><i style="width:{{ _pctleft }}%"></i></div>
                  </div>
                {%- endif -%}
                {%- if block.settings.pickup_title != blank -%}
                  <div class="bp-pickup">
                    <span></span>
                    <div>
                      <div class="bp-pickup__t">{{ block.settings.pickup_title }}</div>
                      {%- if block.settings.pickup_note != blank -%}<div class="bp-pickup__s">{{ block.settings.pickup_note }}</div>{%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>

          {%- when 'bp-qty' -%}
            <div id="bp-{{ block.id }}" class="bp-blk bp-blk--bp-qty" style="max-width:100%;overflow-x:clip;{% if block.settings.pad > 0 %}padding-block:{{ block.settings.pad }}px;{% endif %}">
              <div class="bp-qty" data-bp-qty>
                {%- if block.settings.show_qty -%}
                  <div class="bp-qty__row">
                    <span class="bp-qty__lbl">{{ block.settings.qty_label | default: 'Quantity' }}</span>
                    <div class="bp-qty__step">
                      <button type="button" data-bp-qty-minus aria-label="Decrease quantity">&minus;</button>
                      <input type="number" min="1" value="1" data-bp-qty-input aria-label="Quantity">
                      <button type="button" data-bp-qty-plus aria-label="Increase quantity">+</button>
                    </div>
                  </div>
                {%- endif -%}
                {%- comment -%}
                  Line item properties. The name attribute is what Shopify records against
                  the cart line, so these carry through to the order.
                {%- endcomment -%}
                {%- if block.settings.initials_label != blank -%}
                  <div class="bp-qty__grp">
                    <span class="bp-qty__lbl">{{ block.settings.initials_label }}{%- if block.settings.initials_note != blank -%} <em>({{ block.settings.initials_note }})</em>{%- endif -%}</span>
                    <input class="bp-qty__in" type="text" maxlength="{{ block.settings.initials_max | default: 4 }}"
                      name="properties[{{ block.settings.initials_label | escape }}]"
                      form="{{ product_form_id }}"
                      placeholder="{{ block.settings.initials_hint | escape }}">
                  </div>
                {%- endif -%}
                {%- if block.settings.gift_label != blank -%}
                  <label class="bp-qty__check">
                    <input type="checkbox" name="properties[{{ block.settings.gift_label | escape }}]" value="Yes" form="{{ product_form_id }}">
                    <span class="bp-qty__box">✓</span>
                    <span>{{ block.settings.gift_label }}</span>
                  </label>
                {%- endif -%}
              </div>
            </div>
            <script>
            (function(){var r=document.getElementById('bp-{{ block.id }}');if(!r||r.dataset.bpBound)return;r.dataset.bpBound='1';
            var inp=r.querySelector('[data-bp-qty-input]');if(!inp)return;
            function mirror(){var q=document.querySelector('form[action*="/cart/add"] input[name="quantity"], quantity-selector input[name="quantity"]');
              if(q){q.value=inp.value;q.dispatchEvent(new Event('change',{bubbles:true}));}}
            r.querySelector('[data-bp-qty-minus]').addEventListener('click',function(){inp.value=Math.max(1,(+inp.value||1)-1);mirror();});
            r.querySelector('[data-bp-qty-plus]').addEventListener('click',function(){inp.value=(+inp.value||1)+1;mirror();});
            inp.addEventListener('change',mirror);})();
            </script>

          {%- when 'bp-policies' -%}
            {%- assign _pol = block.settings.policy_items | newline_to_br | split: '<br />' -%}
            {%- if block.settings.policy_items != blank -%}
            <div id="bp-{{ block.id }}" class="bp-blk bp-blk--bp-policies" style="max-width:100%;overflow-x:clip;{% if block.settings.pad > 0 %}padding-block:{{ block.settings.pad }}px;{% endif %}">
              <div class="bp-mod bp-faq" data-bp-acc style="margin-top:22px">
                {%- if block.settings.heading != blank -%}<h2 class="bp-h2 bp-h2--tight">{{ block.settings.heading }}</h2>{%- endif -%}
                <div class="bp-faq__list">
                  {%- comment -%} "Question|Answer" per line; the first is open. {%- endcomment -%}
                  {%- for row in _pol -%}
                    {%- assign q = row | strip | split: '|' -%}
                    {%- if q.size >= 2 -%}
                      <div class="bp-faq__i{% if forloop.first and block.settings.open_first %} is-open{% endif %}">
                        <button type="button" class="bp-faq__b"><span>{{ q[0] | strip }}</span><em>{% if forloop.first and block.settings.open_first %}&minus;{% else %}+{% endif %}</em></button>
                        <div class="bp-faq__p"{% unless forloop.first and block.settings.open_first %} hidden{% endunless %}>{{ q[1] | strip }}</div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
            {%- endif -%}

          {%- when 'bp-pairs' -%}
            {%- assign _hasPairs = false -%}
            {%- for i in (1..4) -%}{%- assign _pk = 'pair_product_' | append: i -%}{%- if block.settings[_pk] != blank -%}{%- assign _hasPairs = true -%}{%- endif -%}{%- endfor -%}
            {%- if _hasPairs -%}
            <div id="bp-{{ block.id }}" class="bp-blk bp-blk--bp-pairs" style="max-width:100%;overflow-x:clip;{% if block.settings.pad > 0 %}padding-block:{{ block.settings.pad }}px;{% endif %}">
              <div class="bp-pairs">
                {%- if block.settings.heading != blank -%}<h2 class="bp-h2 bp-h2--tight">{{ block.settings.heading }}</h2>{%- endif -%}
                <div class="bp-pairs__rail bp-scroll">
                  {%- for i in (1..4) -%}
                    {%- assign _pk = 'pair_product_' | append: i -%}
                    {%- assign prod = block.settings[_pk] -%}
                    {%- if prod != blank -%}
                      <a class="bp-pairs__i" href="{{ prod.url }}">
                        <div class="bp-pairs__img">{%- if prod.featured_image -%}<img src="{{ prod.featured_image | image_url: width: 400 }}" alt="{{ prod.title | escape }}" loading="lazy">{%- endif -%}</div>
                        <span class="bp-pairs__n">{{ prod.title }}</span>
                        <span class="bp-pairs__p">{{ prod.price | money }}</span>
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                {%- if block.settings.foot_link != blank and block.settings.foot_label != blank -%}
                  <div class="bp-pairs__foot">
                    <em>{{ block.settings.foot_eyebrow }}</em>
                    <a href="{{ block.settings.foot_link }}">{{ block.settings.foot_label }}</a>
                  </div>
                {%- endif -%}
              </div>
            </div>
            {%- endif -%}

          {%- when 'bp-share' -%}
            {%- assign _url = shop.url | append: product.url -%}
            {%- assign _msg = product.title | append: ' — ' | append: _url | url_encode -%}
            <div id="bp-{{ block.id }}" class="bp-blk bp-blk--bp-share" style="max-width:100%;overflow-x:clip;{% if block.settings.pad > 0 %}padding-block:{{ block.settings.pad }}px;{% endif %}">
              <div class="bp-share">
                <span class="bp-share__l">{{ block.settings.label | default: 'Share' }}</span>
                <a href="https://wa.me/?text={{ _msg }}" target="_blank" rel="noopener">WhatsApp</a>
                <a href="https://www.facebook.com/sharer/sharer.php?u={{ _url | url_encode }}" target="_blank" rel="noopener">Facebook</a>
                <button type="button" data-bp-copy="{{ _url }}">Copy link</button>
              </div>
            </div>
            <script>
            (function(){var r=document.getElementById('bp-{{ block.id }}');if(!r||r.dataset.bpBound)return;r.dataset.bpBound='1';
            var b=r.querySelector('[data-bp-copy]');if(!b)return;
            b.addEventListener('click',function(){var u=b.getAttribute('data-bp-copy');
              function done(){var o=b.textContent;b.textContent='Copied';setTimeout(function(){b.textContent=o;},1600);}
              if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(u).then(done);}
              else{var i=document.createElement('input');i.value=u;document.body.appendChild(i);i.select();document.execCommand('copy');i.remove();done();}});})();
            </script>

          {%- when 'bp-seal' -%}
            <div id="bp-{{ block.id }}" class="bp-blk bp-blk--bp-seal" style="max-width:100%;overflow-x:clip">
              <div class="bp-seal">
                {%- if block.settings.year != blank -%}
                  <div class="bp-seal__mark">
                    <span class="bp-seal__k">{{ block.settings.year_label | default: 'SINCE' }}</span>
                    <span class="bp-seal__y">{{ block.settings.year }}</span>
                  </div>
                {%- endif -%}
                {%- if block.settings.tagline != blank -%}<span class="bp-seal__t">{{ block.settings.tagline }}</span>{%- endif -%}
              </div>
            </div>

        {%- endcase -%}
      {%- endcapture -%}

      {%- if allow_block_group and inside_block_group_context == false -%}
        {%- assign inside_block_group_context = true -%}
        <div class="product-info__block-group {{ block_group_class }}" data-group-type="{{ block_group_name }}">
      {%- endif -%}

      {%- liquid
        assign block_types_allowing_partial_rerender = 'sku,badges,price,payment_terms,volume_pricing,variant_picker,inventory,buy_buttons,pickup_availability,liquid' | split: ','
        assign allow_partial_rerender = false

        if block_types_allowing_partial_rerender contains block.type
          assign allow_partial_rerender = true
        endif
      -%}

      <div class="product-info__block-item" data-block-id="{{ block.id }}" data-block-type="{{ block.type | replace: '_', '-' }}" {% if allow_partial_rerender %}data-block-allow-rerender{% endif %} {% unless block.type == '@app' or block.type == 'accordion' %}{{ block.shopify_attributes }}{% endunless %}>
        {{- block_content -}}
      </div>

      {%- if inside_block_group_context and allow_block_group == false -%}
        {%- assign inside_block_group_context = false -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if context == 'quick_buy' -%}
      <a href="{{ product.url }}" class="link sm-max:hidden">{{ 'product.general.view_details' | t }}</a>
    {%- endif -%}
  </div>

  {%- comment -%}
    IMPLEMENTATION NOTE: under rare circumstances, merchant may want to show selectors to allow variant selection, but hide
    the add to cart button. This is however problematic as product info is changed based on the form, so we create a default
    one if no buy buttons exists
  {%- endcomment -%}

  {%- assign buy_buttons_block = section.blocks | where: 'type', 'buy_buttons' | first -%}

  {%- unless buy_buttons_block != blank or product == blank -%}
    {%- form 'product', product, id: product_form_id, hidden: true -%}
      <input type="hidden" disabled name="id" value="{{ product.selected_or_first_available_variant.id }}">
    {%- endform -%}
  {%- endunless -%}
</safe-sticky>
