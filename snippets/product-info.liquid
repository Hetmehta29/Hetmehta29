<script>
(function(){
  var root = document.getElementById('bp-{{ block.id }}');
  if(!root) return;
  var box = root.querySelector('[data-bp-preorder]');
  if(!box) return;
  var raw = (box.getAttribute('data-sizes')||'').toUpperCase();
  var all = raw.indexOf('*') > -1;
  var list = raw.split(',').map(function(s){return s.trim();}).filter(function(s){return s && s !== '*';});
  function apply(sz){
    var hit = all || (!!sz && list.indexOf(String(sz).trim().toUpperCase()) > -1);
    box.classList.toggle('is-on', hit);
  }
  function current(){
    var on = document.querySelector('[data-bp-sizes] .bp-sz.is-on');
    return on ? on.getAttribute('data-size') : '';
  }
  document.addEventListener('bp:size', function(e){ apply(e.detail && e.detail.size); });
  apply(current());
  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', function(){ apply(current()); });
  }
})();
</script>
