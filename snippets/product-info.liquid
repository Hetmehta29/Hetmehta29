 block.settings.head_size }}px !important;}{% endif %}{% if block.settings.price_size > 0 %}#bp-{{ block.id }} .bp-price{font-size:{{ block.settings.price_size }}px !important;}{% endif %}{% if block.settings.c_dark != blank %}#bp-{{ block.id }} .bp-head__title{color:{{ block.settings.c_dark }} !important;}{% endif %}{% if block.settings.c_price != blank %}#bp-{{ block.id }} .bp-price{color:{{ block.settings.c_price }} !important;}{% endif %}{% if block.settings.custom_css != blank %}{{ block.settings.custom_css | replace: "&", bpscope }}{% endif %}</style>
