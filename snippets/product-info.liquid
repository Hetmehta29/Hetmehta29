      {%- assign s_desc    = block.settings.spec_desc    | default: product.description -%}
    {%- else -%}
      {%- assign s_fabric  = bp_fabric -%}
      {%- assign s_pattern = bp_pattern -%}
      {%- assign s_fit     = bp_fit -%}
      {%- assign s_weave   = bp_weave -%}
      {%- assign s_wash    = 'Pre-shrunk & colourfixed' -%}
      {%- assign s_collar  = 'Spread collar' -%}
      {%- assign s_desc    = product.description -%}
