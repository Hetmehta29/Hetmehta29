              {%- endif -%}
            {%- endfor -%}
            {%- assign _pre = _pre | upcase | replace: ' ', '' | remove_first: ',' -%}
            {%- assign _predays = block.settings.pre_days | default: 10 -%}
            {%- comment -%} Token swap must happen in assign tags: a literal } inside {{ }} ends the tag early in Shopify Liquid. {%- endcomment -%}
            {%- assign _pmsg = block.settings.pre_text | default: 'This size ships in {days} days' -%}
            {%- assign _pmsg = _pmsg | replace: '{days}', _predays | replace: '[days]', _predays -%}
            {%- if _pre != blank -%}<div id="bp-{{ block.id }}" class="bp-blk bp-blk--bp-preorder" style="max-width:100%;overflow-x:clip;{% if block.settings.pad > 0 %}padding-block:{{ block.settings.pad }}px;{% endif %}{% if block.settings.blk_scale and block.settings.blk_scale != 100 %}zoom:{{ block.settings.blk_scale | divided_by: 100.0 }};{% if block.settings.blk_scale > 100 %}width:calc(100% / {{ block.settings.blk_scale | divided_by: 100.0 }});{% endif %}{% endif %}"><style>#bp-{{ block.id }} .bp-preo{ display:none; align-items:center; gap:9px; margin-top:8px; padding:{% if block.settings.cpad > 0 %}{{ block.settings.cpad }}px{% else %}9px 11px{% endif %}; border-radius:10px; background:{{ block.settings.c_bg | default: '#FFF7E8' }}; border:1px solid {{ block.settings.c_border | default: 'rgba(190,135,25,.26)' }}; }#bp-{{ block.id }} .bp-preo.is-on{ display:flex; }#bp-{{ block.id }} .bp-preo__i{ flex:0 0 auto; font-size:15px; line-height:1; }#bp-{{ block.id }} .bp-preo__t{ font-family:var(--disp); font-weight:700; font-size:{% if block.settings.head_size > 0 %}{{ block.settings.head_size }}px{% else %}10.5px{% endif %}; letter-spacing:.06em; text-transform:uppercase; color:{{ block.settings.c_accent | default: '#8A6100' }}; }#bp-{{ block.id }} .bp-preo__s{ font-size:{% if block.settings.body_size > 0 %}{{ block.settings.body_size }}px{% else %}11.5px{% endif %}; color:{{ block.settings.c_text | default: '#6B6459' }}; margin-top:1px; line-height:1.35; }{% if block.settings.custom_css != blank %}{{ block.settings.custom_css | replace: "&", bpscope }}{% endif %}</style>
<div class="bp-preo" data-bp-preorder data-sizes="{{ _pre | escape }}">
